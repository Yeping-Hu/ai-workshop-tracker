# Cloudflare Pages cache rules.
#
# Default everything to "revalidate every time". This covers the HTML pages
# (the homepage inlines the search script via is:inline, so stale HTML means
# stale search code) and /version.json (the build-id the bfcache stale-page
# check reads). The previous Pages default — max-age=600 on *everything* — left
# old HTML, old inline JS, and a stale build-id served for up to 10 minutes
# after a deploy, so a shipped fix appeared to "come back" intermittently until
# caches expired. max-age=0 + must-revalidate makes a new deploy take effect on
# the very next request (the server answers 304 when nothing changed, so this is
# cheap), and lets the build-id check reload any stale back/forward-cached tab.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Astro fingerprints these bundles — the filename changes whenever the bytes do
# — so a given URL is immutable and can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind's per-page fragment and index shards also have content-hashed names,
# so they're immutable too. (pagefind.js, pagefind-entry.json and the small
# *.pf_meta/*.pf_filter manifests at the pagefind root are intentionally left on
# the revalidating default above, since those change on every build.)
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind-papers/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind-papers/index/*
  Cache-Control: public, max-age=31536000, immutable
