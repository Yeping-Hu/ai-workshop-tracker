{
  "name": "ai-workshop-tracker-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node vendor.mjs",
    "dev": "astro dev",
    "prebuild": "node vendor.mjs",
