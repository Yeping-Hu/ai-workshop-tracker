    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "mathjax": "^4.1.3",
    "pagefind": "^1.3.0"
  }
}
