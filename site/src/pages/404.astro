---
import Base from '../components/Base.astro';
import { href } from '../lib/site';
---

<Base title="Not found">
  <section class="masthead">
    <p class="eyebrow">404</p>
    <h1>This page missed the deadline.</h1>
    <p class="lede">
      It may have moved — try the <a href={href('/')}>deadline board</a> (search
      covers every edition and paper), or your <a href={href('/saved/')}>saved list</a>.
      Every conference is linked in the footer below.
    </p>
  </section>
</Base>
