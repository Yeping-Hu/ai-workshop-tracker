---
import Base from '../components/Base.astro';
import WorkshopRow from '../components/WorkshopRow.astro';
import AlertsSignup from '../components/AlertsSignup.astro';
import {
  topics,
  workshops,
  upcomingWithDeadline,
  upcomingTba,
  conferences,
  paperCount,
  proposalCalls,
  conferenceById,
  loadPaperCache,
} from '../lib/data';
import { href, REPO_URL } from '../lib/site';

const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
// conference display-name -> color, for badges on search results
const confColors = Object.fromEntries(conferences.map((c) => [c.name, c.color]));
// Facet options + counts computed from the data at build time: exact,
// workshop-only, and rendered instantly without waiting for the search index.
const topicLabel = new Map(topics.map((t: any) => [t.id, t.label]));
// Topic id -> label for the client, so a result row shows the same chips the
// board does (the document's metadata carries ids).
const TOPIC = Object.fromEntries(topicLabel);
const facetCounts: Record<string, Record<string, number>> = { conference: {}, status: {}, year: {}, topic: {} };
const bump = (f: string, v: string) => { facetCounts[f][v] = (facetCounts[f][v] ?? 0) + 1; };
for (const w of workshops) {
  bump('conference', conferenceById.get(w.conference)?.name ?? w.conference);
  bump('status', w.statusLabel);
  bump('year', String(w.year));
  for (const t of w.topics ?? []) bump('topic', topicLabel.get(t) ?? t);
}
// Compact per-workshop facet tuples (~20 KB) so the dropdowns can compute
// exact, mutually consistent counts under any selection, instantly.
const FW = workshops.map((w) => ({
  conference: conferenceById.get(w.conference)?.name ?? w.conference,
  status: w.statusLabel,
  year: String(w.year),
  topic: (w.topics ?? []).map((t: string) => topicLabel.get(t) ?? t),
}));
// Build-time index sizes, handed to the client to sanity-check the search
// engine after it loads. The two Pagefind indexes are merged in the browser,
// and that merge can occasionally stack the papers index twice — the cause of
// the inflated "llm 516 / 14144 papers" counts. filters().type.Papers is an
// exact tell: one clean merge reports this many papers pages, a double reports
// twice as many. ws = every workshop page (data-pf-ws); papers = pages with a
// data-pf-papers section, which is rendered only when the workshop has cached
// papers — the same condition [slug].astro uses, so the numbers track the data
// across the daily rebuilds.
const pfExpect = {
  ws: workshops.length,
  papers: workshops.filter((w) => {
    const c = loadPaperCache(w.slug);
    return c && Array.isArray(c.papers) && c.papers.length > 0;
  }).length,
};

// Dataset (JSON-LD): the tracker's corpus is a genuine, unique, machine-readable
// dataset — exposing it as schema.org/Dataset makes it eligible for Google
// Dataset Search and gives AI engines a citable, structured source. Points at
// the static JSON API the site already emits.
const SITE = Astro.site;
const datasetUrl = SITE ? new URL(href('/api/workshops.json'), SITE).href : href('/api/workshops.json');
const _years = workshops.map((w) => w.year).filter((y) => typeof y === 'number');
const yearMin = _years.length ? Math.min(..._years) : null;
const yearMax = _years.length ? Math.max(..._years) : null;
const _confNames = [...conferences].map((c) => c.name).sort((a, b) => a.localeCompare(b));
// The meta description names every conference, from the data rather than a
// hand-typed list, so a tenth conference appears on its own. Naming them is
// deliberate: "neurips workshop deadline" and "corl workshops" are the queries
// this page is shown for, and a description that only said "major AI/ML
// conferences" matched none of them — 20k impressions at 0.2% CTR.
const confListText = _confNames.length > 1
  ? `${_confNames.slice(0, -1).join(', ')}, and ${_confNames[_confNames.length - 1]}`
  : _confNames.join('');
// The conferences with an open call right now, in the eyebrow's order, for the
// one-line summary under the counts. Same definition of "open" as the statline
// (upcomingWithDeadline), so the two never disagree; conferences with nothing
// open are left out so the line stays one line.
const openByConf = new Map<string, number>();
for (const w of upcomingWithDeadline) openByConf.set(w.conference, (openByConf.get(w.conference) ?? 0) + 1);
const openConfs = [...conferences]
  .sort((a, b) => a.name.localeCompare(b.name))
  .filter((c) => openByConf.has(c.id))
  .map((c) => ({ id: c.id, name: c.name, full: c.full_name ?? c.name, color: c.color, open: openByConf.get(c.id)! }));

const datasetLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'AI Workshop Tracker — workshop deadlines & accepted papers',
  description: `Submission deadlines, dates, and accepted-paper lists for ${workshops.length} workshop editions across major AI/ML/Robotics conferences (${_confNames.join(', ')}), including ${paperCount.toLocaleString('en-US')} accepted papers. Community-maintained and rebuilt daily.`,
  url: SITE ? SITE.href : 'https://aiworkshoptracker.com/',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  creator: { '@type': 'Person', name: 'Yeping Hu', url: 'https://yeping-hu.github.io/' },
  keywords: ['machine learning workshops', 'AI conference deadlines', 'call for papers', 'accepted papers', ..._confNames],
  ...(yearMin && yearMax ? { temporalCoverage: `${yearMin}/${yearMax}` } : {}),
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: datasetUrl,
  },
};
---

<Base
  title="AI Workshop Deadlines & Accepted Papers"
  description={`Track AI/ML workshop submission deadlines, extensions, and accepted papers across ${confListText}. Updated daily.`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datasetLd)} />
  </Fragment>
  <section class="hero">
    <nav class="eyebrow conf-nav" aria-label="Browse workshops by conference">
      {[...conferences]
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((c, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
            <a href={href(`/conference/${c.id}/`)} title={`${c.full_name} workshops`}>{c.name}</a>
          </>
        ))}
    </nav>
    <h1>Every workshop. Every paper. One search.</h1>
    <p class="lede">
      Deadlines, past editions, and accepted papers for AI/ML/Robotics conference
      workshops.
    </p>
    <div class="kw-box hero-box" onclick="document.getElementById('q')?.focus()">
      <span id="kwChips"></span>
      <input id="q" type="search" placeholder="Search workshops & papers… (Enter adds a keyword)" aria-label="Search workshops and papers" />
    </div>
    <div class="filterbar facetbar">
      <details class="dd"><summary data-facet-summary="conference">Conference</summary><div class="dd-panel" data-facet="conference"></div></details>
      <details class="dd"><summary data-facet-summary="status">Status</summary><div class="dd-panel" data-facet="status"></div></details>
      <details class="dd"><summary data-facet-summary="year">Year</summary><div class="dd-panel" data-facet="year"></div></details>
      <details class="dd"><summary data-facet-summary="topic">Topic</summary><div class="dd-panel" data-facet="topic"></div></details>
      <button class="btn-quiet" id="clearSearch" type="button">Clear all</button>
      <span class="resultcount" id="searchCount"></span>
    </div>
    <div class="statline">
      <span><strong>{workshops.length}</strong> workshop editions</span>
      <span><strong>{paperCount.toLocaleString('en-US')}</strong> papers</span>
      <span><strong>{upcomingWithDeadline.length}</strong> open calls</span>
    </div>
    {/* Which conferences have an open call, as the last line of the hero —
        after the counts, before the alerts line — so the
        ambient status sits together and the alerts bar stays next to the board
        it serves. Static and one line: a scrolling ticker was distracting, and
        before it a grid of cards stood 395px tall and pushed the first deadline
        row below the fold. Conferences with nothing open are omitted rather
        than listed as "no open calls"; the eyebrow above already names every
        conference. Like the eyebrow, it is navigation and stays put while
        searching. Not a heading: the first <h2> stays "Upcoming deadlines". */}
    {openConfs.length > 0 && (
      <nav class="conf-line" aria-label="Conferences with open calls">
        {openConfs.map((c) => (
          <a class="conf-tick" href={href(`/conference/${c.id}/`)} title={`${c.full} workshops`}>
            <i class="conf-tick-dot" style={`background:${c.color}`} aria-hidden="true"></i>
            <span class="conf-tick-name">{c.name}</span>
            <span class="conf-tick-open">{c.open} open call{c.open === 1 ? '' : 's'}</span>
          </a>
        ))}
      </nav>
    )}
  </section>

  {/* Renders nothing unless PUBLIC_ALERTS_API is set at build time. Collapsed,
      so it costs one line above the board rather than a screenful — and it sits
      above the board because at the foot of the page nobody found it. */}
  <AlertsSignup collapsed tight />

  <!-- search mode -->
  <section id="searchPanel" hidden>
    <ol class="pf-results" id="results"></ol>
    <p class="muted" id="searchStatus" hidden></p>
  </section>

  <!-- default mode -->
  <div id="homeDefault">
    <h2>Upcoming deadlines</h2>
    {upcomingWithDeadline.length > 0 ? (
      <section class="board" aria-label="Workshop deadlines">
        {upcomingWithDeadline.map((w) => <WorkshopRow w={w} />)}
      </section>
    ) : (
      <p class="muted" style="margin-top: 1rem;">
        No open calls right now — new conference cycles are imported automatically as soon as
        they're announced. Meanwhile, every past workshop and paper is searchable above.
      </p>
    )}
    {upcomingTba.length > 0 && (
      <p class="muted small" style="margin-top: 0.9rem;">
        {upcomingTba.length} more announced workshops haven't published a deadline yet — find
        them with the search box above, and help <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>add what's missing</a>.
      </p>
    )}

      {/* Proposal deadlines, back below the board where they were before the
          conference strip absorbed them. The strip still carries a per-conference
          summary, and the daily OpenReview sync that keeps these dates current is
          untouched — this only restores where the detail is shown: one row per
          call, with a live countdown while it is open and a Closed pill after. */}
      {proposalCalls.length > 0 && (
        <section>
          <h2>Organizing a workshop? Proposal deadlines</h2>
          {/* A table rather than a stack of cards: six saturated badges in a
              column competed with each other, and the one call a reader can act
              on was lost among five that closed months ago. Colour survives as a
              9px dot — enough to identify the conference, not enough to shout —
              and the open row is tinted instead. Notes keep their own spanning
              row so nothing is dropped; they are what made the cards tall. */}
          <table class="proposal-table">
            <caption class="visually-hidden">Calls for workshop proposals, newest first</caption>
            <tbody>
              {proposalCalls.map((c) => {
                const conf = conferenceById.get(c.conference);
                return (
                  <>
                    <tr class={c.open ? 'is-open' : 'is-past'}>
                      <td class="pt-conf">
                        <i class="pt-dot" style={`background:${conf?.color ?? '#888'}`} aria-hidden="true"></i>
                        <b>{conf?.name}</b> {c.year}
                      </td>
                      <td class="pt-when mono">{c.deadlineWallClock}</td>
                      <td class="pt-state">
                        {c.open ? (
                          <span class="countdown" data-deadline-ms={c.deadlineUtcMs}>—</span>
                        ) : (
                          <span class="pill deadline_passed">Closed</span>
                        )}
                      </td>
                      <td class="pt-link"><a href={c.url} rel="noopener">Call for proposals ↗</a></td>
                    </tr>
                    {c.notes && (
                      <tr class={`pt-noterow${c.open ? ' is-open' : ' is-past'}`}>
                        <td colspan="4"><span class="muted small">{c.notes}</span></td>
                      </tr>
                    )}
                  </>
                );
              })}
            </tbody>
          </table>
        </section>
      )}


  </div>

  <script src="../scripts/board.js"></script>
  <script>
    // The sticky filter bar's bottom rule separates it from content scrolling
    // under it. At rest, directly under the search box, it read as a stray
    // line across the page — so it is drawn only while the bar is stuck. The
    // observer fires the moment the bar's top edge crosses 1px above the
    // viewport, which with `top: 0` is exactly when it starts sticking.
    const bar = document.querySelector('.filterbar');
    if (bar && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => bar.classList.toggle('is-stuck', e.intersectionRatio < 1), {
        threshold: [1],
        rootMargin: '-1px 0px 0px 0px',
      }).observe(bar);
    }
  </script>
  {/* The results render the board's row through the shared client renderer.
      The search script below is inline (define:vars) and cannot import, so
      the renderer is bridged onto window — the pattern favorites.js uses for
      awtFavsHydrate. */}
  <script>
    import { wsRowHtml } from '../scripts/ws-row.js';
    (window as any).awtWsRowHtml = wsRowHtml;
  </script>

  <script is:inline define:vars={{ base, confColors, facetCounts, FW, pfExpect, TOPIC }}>
    // ---- Unified search over every workshop & paper (Pagefind, faceted) ----
    const $ = (s) => document.querySelector(s);
    const input = $('#q');
    const chipsBox = $('#kwChips');
    const FACETS = ['conference', 'status', 'year', 'topic'];
    const FACET_LABEL = { conference: 'Conference', status: 'Status', year: 'Year', topic: 'Topic' };
    let keywords = [];
    const sel = Object.fromEntries(FACETS.map((f) => [f, new Set()]));
    let pfReady = null, pagefind = null;
    let pfBust = 0; // appended to the engine URL when re-importing after a deploy
    let pfInited = null; // the engine module whose worker has already loaded both indexes
    let healAttempted = false;
    const initialCounts = facetCounts;
    let facetOptions = null;

    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    // A paper's excerpt starts with the paper's own title (the heading
    // anchors the sub-result region) — strip it so the line under each
    // title shows just the authors. Walks text nodes so <mark> highlights
    // in author names survive; returns the excerpt untouched if it doesn't
    // actually begin with the title. Stray ☆/★ (from indexes built before
    // star buttons were pagefind-ignored) are skipped like whitespace.
    function stripLeadingTitle(excerptHtml, title) {
      const want = String(title).replace(/[\s☆★]+/g, ' ').trim().toLowerCase();
      if (!want) return excerptHtml;
      const tpl = document.createElement('template');
      tpl.innerHTML = excerptHtml;
      const walker = document.createTreeWalker(tpl.content, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      let i = 0; // pointer into `want`
      for (const node of nodes) {
        const t = node.nodeValue;
        let j = 0;
        while (j < t.length && i < want.length) {
          const c = t[j];
          if (/[\s☆★]/.test(c)) {
            while (j < t.length && /[\s☆★]/.test(t[j])) j++;
            if (want[i] === ' ') i++;
            else if (i > 0) return excerptHtml; // gap where the title has none
            continue;
          }
          if (c.toLowerCase() !== want[i]) return excerptHtml; // not a title prefix
          i++; j++;
        }
        if (i >= want.length) {
          node.nodeValue = t.slice(j);
          break;
        }
        node.nodeValue = ''; // node fully consumed by the title
      }
      if (i < want.length) return excerptHtml; // excerpt shorter than the title

      // Whatever follows the title opens with the separator pagefind writes
      // between the heading block and the author line — a "." here, sometimes
      // a "·". It lands in the node the title ended in, or in the next one when
      // the title ended exactly on a node boundary (which is what a <mark> on
      // the title's last word does), so scan for the first surviving text
      // rather than assuming which node holds it.
      for (const node of nodes) {
        if (!node.nodeValue) continue;
        node.nodeValue = node.nodeValue.replace(/^[\s·.]+/, '');
        if (node.nodeValue) break;
      }

      // The region's trailing "· PDF" link text adds nothing here. Pagefind
      // closes the block with a "." too, so that has to come off first or the
      // end-anchored match never fires and "· PDF." is left on screen.
      for (let k = nodes.length - 1; k >= 0; k--) {
        if (!nodes[k].nodeValue.trim()) continue;
        nodes[k].nodeValue = nodes[k].nodeValue
          .replace(/\s*\.\s*$/, '')
          .replace(/\s*·?\s*PDF\s*$/, '');
        break;
      }

      // A <mark> whose whole text belonged to the title is now an empty
      // highlight, which paints as a bare swatch of background colour before
      // the authors. Nothing left to highlight, so drop the element.
      for (const m of tpl.content.querySelectorAll('mark')) {
        if (!m.textContent) m.remove();
      }
      return tpl.innerHTML;
    }

    function isSearching() {
      return keywords.length > 0 || input.value.trim() !== '' || FACETS.some((f) => sel[f].size);
    }
    function setMode(searching) {
      $('#homeDefault').hidden = searching;
      $('#searchPanel').hidden = !searching;
    }

    function renderChips() {
      chipsBox.innerHTML = keywords
        .map((k, i) => `<span class="kw-chip">${esc(k)}<button type="button" class="kw-x" data-i="${i}" aria-label="Remove keyword ${esc(k)}">×</button></span>`)
        .join('');
    }

    function syncUrl() {
      const p = new URLSearchParams();
      if (keywords.length) p.set('q', keywords.join(','));
      for (const f of FACETS) if (sel[f].size) p.set(f, [...sel[f]].join(','));
      if (isSearching() && rState.page > 1) p.set('page', String(rState.page));
      history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
    }

    const PF_MERGE_TRIES = 3; // re-imports allowed when a merge looks unclean

    // Does the just-merged engine look like ONE clean merge, or did the dual
    // index stack twice? filters().type is query-independent and exact: a single
    // clean merge reports the build-time page counts, a double reports ~2x (the
    // papers index is the one that stacks). Flag a gross deviation either way —
    // far too high means a stacked merge (the "llm 516/14144" inflation), far
    // too low means a wipeout or a partial filter load. Cheap: filters() pulls
    // only a few small chunks. (A subtle dropped *search* chunk that only dents
    // keyword matches isn't visible here; that rarer case is left to the
    // existing per-query heal rather than slowing every load down to probe it.)
    async function mergeLooksClean(pf) {
      try {
        const f = await pf.filters();
        const t = (f && f.type) || {};
        const ok = (got, want) => !want || (got >= Math.ceil(want * 0.5) && got <= Math.floor(want * 1.5));
        return ok(t.Workshops || 0, pfExpect.ws) && ok(t.Papers || 0, pfExpect.papers);
      } catch {
        return false; // couldn't even read filters → reload the engine fresh
      }
    }

    async function ensurePagefind() {
      // Single-flight: concurrent callers (idle prefetch, focus, first click)
      // share one initialization promise — double-init corrupted the facets.
      if (!pfReady) {
        pfReady = (async () => {
          for (let attempt = 1; ; attempt++) {
            const pf = await import(`${base}/pagefind/pagefind.js${pfBust ? `?v=${pfBust}` : ''}`);
            // Load each engine instance's index EXACTLY ONCE. A dynamic import of
            // the same URL returns the same cached module, backed by the same Web
            // Worker — and Pagefind's init()/mergeIndex() are NOT idempotent, they
            // APPEND. Running them again on an already-loaded worker merges the
            // papers index a second time, so every paper ends up indexed twice.
            // That doubles the worker's data and, once the two copies resolve to
            // even slightly different URLs (as happens across a deploy, or if the
            // merge baseUrl differs), it defeats the URL de-duplication below and
            // inflates the headline counts — the same "llm" query climbing from
            // 260 workshops / 2325 papers to 516 / 14144 over a warm, repeatedly
            // loaded or back/forward-restored session. Guarding on the module's
            // identity makes a reused module a no-op.
            if (pfInited !== pf) {
              await pf.options({ baseUrl: `${base}/` });
              await pf.init();
              await pf.mergeIndex(`${base}/pagefind-papers/`, { baseUrl: `${base}/` });
              // Confirm it merged cleanly BEFORE committing this worker. If the
              // merge stacked (or a chunk dropped), discard it and re-import under
              // a fresh URL — a clean module + worker, so the next merge is single
              // and clean. Bounded so a persistent problem can't loop; after the
              // last try we accept what loaded rather than leave search unusable.
              if (attempt < PF_MERGE_TRIES && !(await mergeLooksClean(pf))) {
                pfBust = Date.now(); // fresh URL → a clean worker on the retry;
                continue;            // pfInited stays unset so the retry re-inits
              }
              pfInited = pf;
            }
            pagefind = pf;
            return pf;
          }
        })().catch((err) => {
          pfReady = null;      // transient failure must not brick search until reload
          pagefind = null;     // engine no longer ready → a later search shows the skeleton, not a blank
          pfBust = Date.now(); // next import uses a fresh URL → a clean worker, never
                               // the half-initialized one this attempt just failed on
          const st = $('#searchStatus');
          st.hidden = false;
          st.textContent = "Search couldn't load: " + (err?.message || err) + ' (in local dev, run a full build first).';
          return null;
        });
      }
      return pfReady;
    }

    function facetSort(f, keys) {
      if (f === 'year') return keys.sort((a, b) => b.localeCompare(a));
      if (f === 'status') {
        const order = ['Open call', 'Deadline unknown', 'Past', 'Not running'];
        return keys.sort((a, b) => order.indexOf(a) - order.indexOf(b));
      }
      // localeCompare, matching the hero eyebrow and the footer's conference
      // list. A bare .sort() compares UTF-16 code units, which puts "CVPR"
      // before "CoRL" ("V" is 86, "o" is 111) while the other two read as a
      // dictionary would — the same nine names in two different orders.
      return keys.sort((a, b) => a.localeCompare(b));
    }

    // Counts for facet f reflect every OTHER facet's selection (standard
    // faceted-search semantics: "what would I get if I also picked this?").
    function liveCounts() {
      const out = Object.fromEntries(FACETS.map((f) => [f, {}]));
      for (const w of FW) {
        const match = Object.fromEntries(
          FACETS.map((f) => {
            const vals = Array.isArray(w[f]) ? w[f] : [w[f]];
            return [f, sel[f].size === 0 || vals.some((v) => sel[f].has(v))];
          }),
        );
        for (const f of FACETS) {
          if (FACETS.every((o) => o === f || match[o])) {
            for (const v of Array.isArray(w[f]) ? w[f] : [w[f]]) out[f][v] = (out[f][v] ?? 0) + 1;
          }
        }
      }
      return out;
    }

    function updateLiveCounts() {
      if (!facetOptions) return;
      const live = liveCounts();
      for (const f of FACETS) {
        for (const v of facetOptions[f]) {
          const el = document.querySelector(`[data-count="${f}:${CSS.escape(v)}"]`);
          if (el) el.textContent = `(${live[f][v] ?? 0})`;
        }
      }
    }

    function renderFacetPanels() {
      if (!facetOptions) return;
      const live = liveCounts();
      for (const f of FACETS) {
        const panel = document.querySelector(`[data-facet="${f}"]`);
        const counts = live[f] ?? {};
        panel.innerHTML = facetOptions[f]
          .map((v) => `<label class="check"><input type="checkbox" data-f="${f}" value="${esc(v)}" ${sel[f].has(v) ? 'checked' : ''}/> ${esc(v)} <span class="muted small" data-count="${f}:${esc(v)}">(${counts[v] ?? 0})</span></label>`)
          .join('');
      }
      updateFacetSummaries();
    }

    function updateFacetSummaries() {
      for (const f of FACETS) {
        const s = document.querySelector(`[data-facet-summary="${f}"]`);
        s.textContent = sel[f].size ? `${FACET_LABEL[f]} · ${sel[f].size}` : FACET_LABEL[f];
      }
    }

    // Per-query cache so page flips don't refetch fragments.
    let rState = { key: '', groups: [], page: 1, totalWs: 0, totalPaperPages: 0 };
    let pendingPage = 1; // from a deep link, consumed once
    const PAGE_SIZE = 50;

    // Bound the per-search fragment fetch so a request that never returns can't
    // hang the search forever. A real search can legitimately take well over ten
    // seconds (a large result set over a slow CDN), so this is set high — it's
    // pure insurance against a genuinely stuck request, never a trip-wire on a
    // slow-but-working search. On timeout it throws; the first-paint caller drops
    // into handleSearchFailure (fresh engine + one retry, then reload-the-page),
    // while the background completion pass below keeps whatever first page is
    // already shown. The timer is cleared the moment the fetch settles.
    const DATA_FETCH_TIMEOUT_MS = 45000;
    function fetchAllData(rows) {
      let timer;
      const guard = new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error('search data fetch timed out')), DATA_FETCH_TIMEOUT_MS);
      });
      const all = Promise.all(rows.map((r) => r.data())).finally(() => clearTimeout(timer));
      return Promise.race([all, guard]);
    }

    // Build rState (the model renderResultsPage draws) from a search result.
    // Pure compute, no DOM — called once per search, and repeatedly by the
    // settle gate while a freshly-merged index's count is still moving. Returns
    // the workshop count so the gate can tell when it has stopped changing.
    async function buildState(res, query, filters, terms, limit) {
      const key = JSON.stringify([query, filters]);
      // Pagefind returns results sorted by score, but ties (equal-score
      // matches, which are common) aren't ordered deterministically — and the
      // two indexes (workshops + papers) load in parallel, so tied items could
      // interleave differently run-to-run, making the SAME keyword search render
      // in a different order each time. Re-sort with an explicit, stable
      // tie-break: score first (preserving relevance / the browse sort), then
      // the result's fixed id, so identical searches always produce identical
      // order.
      const ordered = [...res.results].sort((a, b) => (b.score - a.score) || String(a.id).localeCompare(String(b.id)));
      // For a big result set the caller renders the first page from a capped
      // slice first (fast), then calls again with no limit to finalize the exact
      // counts — see runSearch. The grouping below is identical either way; a
      // slice just yields the top workshops (results are score-sorted, and each
      // workshop's matching papers travel in its own result) with a partial
      // count, flagged so the count line reads "counting…" until the full pass.
      const slice = (limit && limit < ordered.length) ? ordered.slice(0, limit) : ordered;
      const partial = slice.length < ordered.length;
      const data = await fetchAllData(slice);
      // Group by a STABLE workshop identity, not the raw result URL. Pagefind
      // can hand back the same workshop page under more than one URL — e.g.
      // when the papers index resolves its base differently from the workshops
      // index, or a merge runs twice — and keying on the URL then counts that
      // one workshop two or three times (the "516 workshops for llm" inflation,
      // which surfaced in some browsers but not others depending on load
      // timing). The slug in /workshop/<slug>/ is unique per workshop and
      // identical across any such duplicate, so it collapses them; matched
      // papers from the duplicate copies are merged here and de-duped by paper
      // id below. URLs that aren't workshop pages (none today) fall back to the
      // URL itself.
      const slugOf = (u) => (String(u).match(/\/workshop\/([^/?#]+)/) || [])[1] || null;
      const groups = new Map();
      let dropped = 0;
      for (const d of data) {
        const s = slugOf(d.url);
        // Every real result is a /workshop/<slug>/ page (workshop metadata or a
        // papers section). A result without that slug isn't a real hit — it's a
        // duplicate the dual-index merge produced under a URL that wouldn't
        // collapse, which is exactly what inflated the headline counts ("513 /
        // 757 workshops for llm"). Drop it rather than count it: the workshop
        // count then equals the distinct real workshops no matter how the merge
        // behaves, and duplicate papers still collapse by id within each group.
        if (!s) { dropped++; continue; }
        const gkey = `ws:${s}`;
        if (!groups.has(gkey)) groups.set(gkey, { ws: null, papers: null, slug: s, url: `${base}/workshop/${s}/` });
        const g = groups.get(gkey);
        if ((d.filters?.type ?? []).includes('Papers')) {
          if (!g.papers) g.papers = d;
          else g.papers = { ...g.papers, sub_results: [...(g.papers.sub_results || []), ...(d.sub_results || [])] };
        } else if (!g.ws) {
          g.ws = d;
        }
      }
      // Diagnostic breadcrumb: a non-zero `dropped` (or an unusually large
      // workshop count) means the merge produced duplicate/garbage results that
      // we just discarded. Surfaced on window + console so a malformed merge can
      // be confirmed from the field without it ever reaching the visible count.
      // Only on the full pass — a partial slice would report misleading totals.
      if (!partial) try {
        const diag = { query, rawResults: data.length, droppedNonWorkshop: dropped, distinctWorkshops: groups.size, ts: new Date().toISOString() };
        window.__aiwtSearchDiag = diag;
        if (dropped > 0 || groups.size > 400) console.warn('[aiwt-search] merge anomaly (artifacts dropped from the count):', diag);
      } catch {}
      // Headline counts describe exactly what's listed: distinct workshops, and
      // the individual papers matched inside them.
      const hasQuery = query !== null;
      // Keywords are AND for workshops (the page must contain all of them).
      // Enforce the same AND per individual paper: a paper counts only if its
      // own excerpt carries highlight marks for every keyword.
      const paperMatchesAll = (excerpt) => {
        if (terms.length < 2) return true;
        const marked = [...String(excerpt).matchAll(/<mark>([^<]*)<\/mark>/g)].map((m) => m[1].toLowerCase());
        return terms.every((t) =>
          t.toLowerCase().split(/\s+/).every((tok) => marked.some((w) => w.startsWith(tok) || tok.startsWith(w))),
        );
      };
      let nPapers = 0;
      const entries = [...groups.entries()].map(([gkey, g]) => {
        let subs = [];
        if (hasQuery && g.papers) {
          // De-dupe matched papers. A duplicated papers doc contributes the
          // same paper more than once; id-only de-duping misses it when the
          // duplicate copy arrives under a different anchor id (which inflated
          // the paper count). Key on id AND on the paper title — the title is
          // the stable identity across copies — so either form collapses.
          const seenId = new Set(), seenTitle = new Set();
          subs = (g.papers.sub_results || []).filter((sr) => {
            if (!sr.url.includes('#p-') || !paperMatchesAll(sr.excerpt)) return false;
            const id = (sr.url.match(/#p-([^#?]+)/) || [])[1];
            const title = String(sr.title || '').replace(/^[\s☆★]+/, '').trim().toLowerCase();
            if ((id && seenId.has(id)) || (title && seenTitle.has(title))) return false;
            if (id) seenId.add(id);
            if (title) seenTitle.add(title);
            return true;
          });
          nPapers += subs.length;
          if (subs.length === 0) {
            subs = [{
              title: terms.length > 1 ? 'Keywords matched across different papers →' : 'Matching papers →',
              url: `${g.url}#papers`,
              fall: true,
            }];
          }
        }
        return [gkey, { ...g, subs }];
      });
      rState = {
        key,
        groups: entries,
        page: Math.min(Math.max(1, pendingPage), Math.max(1, Math.ceil(entries.length / PAGE_SIZE))),
        nPapers,
        hasQuery,
        partial,
      };
      pendingPage = 1;
      return entries.length;
    }

    let searchGen = 0; // bumped per search; stale async work checks this and bails

    // A freshly-merged dual index can briefly report a moving count on a slow
    // network. After the immediate render, re-check the SAME query a couple of
    // times in the background and re-render only if the count actually changed —
    // and only while this is still the latest search (searchGen). No blocking
    // placeholder, no concurrent loops: nothing stale or racing ever paints.
    async function settleInBackground(gen, pf, query, opts, filters, terms, first) {
      let prev = first;
      for (const ms of [350, 800, 1600]) {
        await new Promise((r) => setTimeout(r, ms));
        if (gen !== searchGen) return; // a newer search took over
        let res;
        try { res = await pf.search(query, opts); } catch { return; }
        if (res === null || gen !== searchGen) return;
        let n;
        try { n = await buildState(res, query, filters, terms); } catch { return; } // a stalled fetch in this background re-check just ends it; the shown result stands
        if (gen !== searchGen) return;
        if (n !== prev) { renderResultsPage(); prev = n; }
        else break; // count held steady → done
      }
    }

    // Loading skeleton: shown while the Pagefind engine is still loading, so a
    // search that runs before it's ready — most visibly a full-reload back-
    // navigation, which otherwise leaves #results blank for a second or two —
    // paints placeholder rows instead. Injected synchronously *before* the
    // ensurePagefind() await (the main script is inline, so this lands on screen
    // at first paint) and replaced by the real list (or a message) as soon as
    // the search resolves.
    const SK_ROWS = ('<li class="pf-skeleton" aria-hidden="true">'
      + '<div class="sk-meta"><span class="sk-bar sk-badge"></span><span class="sk-bar sk-pill"></span></div>'
      + '<span class="sk-bar sk-title"></span></li>').repeat(6);
    function showSearchSkeleton() {
      const r = $('#results');
      // Only when #results is genuinely empty — never clobber real results, a
      // message (loading / refreshing / no-matches / error all use .muted), or a
      // skeleton already on screen.
      if (r.querySelector('.pf-result, .muted, .pf-skeleton')) return;
      r.innerHTML = SK_ROWS;
    }

    async function runSearch(immediate = false) {
      setMode(isSearching());
      if (!isSearching()) { $('#results').innerHTML = ''; $('#searchCount').textContent = ''; rState.key = ''; searchGen++; syncUrl(); return; }
      // Mark this as the latest search. Every keystroke calls runSearch, so older
      // in-flight calls (and their background settles) must bail the moment a
      // newer one starts — otherwise concurrent searches race and a stale or
      // half-merged result can paint over the right one (the "typing without
      // Enter shows different results" bug).
      const gen = ++searchGen;
      if (!pagefind) showSearchSkeleton(); // engine not loaded yet → placeholder, not a blank panel
      const pf = await ensurePagefind();
      if (gen !== searchGen) return; // superseded by a newer search — say nothing
      if (!pf) {
        // The loader reports its own failure in #searchStatus and resolves null.
        // Mid-heal that is not enough: #results is showing "Refreshing the search
        // index…" and would sit there for good, so finish the failure path and
        // give the reader the reload button. A cold failure (no build yet in
        // local dev) keeps the loader's own wording instead.
        if (healAttempted) handleSearchFailure(new Error('the index could not be reloaded'));
        return;
      }
      const terms = [...keywords, input.value.trim()].filter(Boolean);
      const filters = {};
      for (const f of FACETS) if (sel[f].size) filters[f] = { any: [...sel[f]] };
      const query = terms.join(' ') || null;
      // Empty query = browsing: order by the build-time key (open calls first,
      // soonest deadline on top), and filter to Workshops so browsing never
      // touches the papers index. With keywords, Pagefind's relevance ranking is
      // what people expect.
      const opts = query === null
        ? { filters: { ...filters, type: { any: ['Workshops'] } }, sort: { order: 'asc' } }
        : { filters };
      try {
        // On restore (back/forward, deep link) search immediately: debouncedSearch
        // returns null when superseded, and a lone restore-time call can be
        // swallowed, leaving the results empty even though the query is valid.
        const res = immediate ? await pf.search(query, opts) : await pf.debouncedSearch(query, opts, 220);
        if (res === null || gen !== searchGen) return; // coalesced away or superseded
        // Build-time truth check: in browse mode (no keywords) this page knows
        // exactly how many workshops the current selection matches (FW). Zero
        // results where >0 are expected can only mean the engine's lazily loaded
        // data files are gone — i.e. a deploy replaced them after this tab opened.
        if (query === null && res.results.length === 0) {
          const expected = FW.filter((w) => FACETS.every((f) => {
            const vals = Array.isArray(w[f]) ? w[f] : [w[f]];
            return sel[f].size === 0 || vals.some((v) => sel[f].has(v));
          })).length;
          if (expected > 0) throw new Error(`0 results where ${expected} expected`);
        }
        if (res.results.length > 150) $('#results').innerHTML = `<li class="muted">Loading ${res.results.length} results…</li>`;
        // Render the first page fast from a capped slice, then complete the exact
        // counts. A big result set otherwise shows nothing until every match is
        // fetched + grouped (the 5-18s "Loading N…" wait); the top workshops are
        // identical whether computed from the first slice or the whole set
        // (results are score-sorted, each workshop's papers ride in its own
        // result), so the first page paints right away and the headline count
        // settles a beat later. Skipped when restoring a deep-linked page
        // (pendingPage > 1), which wants the exact page immediately.
        const FAST = PAGE_SIZE * 2;
        const twoPhase = res.results.length > FAST && pendingPage <= 1;
        let n = await buildState(res, query, filters, terms, twoPhase ? FAST : undefined);
        if (gen !== searchGen) return; // a newer search superseded us mid-build
        healAttempted = false; // healthy — a future deploy may heal again
        renderResultsPage();
        if (twoPhase) {
          // Phase 2: full grouping + exact count. Resilient — if this fetch
          // stalls or fails, keep the first page already on screen rather than
          // dropping into the heal path and wiping it.
          try {
            const full = await buildState(res, query, filters, terms);
            if (gen !== searchGen) return;
            n = full;
            renderResultsPage();
          } catch {}
        }
        if (query !== null) settleInBackground(gen, pf, query, opts, filters, terms, n);
      } catch (err) {
        return handleSearchFailure(err);
      }
    }

    async function handleSearchFailure(err) {
      // The site redeploys often (daily auto-rebuild + content pushes), and
      // every deploy replaces the hashed search-data files the engine loads
      // lazily — so a tab opened before a deploy gets zero results for every
      // filter. The engine's manifest fetch is timestamp-busted, so a fresh
      // import picks up the new files in place, no page reload needed.
      if (!healAttempted) {
        healAttempted = true;
        $('#results').innerHTML = '<li class="muted">Refreshing the search index…</li>';
        pfReady = null; pagefind = null; pfBust = Date.now();
        return runSearch();
      }
      // Heal failed too (e.g. mid-deploy). Reset the engine so the user's
      // next interaction retries cleanly, and say what actually happened.
      pfReady = null; pagefind = null; pfBust = Date.now();
      $('#results').innerHTML =
        '<li class="muted">The search index changed since this page was loaded (the site updates itself), and it couldn\'t be refreshed in place: ' + esc(err?.message || err) + '. <button type="button" class="btn-quiet" onclick="location.reload()">Reload the page</button> or try the filter again in a moment.</li>';
      $('#searchCount').textContent = '';
    }

    // A result's document metadata as the API-shaped object the shared row
    // renderer takes — the names /api/workshops.json uses; the contract is
    // `pfFields` in workshop/[slug].astro. A keyword can match only the papers
    // document, which carries the same fields, so a full row renders either way.
    function viewFromMeta(g) {
      const meta = (g.ws ?? g.papers).meta ?? {};
      const json = (s) => { try { return s ? JSON.parse(s) : null; } catch { return null; } };
      return {
        slug: g.slug,
        name: g.ws?.meta?.title ?? String(g.papers?.meta?.title ?? '').replace(/ — accepted papers$/, ''),
        acronym: meta.acronym || null,
        short_name: meta.short_name || null,
        conference: meta.conference ?? '',
        year: meta.year ?? '',
        topics: json(meta.topics) ?? [],
        status: meta.state,
        status_label: meta.status ?? '',
        deadline_wall_clock: meta.deadline || null,
        deadline_utc: meta.deadline_utc || null,
        next_stage_utc: meta.next_stage_utc || null,
        next_stage_is_abstract: meta.next_stage_is_abstract === '1',
        abstract_deadline_wall_clock: meta.abstract_deadline_wall_clock || null,
        abstract_deadline_utc: meta.abstract_deadline_utc || null,
        location_label: meta.location_label || null,
        location_distinguishes: !!meta.location_label,
        deadline_change: json(meta.deadline_change),
      };
    }

    function renderResultsPage() {
      // The row renderer arrives with the bundled module scripts; on a deep
      // link this inline script can get here first. Wait a beat rather than
      // paint a row without it.
      if (!window.awtWsRowHtml) { setTimeout(renderResultsPage, 50); return; }
      const { groups, page, nPapers, hasQuery } = rState;
      const SUBS_PER_WS = 5;
      const nPages = Math.max(1, Math.ceil(groups.length / PAGE_SIZE));
      const rows = [];
      for (const [key, g] of groups.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)) {
        const view = viewFromMeta(g);
        const conf = view.conference;
        const wsName = view.name;
        const slug = g.slug || '';
        const wsLabel = `${wsName} — ${conf} ${view.year}`.trim();
        let papersHtml = '';
        if (hasQuery && g.subs.length) {
          const subs = g.subs;
          papersHtml =
            '<ul class="pf-papers"><li class="pf-subhead">Matching papers</li>' +
            subs.slice(0, SUBS_PER_WS).map((sr) => sr.fall
              ? `
              <li class="pf-xfall"><a target="_blank" rel="noopener" href="${esc(sr.url)}">${esc(sr.title)}</a></li>`
              : (() => {
                const pt = String(sr.title).replace(/^[\s☆★]+/, '');
                const ppid = (String(sr.url).match(/#p-([^#?]+)/) || [])[1] || '';
                return `
              <li class="pf-paper">${ppid ? `<button type="button" class="star-btn" data-star-paper="${esc(ppid)}" data-title="${esc(pt)}" data-ws="${esc(slug)}" data-wsname="${esc(wsLabel)}" aria-pressed="false" aria-label="Save paper: ${esc(pt)}">☆</button>` : ''}<a class="pf-ptitle" href="${esc(ppid ? `${g.url}#p-${ppid}` : sr.url)}">${esc(pt)}</a><p class="pf-excerpt">${stripLeadingTitle(sr.excerpt, pt)}</p></li>`;
              })()).join('') +
            (subs.length > SUBS_PER_WS
              ? `<li class="pf-more"><a href="${esc(g.url)}#papers">…${subs.length - SUBS_PER_WS} more matching papers →</a></li>`
              : '') +
            '</ul>';
        }
        // The board's row, from the document's metadata: badge, name, star,
        // topics, the deadline with local time and a live countdown. Browsing
        // by facet is then the board, filtered; with keywords the excerpt and
        // the matching papers follow beneath.
        const rowHtml = window.awtWsRowHtml(view, {
          base,
          conf: { name: conf, color: confColors[conf] ?? '#888' },
          topicLabel: (id) => TOPIC[id] ?? id,
          pill: true,
          star: 'off',
          titleClass: 'pf-title',
        });
        rows.push(`
        <li class="pf-result">${rowHtml}${hasQuery && g.ws ? `<p class="pf-excerpt">${g.ws.excerpt}</p>` : ''}${papersHtml}</li>`);
      }
      if (nPages > 1 && !rState.partial) {
        rows.push(
          '<li class="pager-row"><nav class="pager" aria-label="Result pages">' +
            Array.from({ length: nPages }, (_, i) => i + 1)
              .map((n) => `<button type="button" data-page="${n}" class="${n === page ? 'is-on' : ''}" ${n === page ? 'aria-current="page"' : ''}>${n}</button>`)
              .join('') +
            '</nav></li>',
        );
      }
      const n = groups.length;
      $('#searchCount').textContent = rState.partial
        ? 'Counting…'
        : (n
          ? `${n} workshop${n === 1 ? '' : 's'}${hasQuery && nPapers ? ` · ${nPapers} matching paper${nPapers === 1 ? '' : 's'}` : ''}${!hasQuery ? ' · open calls first' : ' · by relevance'}${nPages > 1 ? ` · page ${page}/${nPages}` : ''}`
          : '');
      $('#results').innerHTML =
        rows.join('') ||
        '<li class="muted">No matches — remove a keyword or filter, or <a href="' + esc(`${base}/about/`) + '">add the workshop</a>.</li>';
      window.awtFavsHydrate?.();
      // Rows rendered after load: local times, countdowns and the clock, from
      // board.js — the same hydration the saved list gets.
      window.awtBoardHydrate?.($('#results'));
      syncUrl();
    }

    // events
    input.addEventListener('input', () => runSearch());
    input.addEventListener('focus', ensurePagefind, { once: true });
    (window.requestIdleCallback || ((fn) => setTimeout(fn, 300)))(() => ensurePagefind());
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        const v = input.value.trim().toLowerCase();
        if (v && !keywords.includes(v)) keywords.push(v);
        input.value = '';
        renderChips(); runSearch();
      } else if (e.key === 'Backspace' && input.value === '' && keywords.length) {
        keywords.pop(); renderChips(); runSearch();
      }
    });
    $('#results').addEventListener('click', (e) => {
      const btn = e.target.closest('.pager button[data-page]');
      if (!btn) return;
      rState.page = Number(btn.dataset.page);
      renderResultsPage();
      document.getElementById('searchPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    chipsBox.addEventListener('click', (e) => {
      const btn = e.target.closest('.kw-x');
      if (!btn) return;
      keywords.splice(Number(btn.dataset.i), 1);
      renderChips(); runSearch(); input.focus();
    });
    document.addEventListener('change', (e) => {
      const cb = e.target.closest('input[data-f]');
      if (!cb) return;
      sel[cb.dataset.f][cb.checked ? 'add' : 'delete'](cb.value);
      updateLiveCounts(); updateFacetSummaries(); runSearch();
    });
    $('#clearSearch').addEventListener('click', () => {
      keywords = []; input.value = '';
      for (const f of FACETS) sel[f].clear();
      renderChips(); renderFacetPanels(); runSearch();
    });
    // Facet dropdown open/close now lives in scripts/dropdowns.js, loaded by
    // Base.astro and shared with the alerts pickers.

    facetOptions = Object.freeze(
      Object.fromEntries(FACETS.map((f) => [f, Object.freeze(facetSort(f, Object.keys(initialCounts[f] ?? {})))])),
    );

    // Remember where the user was scrolled on a results page, so returning from
    // a clicked result lands back at that spot instead of the top. The results
    // render asynchronously after a (re)load, so the browser's own scroll
    // restoration fires before they exist and gives up at the top — we restore
    // explicitly once they're back in the DOM. Keyed by the search querystring
    // so it only applies to the same search.
    function saveScroll() {
      try {
        if (isSearching()) sessionStorage.setItem('pf:scroll', JSON.stringify({ k: location.search, y: window.scrollY }));
      } catch {}
    }
    function restoreScrollForSearch() {
      try {
        const s = JSON.parse(sessionStorage.getItem('pf:scroll') || 'null');
        if (s && s.k === location.search && typeof s.y === 'number' && s.y > 0) {
          // Two frames so the freshly-rendered list has been laid out and the
          // page is tall enough to actually scroll there. Jump instantly —
          // the page's smooth scroll-behavior would otherwise animate all the
          // way down from the top on every return.
          requestAnimationFrame(() => requestAnimationFrame(() => window.scrollTo({ top: s.y, left: 0, behavior: 'instant' })));
        }
      } catch {}
    }
    window.addEventListener('pagehide', saveScroll);

    // hydrate from URL, THEN render panels so deep-linked boxes draw checked.
    async function hydrateFromUrl() {
      const p = new URLSearchParams(location.search);
      keywords = (p.get('q') || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);
      for (const f of FACETS) { sel[f].clear(); for (const v of (p.get(f) || '').split(',').filter(Boolean)) sel[f].add(v); }
      pendingPage = Math.max(1, Number(p.get('page')) || 1);
      input.value = ''; // committed keywords live in `keywords`; clear any stale partial text
      renderChips();
      renderFacetPanels();
      if (isSearching()) { await runSearch(true); restoreScrollForSearch(); }
      else setMode(false);
    }
    hydrateFromUrl();

    // Back/forward navigation. A bfcache restore (persisted) brings the page
    // back fully intact — rendered results, JS state, and the live click
    // handler — so re-running the search would be wasteful AND can reorder the
    // results (Pagefind may merge its dual index in a different order on a
    // fresh call). So on restore we only re-hydrate when the rendered results
    // are actually MISSING or no longer match the URL's query; otherwise we
    // leave the restored DOM exactly as the user left it.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      const urlQ = new URLSearchParams(location.search).toString();
      const renderedQ = (() => {
        const p = new URLSearchParams();
        if (keywords.length) p.set('q', keywords.join(','));
        for (const f of FACETS) if (sel[f].size) p.set(f, [...sel[f]].join(','));
        if (isSearching() && rState.page > 1) p.set('page', String(rState.page));
        return p.toString();
      })();
      const hasResults = $('#results').querySelector('.pf-result, .pf-empty, .pf-error');
      // Re-hydrate only if the restored view doesn't match the URL, or results
      // somehow didn't survive the restore. Matching state → leave it untouched.
      if (urlQ !== renderedQ || (isSearching() && !hasResults)) hydrateFromUrl();
    });
  </script>
</Base>

