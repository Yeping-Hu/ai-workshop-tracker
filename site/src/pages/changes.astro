---
/**
 * /changes/ — what moved in the tracker this week, as a public page.
 *
 * The same week the Monday digest reports, from the same array of events. The
 * events live in D1 and a static build cannot read them, so the alerts Action
 * commits `data/changes.json` on every run and this page renders it. That is
 * what makes "one diff computation, two consumers" true: the alternative — the
 * page deriving its own diff from git history — would let the page and the
 * email disagree about what happened, which is the one thing they must not do.
 *
 * Current week only, deliberately. No archive: `/changes/?week=…` would be a
 * second, slower way to ask what the workshop pages already answer per entry,
 * and the events table is pruned anyway.
 *
 * First run, and quiet weeks: the file may not exist (a fork, a fresh clone, or
 * before the Action has run once) and may legitimately contain zero events. Both
 * render the empty state; neither fails the build. A fork with no alerts
 * satellite at all still builds this page — it just says nothing changed.
 */
import fs from 'node:fs';
import path from 'node:path';
import Base from '../components/Base.astro';
import AlertsSignup from '../components/AlertsSignup.astro';
import { workshops, conferenceById, topicById } from '../lib/data';
import { href } from '../lib/site';
// @ts-ignore — shared plain-JS module at the repo root
import { displayLabel } from '../../../lib/identity.mjs';
// @ts-ignore — shared plain-JS module at the repo root
import { mergeEventsBySlug } from '../../../lib/events.mjs';

const ROOT = path.resolve(process.cwd(), '..');
const FEED = path.join(ROOT, 'data', 'changes.json');

let feed: any = { generated_at: null, since: null, events: [] };
try {
  if (fs.existsSync(FEED)) feed = JSON.parse(fs.readFileSync(FEED, 'utf8'));
} catch {
  // A malformed feed renders the empty state rather than breaking the build:
  // this page is a nice-to-have, the rest of the site is not.
  feed = { generated_at: null, since: null, events: [] };
}

const bySlug = new Map(workshops.map((w: any) => [w.slug, w]));

/** Prose register of the shared vocabulary — the same words the site uses.
 *  Carried on the badge's `title`, so the full sentence is still available on
 *  hover and to assistive tech even though the chip itself is terse. */
function leadFor(e: any) {
  const d = e.days === 1 ? 'day' : 'days';
  if (e.kind === 'extended') return `Extended ${e.days} ${d}`;
  if (e.kind === 'earlier') return `Moved ${e.days} ${d} earlier`;
  return 'First deadline posted';
}

/** What the chip actually shows. A row is scanned, not read: at 45 rows the
 *  words "Extended" and "days" repeat on nearly every line and carry no
 *  information the colour and the sign do not already give. The direction lives
 *  in the sign, the magnitude in the number, the kind in the tone. */
function badgeFor(e: any) {
  if (e.kind === 'extended') return `+${e.days}d`;
  if (e.kind === 'earlier') return `\u2212${e.days}d`;
  if (e.kind === 'deadline_announced') return 'ddl posted';
  return 'New';
}

const CHANGE_KINDS = new Set(['extended', 'earlier', 'deadline_announced']);

/** Badge tone per kind — the same five the digest uses (alerts/render.mjs
 *  BADGE_TONE), so a reader who gets the email recognises the page. The words
 *  stay in the site's prose register; only the treatment is shared. */
const TONE: Record<string, string> = {
  extended: 'extended',
  earlier: 'earlier',
  deadline_announced: 'first',
  announced: 'new',
};

const rows = mergeEventsBySlug(Array.isArray(feed.events) ? feed.events : [])
  .map((e: any) => {
    const w: any = bySlug.get(e.slug);
    if (!w) return null; // a workshop removed since the event was recorded
    const conf = conferenceById.get(w.conference);
    return {
      slug: w.slug,
      kind: e.kind,
      lead: leadFor(e),
      badge: badgeFor(e),
      tone: TONE[e.kind] ?? 'new',
      name: w.name,
      label: displayLabel(w.name, w.acronym, {
        conference: conf?.name ?? w.conference,
        year: w.year,
        trackLabel: w.trackLabel ?? null,
      }),
      conference: conf?.name ?? w.conference,
      color: conf?.color ?? null,
      topics: (w.topics ?? []).map((t: string) => topicById.get(t)?.label ?? t).filter(Boolean),
      whenIso: e.new_utc ?? w.deadlineUtc ?? null,
      status: w.status ?? null,
      url: href(`/workshop/${w.slug}/`),
    };
  })
  .filter(Boolean) as any[];

// Drop rows whose deadline had already passed when the reported window OPENED
// — not when the page was built.
//
// The distinction matters. This page is a record of one week, so a deadline
// that closed *during* that week is part of the story: it moved, then it
// arrived, and both happened inside the window being reported. What does not
// belong is a deadline that was already in the past before the window began —
// "Moved 26 days earlier … 21 Jul 2026" in a page covering 18–25 August is an
// event recorded late, not news, and reads as a mistake.
//
// Filtering on build time instead would quietly re-cut the page every deploy:
// the same week would lose rows as the day wore on, and a rebuild triggered for
// an unrelated reason would silently change what the week is said to contain.
// The window start is fixed by the feed, so the page is stable for as long as
// the feed is.
const windowStartMs = feed.since ? Date.parse(`${feed.since}T00:00:00Z`) : null;
const withinWindow = (r: any) => {
  if (!r.whenIso || windowStartMs == null || !Number.isFinite(windowStartMs)) return true;
  const ms = Date.parse(r.whenIso);
  // Rows with no date, or an unparseable one, are kept: an announcement without
  // a deadline has nothing to have passed.
  return !Number.isFinite(ms) || ms >= windowStartMs;
};

// Same section semantics as the digest: a first-published deadline IS a deadline
// change, and "new this week" is a workshop appearing at all. Past editions are
// not news, exactly as the digest filters them.
// One row per workshop, in two senses.
//
// ACROSS sections: a workshop that appeared this week and published its first
// deadline in the same week generates two events — `announced` and
// `deadline_announced` — and would otherwise be listed twice, badged New in one
// section and First deadline in the other. That is one piece of news. The
// workshop is new; having a deadline is part of being new, not a separate
// development, so the New row wins and the change row is dropped.
//
// WITHIN a section: a deadline can move more than once in seven days, and each
// move is its own event. Listing them all repeats the same workshop down the
// page with different numbers. The last event for a slug wins, because the feed
// is written in observation order and the row's date column shows the current
// deadline — so the badge should describe the hop that produced it.
//
// This loses the intermediate hops: a workshop extended 7 days and then 1 more
// reads as +1d against its current date, not +8d. Summing them would be a
// derivation the event store never recorded, and this page does not invent
// values.
const added = rows.filter((r) => r.kind === 'announced' && r.status !== 'past').filter(withinWindow);
const isNew = new Set(added.map((r) => r.slug));
const changes = rows.filter((r) => CHANGE_KINDS.has(r.kind)).filter(withinWindow).filter((r) => !isNew.has(r.slug));

// Grouped by conference, alphabetically — the digest does the same, for the same
// reason: a flat wall of rows from nine conferences is harder to scan.
// Within a conference, earliest deadline first. The feed arrives in observation
// order, which is the pipeline's business and looks arbitrary here.
//
// Nothing in this sort reads the clock. This page is a record of one week, and
// it must say the same thing on Tuesday as it did on the Friday it was written
// — a rank that partitioned past from future would silently re-order the page
// as the days passed, and two people opening the same URL would see different
// pages with nothing to explain why. The only clock this page obeys is the
// feed's own window.
//
// Rows with no date go last, having nothing to sort by.
function deadlineRank(r: any) {
  const t = r.whenIso ? Date.parse(r.whenIso) : NaN;
  return Number.isFinite(t) ? [0, t] : [1, 0];
}

function groupByConference(list: any[]) {
  const m = new Map<string, any[]>();
  for (const r of list) {
    if (!m.has(r.conference)) m.set(r.conference, []);
    m.get(r.conference)!.push(r);
  }
  for (const rows of m.values()) {
    rows.sort((a, b) => {
      const [ga, va] = deadlineRank(a);
      const [gb, vb] = deadlineRank(b);
      return ga !== gb ? ga - gb : va - vb;
    });
  }
  return [...m.entries()].sort((a, b) => a[0].localeCompare(b[0]));
}

const changeGroups = groupByConference(changes);
const addedGroups = groupByConference(added);
const total = changes.length + added.length;

const weekOf = feed.since
  ? new Date(`${feed.since}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
    })
  : null;
---

<Base
  title="What changed this week"
  description="Deadline extensions, first deadlines posted and workshops added to the AI Workshop Tracker in the last seven days."
>
  <section class="masthead changes-masthead">
    <p class="eyebrow">This week</p>
    <h1>What changed</h1>
    <p class="muted">
      {total > 0
        ? `${changes.length} deadline change${changes.length === 1 ? '' : 's'} and ${added.length} new workshop${added.length === 1 ? '' : 's'} since ${weekOf}.`
        : 'Nothing has changed in the last seven days.'}
      {' '}All times UTC.
    </p>
  </section>

  {/* The signup is the point of the page for anyone not already subscribed, so
      it leads rather than trailing forty rows behind a link to another page
      that only says the same thing again. It hides itself once this browser is
      linked, and renders nothing at all when the alerts satellite is off. */}
  <AlertsSignup
    heading="Get this weekly, by email"
    blurb="This page, filtered to the conferences and topics you pick, in your inbox every Monday."
    compact
    tight
    collapsed
    summary="Get this weekly, by email"
  />

  {total > 0 && (
    <section class="changes-filters" data-changes-filters hidden>
      <p class="muted small">
        <span data-changes-count></span>
        <button type="button" class="btn-quiet" data-changes-clear hidden>Clear filters</button>
      </p>
    </section>
  )}

  {changeGroups.length > 0 && (
    <section class="changes-block">
      <h2>Deadline changes</h2>
      {changeGroups.map(([conf, list]) => (
        <div class="changes-group" data-changes-group>
          <h3>{conf}</h3>
          <ul class="changes-list">
            {list.map((r) => (
              <li
                class="changes-row"
                data-changes-row
                data-slug={r.slug}
                data-conference={r.conference}
                data-topic={r.topics.join(',')}
              >
                <button
                  class="star-btn"
                  type="button"
                  data-star-ws={r.slug}
                  aria-pressed="false"
                  aria-label={`Save ${r.name} to your list`}
                  title="Save for later (stays in this browser)"
                >☆</button>
                <span class={`changes-badge is-${r.tone}`} title={r.lead}>{r.badge}</span>
                <span class="changes-text">
                  <a href={r.url}>{r.label}</a>
                  {r.whenIso && <span class="muted"> · {r.whenIso.slice(0, 10)}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {addedGroups.length > 0 && (
    <section class="changes-block">
      <h2>New this week</h2>
      <p class="muted small">workshops added to the tracker this week</p>
      {addedGroups.map(([conf, list]) => (
        <div class="changes-group" data-changes-group>
          <h3>{conf}</h3>
          <ul class="changes-list">
            {list.map((r) => (
              <li
                class="changes-row"
                data-changes-row
                data-slug={r.slug}
                data-conference={r.conference}
                data-topic={r.topics.join(',')}
              >
                <button
                  class="star-btn"
                  type="button"
                  data-star-ws={r.slug}
                  aria-pressed="false"
                  aria-label={`Save ${r.name} to your list`}
                  title="Save for later (stays in this browser)"
                >☆</button>
                <span class="changes-badge is-new" title="Added to the tracker this week">New</span>
                <span class="changes-text">
                  <a href={r.url}>{r.label}</a>
                  {r.whenIso && <span class="muted"> · {r.whenIso.slice(0, 10)}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {total === 0 && (
    <section class="changes-block">
      <p class="muted">
        Quiet weeks happen, and the tracker does not pad them. The{' '}
        <a href={href('/')}>board</a> lists every open call.
      </p>
    </section>
  )}

</Base>

<script>
  import { readFacets, matchesFacets } from '../scripts/facet-params.js';

  // Facets come from the board's own URL contract, so a link built there — or
  // by the digest's "and N more" — filters this page the same way.
  const sel = readFacets(location.search, ['conference', 'topic']);
  const rows = [...document.querySelectorAll('[data-changes-row]')];

  // Saved state is NOT read here. Every row carries the board's own
  // `data-star-ws` button, and scripts/favorites.js — loaded site-wide by
  // Base.astro — hydrates it from localStorage and handles clicks through one
  // delegated listener. A second reader here would be a parallel system that
  // could disagree with the board about what is saved.

  let shown = 0;
  for (const el of rows) {
    const row = {
      conference: el.getAttribute('data-conference') || '',
      topic: (el.getAttribute('data-topic') || '').split(',').filter(Boolean),
    };
    const ok = matchesFacets(row, sel, ['conference', 'topic']);
    (el as HTMLElement).hidden = !ok;
    if (ok) shown += 1;
  }

  // A conference subheading with every row filtered out is a heading for
  // nothing, so the whole group goes with them.
  for (const g of document.querySelectorAll('[data-changes-group]')) {
    const any = [...g.querySelectorAll('[data-changes-row]')].some((r) => !(r as HTMLElement).hidden);
    (g as HTMLElement).hidden = !any;
  }

  const active = ['conference', 'topic'].filter((f) => sel[f] && sel[f].size);
  const bar = document.querySelector('[data-changes-filters]');
  if (bar && active.length) {
    (bar as HTMLElement).hidden = false;
    const count = bar.querySelector('[data-changes-count]');
    if (count) {
      count.textContent = `Showing ${shown} of ${rows.length}, filtered by ${active
        .map((f) => `${f}: ${[...sel[f]].join(', ')}`)
        .join(' · ')}. `;
    }
    const clear = bar.querySelector('[data-changes-clear]');
    if (clear) {
      (clear as HTMLElement).hidden = false;
      clear.addEventListener('click', () => { location.search = ''; });
    }
  }
</script>

<style is:inline>
  /* Badges. The five tones are the digest's own (alerts/render.mjs BADGE_TONE),
     so someone who reads the email recognises the page — mid-tone text on a
     bordered pill rather than white-on-colour, which is what lets the same
     values hold up on a dark ground. The words stay in the site's prose
     register; only the treatment is shared. */
  .changes-badge {
    flex: none;
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
    vertical-align: 0.06em;
  }
  /* The day-count chips take a common width so the title that follows starts at
     the same x on every row — "+7d" and "+26d" are different lengths, and left
     to themselves they shift the text a few pixels line to line, which reads as
     a ragged edge down a list of forty. Tabular figures keep the digits from
     doing the same thing inside the chip.
     "ddl posted" and "New" are deliberately excluded: they are words, not
     measurements, and padding them to match would open a gap rather than close
     one. */
  .changes-badge.is-extended,
  .changes-badge.is-earlier {
    min-width: 3rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .changes-badge.is-extended { color: #0f766e; }
  .changes-badge.is-earlier  { color: #9a3412; }
  .changes-badge.is-first    { color: #3730a3; }
  .changes-badge.is-new      { color: #3f6212; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .changes-badge.is-extended { color: #5ac0b4; }
    :root:not([data-theme='light']) .changes-badge.is-earlier  { color: #e0925f; }
    :root:not([data-theme='light']) .changes-badge.is-first    { color: #9aa2f0; }
    :root:not([data-theme='light']) .changes-badge.is-new      { color: #a3c264; }
  }
  :root[data-theme='dark'] .changes-badge.is-extended { color: #5ac0b4; }
  :root[data-theme='dark'] .changes-badge.is-earlier  { color: #e0925f; }
  :root[data-theme='dark'] .changes-badge.is-first    { color: #9aa2f0; }
  :root[data-theme='dark'] .changes-badge.is-new      { color: #a3c264; }
  /* The global masthead carries 1.4rem of bottom padding, and the signup adds
     0.6rem on top of it — 2rem of white between the summary line and the box.
     `tight` on the component only addressed its half. */
  .changes-masthead { padding-bottom: 0.4rem; }
  .changes-block { margin-top: 2rem; }
  .changes-block h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .changes-group h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.1rem 0 0.3rem;
  }
  .changes-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  /* star | badge | text. The text is its own flex cell, so a title that wraps
     hangs under its own first line instead of returning to the row's left edge
     and reading as a new entry. `min-width: 0` is what actually allows it to
     wrap inside a flex child rather than overflow. */
  .changes-row {
    line-height: 1.45;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .changes-text { flex: 1 1 auto; min-width: 0; }
  /* Every row carries a star, so the column is always the same width and the
     indentation never shifts between a saved row and an unsaved one — which is
     what the old ::before star did. */
  .changes-row .star-btn { flex: none; }
  .changes-filters { margin-top: 1.2rem; }
</style>
