---
import ToolPage from '../../components/ToolPage.astro';
---

<ToolPage slug="bibtex-citation-generator">
  <form class="tool-form" id="toolForm" data-slug="bibtex-citation-generator" data-kinds="doi,arxiv,isbn,pmid,openreview,url" data-styles="1">
    <label>DOI, arXiv id or link, ISBN, PubMed id, OpenReview link, or URL (one per line)
      <textarea id="toolInput" rows="4" spellcheck="false" placeholder="10.1145/3292500.3330701&#10;https://arxiv.org/abs/2106.09685&#10;978-0-262-03561-3"></textarea>
    </label>
    <div class="tool-row">
      <div class="tool-actions"><button class="btn" type="submit" id="toolGo">Generate BibTeX</button></div>
      <p class="tool-status" id="toolStatus" aria-live="polite"></p>
    </div>
  </form>
  <div class="tool-out" id="toolOut" hidden>
    <div class="tool-out-head">
      <h2>BibTeX</h2>
      <div class="tool-actions">
        <button class="btn secondary small" type="button" id="copyBib">Copy</button>
        <button class="btn secondary small" type="button" id="dlBib">Download .bib</button>
      </div>
    </div>
    <pre><code id="toolBib"></code></pre>
    <div id="toolStyles" hidden>
      <div class="tool-out-head"><h2>Formatted</h2></div>
      <dl class="cite-styles"></dl>
    </div>
  </div>
  <script src="../../scripts/tools/to-bibtex.js"></script>
</ToolPage>
