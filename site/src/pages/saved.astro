---
import Base from '../components/Base.astro';
import AlertsSignup from '../components/AlertsSignup.astro';
import { conferences, topics as allTopics } from '../lib/data';
import { ALERTS_API, href } from '../lib/site';
// The archive shelf's own stylesheet, loaded the way Base.astro loads global.css.
import '../styles/archive-shelf.css';

// Conference id -> {name, color} so saved rows get the same badges as the
// board. Tiny (~10 entries), embedded at build time.
const confMap = Object.fromEntries(conferences.map((c: any) => [c.id, { name: c.name, color: c.color }]));
// Topic ids -> labels, so a saved row can show the same chips the board does.
const topicMap = Object.fromEntries((allTopics as any[]).map((t: any) => [t.id, t.label]));
---

<Base
  title="Saved"
  description="Your starred workshops and papers — stored privately in this browser, sorted by deadline."
>
  <section class="masthead">
    <p class="eyebrow">Your list</p>
    <h1>Saved workshops &amp; papers</h1>
    <p class="lede">
      Everything you've starred, with live deadlines — open calls first, soonest on top.
    </p>
    {ALERTS_API && (
      <p class="muted small saved-sync-line" id="savedSyncLine" hidden>
        Synced as <strong id="savedSyncEmail"></strong> ·
        <a href={href('/alerts/manage/')}>manage</a>
      </p>
    )}
  </section>

  {/* AlertsSignup hides itself once this device is linked; the sync line above
      replaces it. Marked so the spacing can close up when it does — otherwise
      the next heading's 2.2rem top margin lands straight under the masthead's
      own padding and leaves a hole where the block used to be. */}
  {ALERTS_API && (
    <div id="savedAlerts">
      {/* Props are plain strings, not markup — Astro escapes them on render, so
          an HTML entity here would show through literally as "&amp;". */}
      <AlertsSignup
        collapsed
        tight
        hideSignedIn
        summary="Back up this list & get deadline alerts"
        heading="Back up this list & get deadline alerts"
        blurb="Subscribing makes this list follow you to another device, and emails you when a saved workshop's deadline moves or approaches."
      />
    </div>
  )}

  {/* Two halves, one section: the board rows above are what can still be acted
      on, and everything the site already calls Past goes to the shelf below.
      The archived half is a subsection rather than a section of its own because
      it is still the answer to "which workshops have I saved?" — it is only the
      part of that answer that no longer needs a countdown. Ids follow the page's
      savedX convention; the .awt-* classes are what archive-shelf.css styles and
      must stay exactly as they are. */}
    <section aria-labelledby="savedWsHead">
      <h2 id="savedWsHead">Upcoming workshops <span class="muted count" id="savedWsCount"></span></h2>
      <div class="board" id="savedWsList"><p class="muted" id="savedWsStatus">Loading your saved workshops…</p></div>
    </section>

    {/* Its own section now rather than a subsection of the one above. The case
        for nesting was that "which workshops have I saved?" is one question and
        this is half its answer — true, but this half carries a size slider, a
        find box and a Shelf/List switch, which is section-weight furniture under
        an h3, and its count was styled differently from the two h2 counts, so the
        page already showed two kinds of counter for what reads as three
        equivalent groups.

        The heading stays visible when the shelf is empty: hiding it would drop
        the page from three headings to two, which looks like a fault to anyone
        who saw three a moment ago. The .awt-* classes are what archive-shelf.css
        styles and must stay exactly as they are. */}
    <section aria-labelledby="savedArcHead">
      <h2 id="savedArcHead">Archived workshops <span class="muted count" id="savedArcHeadCount"></span></h2>
      <div class="awt-arc" id="savedArc">
        <div class="awt-arc__head">
          <span class="awt-arc__count" id="savedArcCount"></span>
          <div class="awt-arc__tools">
            {/* Percent rather than a fraction so the step lands on whole numbers;
                the script divides by 100 before writing --awt-scale. */}
            <label class="saved-arc-size" for="savedArcSize">
              <span class="muted small">Size</span>
              <input id="savedArcSize" type="range" min="70" max="130" step="5" value="100" aria-label="Book size">
            </label>
            <input class="awt-find" id="savedArcFind" type="search" placeholder="Find a volume" autocomplete="off" aria-label="Find a saved workshop">
            <div class="awt-seg" role="group" aria-label="View">
              <button type="button" id="savedArcShelfBtn" aria-pressed="true">Shelf</button>
              <button type="button" id="savedArcListBtn" aria-pressed="false">List</button>
            </div>
          </div>
        </div>
        {/* Outside the mount: the component owns that element's innerHTML and
            rewrites it on every paint. */}
        <div id="savedArcMount"></div>
        <p class="saved-arc-try" id="savedArcTry" hidden>
          <button type="button" class="btn-quiet" id="savedArcTryBtn">See it with a full shelf</button>
          <span class="muted small" id="savedArcTryNote"></span>
        </p>
      </div>
    </section>

  <section aria-labelledby="savedPaperHead">
    <h2 id="savedPaperHead">Papers <span class="muted count" id="savedPaperCount"></span></h2>
    <div id="savedPaperList"></div>
  </section>

  <p class="muted small storage-note">
    Saved items live only in this browser — nothing is sent to a server, and clearing this site's
    data (or switching devices) starts the list fresh. Star <span class="star-demo">☆</span> anything
    on the <a href={href('/')}>deadline board</a> or on a workshop page to add it here.
  </p>

  {/* board.js hydrates the rows rendered below: local times, countdowns and
      the clock — one implementation for the board, this list and the search
      results, instead of the compact twins this page used to carry. */}
  <script src="../scripts/board.js"></script>
  {/* Assigns window.awtArchiveShelf — the same global bridge board.js uses
      for awtBoardHydrate, and the reason it loads before the module below. */}
  <script src="../scripts/archive-shelf.js"></script>
  <script type="application/json" id="awt-conf" set:html={JSON.stringify(confMap)} />
  <script type="application/json" id="awt-topics" set:html={JSON.stringify(topicMap)} />

  <script>
    import { favWorkshops, favPapers, unstarWorkshop, repairWorkshops } from '../scripts/favorites.js';
    import { wsRowHtml } from '../scripts/ws-row.js';
    import { isArchived, demoShelf } from '../scripts/archive-split.js';

    const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
    const CONF = JSON.parse(document.getElementById('awt-conf')!.textContent || '{}');
    const TOPIC = JSON.parse(document.getElementById('awt-topics')!.textContent || '{}');
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    /* ---------------- workshops ---------------- */
    let allWorkshops: any[] | null = null; // from /api/workshops.json, fetched once
    // Old slug -> current slug, from the same payload: a star saved before two
    // OpenReview groups were merged has to follow the merge the way the URL
    // already does. Empty until the fetch lands, and empty is a valid map —
    // it just means no save can be rescued, only dropped.
    let movedSlugs: Record<string, string> = {};
    let wsLoadErr = '';
    async function ensureWorkshops(): Promise<any[] | null> {
      if (allWorkshops) return allWorkshops;
      try {
        const res = await fetch(`${base}/api/workshops.json`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const payload = await res.json();
        allWorkshops = payload.workshops;
        movedSlugs = payload.moved_slugs || {};
      } catch (err) {
        wsLoadErr = (err as Error).message || 'fetch failed';
      }
      return allWorkshops;
    }

    function sortKey(w: any) {
      // Open calls by soonest deadline → upcoming TBA → past by most recently
      // passed deadline → past with no deadline (most recent year first).
      // Mirrors the board's browse order.
      // Sort by the NEXT actionable stage so a two-stage workshop with an
      // imminent abstract deadline sorts where its countdown says it should.
      const ms = w.next_stage_utc
        ? Date.parse(w.next_stage_utc)
        : (w.deadline_utc ? Date.parse(w.deadline_utc) : null);
      if (w.status === 'upcoming' && ms != null) return [0, ms];
      if (w.status === 'upcoming') return [1, 0];
      // Not-running editions sort last, below everything that did happen.
      if (w.status === 'not_running') return [4, -(w.year ?? 0)];
      if (ms != null) return [2, -ms];
      return [3, -(w.year ?? 0)];
    }

    // The board's row, rendered by the shared client renderer (ws-row.js) —
    // the same one the homepage's search results use — so this list cannot
    // drift from the board again. Every row here is saved, so the star is
    // pressed; no status pill, because the row already says it twice: the
    // countdown column reads "passed" or "TBA", and a concluded row is greyed
    // by .row-passed. The board keeps the pill, where a row is scanned against
    // hundreds of others.
    const wsRow = (w: any) =>
      wsRowHtml(w, {
        base,
        conf: CONF[w.conference] ?? { name: w.conference, color: '#888' },
        topicLabel: (id: string) => TOPIC[id] ?? id,
        star: 'on',
        rowAttrs: `data-saved-ws="${esc(w.slug)}"`,
      });

    /* ---------------- the archive shelf ---------------- */
    // Everything the site already calls Past (isArchived — the same branch
    // deriveStatusLabel takes server-side) leaves the board list and becomes a
    // book spine. archive-shelf.js does NOT filter by status itself, whatever
    // its integration brief says; the cut line is the page's.
    let shelf: any = null;
    let demoMode = false; // the shelf is showing the demo, not the reader's own
    let activeCount = 0; // rows currently in #savedWsList
    let arcList: any[] = []; // what the shelf is currently showing, to repaint on resize

    /* ---- book size ----
       Kept, unlike the Shelf/List choice, because it is a legibility setting
       rather than a mode: someone who wants smaller books wants them smaller
       every visit. Written to :root because archive-shelf.css computes its
       geometry there; set on the shelf element it would resolve to nothing.
       Applied before the first paint, so there is no jump from one size to
       another and the component measures against the size it will keep. */
    const SIZE_KEY = 'awt-shelf-size';
    const SIZE_MIN = 70, SIZE_MAX = 130;
    const readSize = () => {
      try {
        const n = Number(localStorage.getItem(SIZE_KEY));
        return Number.isFinite(n) && n >= SIZE_MIN && n <= SIZE_MAX ? n : 100;
      } catch {
        return 100; // storage blocked (private mode): the default is fine
      }
    };
    // --awt-cover-w is written back as real pixels rather than left to a calc()
    // in the stylesheet: archive-shelf.js reads that one with parseFloat, and an
    // unregistered custom property computes to a token stream, so `calc(126px *
    // 1)` would parse as NaN and fall through to 0 — zero-width covers, books
    // overlapping, and a row that no longer opens under the cursor. The base is
    // read back from the sheet (with the inline value cleared first) so the
    // phone breakpoint keeps deciding it, rather than a second copy here.
    const applySize = (pct: number) => {
      const root = document.documentElement;
      root.style.setProperty('--awt-scale', String(pct / 100));
      root.style.removeProperty('--awt-cover-w');
      const base = parseFloat(getComputedStyle(root).getPropertyValue('--awt-cover-w')) || 126;
      root.style.setProperty('--awt-cover-w', `${Math.round(base * (pct / 100))}px`);
    };
    applySize(readSize());
    // Crossing the phone breakpoint changes that base, so the pixels have to be
    // worked out again from whichever value the sheet now supplies.
    let sizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(sizeTimer);
      sizeTimer = window.setTimeout(() => applySize(readSize()), 150);
    });

    function ensureShelf() {
      if (shelf) return shelf;
      shelf = (window as any).awtArchiveShelf({
        mount: $('#savedArcMount'),
        countEl: $('#savedArcCount'),
        workshops: [],
        conf: CONF,
        base,
        topicLabel: (id: string) => TOPIC[id] ?? id,
        // The component drops the volume from its own data and repaints before
        // this runs. In demo mode the volumes are nobody's, so the press must
        // stop there and never reach storage.
        onUnstar: (slug: string) => { if (!demoMode) unstarWorkshop(slug); },
      });

      const shelfBtn = $('#savedArcShelfBtn');
      const listBtn = $('#savedArcListBtn');
      const find = $('#savedArcFind') as HTMLInputElement;
      const setView = (v: 'shelf' | 'list') => {
        shelf.setView(v);
        shelfBtn.setAttribute('aria-pressed', String(v === 'shelf'));
        listBtn.setAttribute('aria-pressed', String(v === 'list'));
        // The size slider only moves books; in a list of rows it would be a
        // control that visibly does nothing.
        $('#savedArc').setAttribute('data-view', v);
        // setView repaints from scratch and takes the filter and the count
        // label with it — the filter box would be left holding a query nothing
        // on screen was narrowed by, and the demo would relabel itself as
        // "16 volumes" of work the reader never saved.
        if (find.value) shelf.filter(find.value);
        markCount();
      };
      shelfBtn.addEventListener('click', () => setView('shelf'));
      listBtn.addEventListener('click', () => setView('list'));
      find.addEventListener('input', () => shelf.filter(find.value));

      // Changing the size changes every book's width, and the component works
      // out how far each row steps aside from measured widths — so a repaint
      // is what makes the new size correct, not just smaller. Coalesced to one
      // per frame because a dragged slider fires far faster than a re-measure
      // of a long shelf can keep up with.
      const size = $('#savedArcSize') as HTMLInputElement;
      size.value = String(readSize());
      let queued = false;
      size.addEventListener('input', () => {
        applySize(Number(size.value));
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          shelf.replace(arcList); // repaints, re-measures, and re-applies the filter
          markCount();
        });
      });
      // Only once the reader has settled on a size, not on every frame of the drag.
      size.addEventListener('change', () => {
        try {
          localStorage.setItem(SIZE_KEY, size.value);
        } catch {
          /* storage blocked: the size still applies for this visit */
        }
      });
      return shelf;
    }

    // replace() rewrites the count element every time it paints, so anything
    // that repaints has to say again that a demo is a demo — otherwise
    // nudging the size slider relabels the demo as "16 volumes" of saved work.
    const markCount = () => {
      if (demoMode) $('#savedArcCount').textContent = 'demo';
    };

    /* ---- whether the demo shows itself ----
       An empty shelf opens the demo on its own: an optional button is a thing
       almost nobody presses, and a shelf nobody has seen working is a shelf
       nobody knows they want. Dismissing it is remembered for good, so it is
       an offer made once rather than every visit. It can only ever appear over
       an EMPTY archive — a reader with volumes of their own always sees those. */
    const DEMO_KEY = 'awt-shelf-demo';
    const demoHidden = () => {
      try {
        return localStorage.getItem(DEMO_KEY) === 'hidden';
      } catch {
        return false; // storage blocked: showing it is the friendlier default
      }
    };
    const setDemoHidden = (hidden: boolean) => {
      try {
        if (hidden) localStorage.setItem(DEMO_KEY, 'hidden');
        else localStorage.removeItem(DEMO_KEY);
      } catch {
        /* storage blocked: the choice holds for this visit only */
      }
    };

    function paintArc(list: any[], { demo = false } = {}) {
      demoMode = demo;
      arcList = list;
      ensureShelf().replace(list);
      // Gates the search box and the view toggle: both are noise over an empty
      // shelf, and both are the point of the demo.
      $('#savedArc').toggleAttribute('data-filled', list.length > 0);
      markCount();
      $('#savedArcTry').hidden = list.length > 0 && !demo;
      $('#savedArcTryBtn').textContent = demo ? 'Hide the demo' : 'Curious? Try a demo shelf';
      // The hint is what tells someone the shelf is worth touching; which verb
      // is right depends on the pointer, so both ship and CSS picks one.
      $('#savedArcTryNote').innerHTML = demo
        ? `<span class="hint-hover">Hover a book to open it.</span> <span class="hint-tap">Drag a finger along the shelf to open the books.</span>
           Real workshops, none of them yours — star <span class="star-demo">☆</span> anything on the
           <a href="${base}/">deadline board</a> and your own shelf fills up as its deadlines pass.`
        : '';
      if (!demo && list.length === 0) openDemoIfWanted();
    }

    async function openDemoIfWanted() {
      if (demoHidden()) return;
      const all = await ensureWorkshops();
      // The shelf can fill up while that request is in flight — an alerts sync
      // landing a saved past workshop, say. Only ever take over an empty one.
      if (!all || demoMode || arcList.length) return;
      paintArc(demoShelf(all), { demo: true });
    }

    $('#savedArcTryBtn').addEventListener('click', async () => {
      if (demoMode) {
        setDemoHidden(true); // recorded first, or the repaint below reopens it
        renderWorkshops();
        return;
      }
      setDemoHidden(false);
      const all = await ensureWorkshops();
      if (!all) {
        $('#savedArcTryNote').textContent = `Couldn't load the demo (${wsLoadErr}).`;
        return;
      }
      paintArc(demoShelf(all), { demo: true });
    });

    /* ---------------- the saved list ---------------- */
    // "Nothing saved yet" and "everything you had saved is gone" arrive at the
    // same list, so the empty half is one function that takes whatever line
    // belongs above it.
    function paintNoWorkshops(note = '') {
      // The count is set by the caller, which knows both halves; blanking it here
      // would leave the heading looking mid-load.
      $('#savedWsList').innerHTML =
        note +
        `<div class="empty-state">No saved workshops yet — star <span class="star-demo">☆</span> any
         workshop on the <a href="${base}/">deadline board</a> and it'll wait here, sorted by deadline.</div>`;
      activeCount = 0;
      paintArc([]);
    }

    /**
     * What to say about a repair, once. A rename gets no line: the workshop is
     * still on the list, under the name the rest of the site now uses. A drop
     * does, because a count went down without the reader pressing anything —
     * and it is said in the past tense, since by the time this renders the list
     * has already been cleaned and the next visit has nothing to report.
     */
    function repairNote(fixed: { dropped: string[]; stale: number }) {
      const gone = fixed.dropped.length;
      if (gone)
        return `<p class="muted small">${gone} saved workshop${gone === 1 ? '' : 's'} left the dataset
                (removed upstream), so ${gone === 1 ? 'it has' : 'they have'} been taken off your list.</p>`;
      // Only reachable when the list could not be written — a browser blocking
      // or full on storage. The mismatch survives this visit, so say why.
      if (fixed.stale)
        return `<p class="muted small">${fixed.stale} saved workshop${fixed.stale === 1 ? ' is' : 's are'}
                no longer in the dataset, and this browser wouldn't let us clear
                ${fixed.stale === 1 ? 'it' : 'them'} from your list.</p>`;
      return '';
    }

    // (n) for anything, including zero: an empty section keeps its heading, so it
    // needs a count that says empty rather than an absent one that reads as
    // "still loading".
    function setCount(sel: string, n: number) {
      const el = $(sel);
      if (el) el.textContent = "(" + n + ")";
    }

    async function renderWorkshops() {
      const stored = favWorkshops();
      if (stored.length === 0) {
        setCount('#savedWsCount', 0);
        setCount('#savedArcHeadCount', 0);
        paintNoWorkshops();
        return;
      }
      if (!(await ensureWorkshops())) {
        $('#savedWsList').innerHTML =
          `<p class="muted">Couldn't load workshop data (${esc(wsLoadErr)}) —
           your stars are safe; <button type="button" class="btn-quiet" onclick="location.reload()">reload to retry</button>.</p>`;
        return;
      }
      // A saved slug the corpus no longer has is repaired here rather than
      // explained in a footnote: it follows a merge if the workshop was merged,
      // and leaves the list if it is genuinely gone. Doing it before anything is
      // counted is what keeps the heading, the nav badge and the rows agreeing.
      const fixed = repairWorkshops({ live: allWorkshops!.map((w) => w.slug), moved: movedSlugs });
      const note = repairNote(fixed);
      const slugs = favWorkshops(); // re-read: the repair may have rewritten it
      if (slugs.length === 0) {
        setCount('#savedWsCount', 0);
        setCount('#savedArcHeadCount', 0);
        paintNoWorkshops(note);
        return;
      }
      const wanted = new Set(slugs);
      const mine = allWorkshops!.filter((w) => wanted.has(w.slug));
      const active = mine.filter((w) => !isArchived(w));
      const archived = mine.filter(isArchived);
      active.sort((a, b) => {
        const [ga, ka] = sortKey(a), [gb, kb] = sortKey(b);
        return ga - gb || ka - kb || String(a.name).localeCompare(String(b.name));
      });
      activeCount = active.length;
      // The two headings partition one list, so each counts its own half. Before
      // the split this heading counted EVERY saved workshop, which as a top-level
      // pair would have read (41) upcoming beside (38) archived on a list of 41.
      setCount('#savedWsCount', active.length);
      setCount('#savedArcHeadCount', archived.length);
      $('#savedWsList').innerHTML =
        (active.length
          ? active.map(wsRow).join('')
          : `<div class="empty-state">Nothing open right now — everything you've saved has closed and
             is on the shelf below.</div>`) +
        note;
      // Local times, countdowns and the clock come from board.js, loaded on
      // this page for exactly that (its pager is a no-op here).
      (window as any).awtBoardHydrate?.($('#savedWsList'));
      paintArc(archived);
    }

    /* ---------------- papers ---------------- */
    // Saved-paper links are derived at render time so every snapshot
    // generation behaves identically: the title always opens OUR workshop
    // page anchored at that paper, and a separate PDF link opens the PDF.
    // PDF resolution: exact stored pdf_url (workshop-page saves; '' means
    // the paper has none) → else derive openreview.net/pdf?id=<forum id>,
    // suppressed for ids in /api/papers-without-pdf.json (search-result
    // saves and pre-June-2026 snapshots, which stored a `url` instead).
    let noPdfIds: Set<string> | null = null;
    let noPdfTried = false;
    async function ensureNoPdfList() {
      if (noPdfTried) return;
      noPdfTried = true;
      try {
        const res = await fetch(`${base}/api/papers-without-pdf.json`);
        if (res.ok) noPdfIds = new Set((await res.json()).ids);
      } catch {} // unreachable → derive optimistically (92% of papers have PDFs)
    }
    const isForumId = (id: string) => !!id && !id.includes('~'); // '~' marks slug-based fallback ids
    function paperLinks(p: any) {
      const titleHref = p.ws
        ? `${base}/workshop/${p.ws}/#p-${p.id}`
        : p.url || (isForumId(p.id) ? `https://openreview.net/forum?id=${p.id}` : '');
      let pdfHref = '';
      if ('pdf' in p) pdfHref = p.pdf || '';
      else if (isForumId(p.id) && !noPdfIds?.has(p.id)) pdfHref = `https://openreview.net/pdf?id=${p.id}`;
      return { titleHref, pdfHref };
    }

    async function renderPapers() {
      const papers = favPapers();
      setCount('#savedPaperCount', papers.length);
      if (papers.length === 0) {
        $('#savedPaperList').innerHTML =
          `<div class="empty-state">No saved papers yet — open any workshop's accepted-papers list and
           star <span class="star-demo">☆</span> the ones you want to read.</div>`;
        return;
      }
      if (papers.some((p: any) => !('pdf' in p) && isForumId(p.id))) await ensureNoPdfList();
      const wsBySlug = new Map(((await ensureWorkshops()) ?? []).map((w: any) => [w.slug, w]));
      const confByName = Object.fromEntries(Object.entries(CONF).map(([cid, c]: any) => [c.name, cid]));

      // Two levels: conference clusters in alphabetical order (CoRL before
      // IROS), each holding workshop groups sorted latest-year-first.
      // Conference + year come from the workshops API via the paper's ws
      // slug; if the slug is gone from the dataset, fall back to parsing
      // the "… — <Conf> <Year>" suffix the snapshot's wsName carries.
      const groups = new Map<string, any>(); // workshop slug -> group
      for (const p of papers) {
        const k = p.ws || p.wsName || 'other';
        if (!groups.has(k)) {
          const meta: any = wsBySlug.get(p.ws);
          const m = String(p.wsName || '').match(/—\s*([A-Za-z0-9 ]+?)\s+(\d{4})\s*$/);
          const confId = meta?.conference ?? (m ? confByName[m[1].trim()] : undefined);
          groups.set(k, {
            label: p.wsName || 'Other papers',
            ws: p.ws || '',
            confId: confId ?? '',
            confName: (confId && CONF[confId]?.name) || (m ? m[1].trim() : 'Other'),
            year: Number(meta?.year ?? (m ? m[2] : NaN)),
            items: [],
          });
        }
        const g = groups.get(k)!;
        g.items.push(p);
        if (p.wsName && p.wsName.length < g.label.length) g.label = p.wsName;
      }

      const clusters = new Map<string, any>(); // conference -> cluster
      for (const g of groups.values()) {
        const ck = g.confId || `~${g.confName}`;
        if (!clusters.has(ck)) clusters.set(ck, { confId: g.confId, name: g.confName, color: CONF[g.confId]?.color, groups: [] });
        clusters.get(ck)!.groups.push(g);
      }
      // A→Z by conference name; clusters for slugs that left the dataset
      // ("Other"/parsed names) sort after the known conferences.
      const sorted = [...clusters.values()].sort(
        (a, b) => (a.confId ? 0 : 1) - (b.confId ? 0 : 1) || a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }),
      );
      for (const c of sorted) {
        for (const g of c.groups) {
          const suffix = ` — ${c.name} ${g.year}`;
          g.short = g.label.endsWith(suffix) ? g.label.slice(0, -suffix.length) : g.label;
        }
        // Workshops inside a conference: latest year first (the saved-papers
        // ranking rule); the on-screen name (case-insensitive, number-aware)
        // breaks ties within the same year.
        c.groups.sort(
          (a: any, b: any) =>
            (Number.isFinite(b.year) ? b.year : -1) - (Number.isFinite(a.year) ? a.year : -1) ||
            a.short.localeCompare(b.short, undefined, { numeric: true, sensitivity: 'base' }),
        );
      }

      $('#savedPaperList').innerHTML = sorted
        .map(
          (c) => `
        <div class="saved-conf" data-conf="${esc(c.confId || c.name)}">
          <h3 class="saved-conf-head">${c.color ? `<span class="badge" style="--conf:${esc(c.color)}">${esc(c.name)}</span>` : esc(c.name)}</h3>
          ${c.groups
            .map((g: any) => {
              const short = g.short;
              return `
          <div class="saved-paper-group" data-year="${Number.isFinite(g.year) ? g.year : ''}">
            <h4>${Number.isFinite(g.year) ? `<span class="g-year mono">${g.year}</span>` : ''}${g.ws ? `<a href="${base}/workshop/${esc(g.ws)}/">${esc(short)}</a>` : esc(short)}</h4>
            <ul class="saved-papers">
              ${g.items
                .map(
                  (p: any) => {
                    const { titleHref, pdfHref } = paperLinks(p);
                    return `
                <li data-saved-paper="${esc(p.id)}">
                  <button class="star-btn" type="button" data-star-paper="${esc(p.id)}" aria-pressed="true" aria-label="Remove paper from saved">★</button>
                  ${titleHref ? `<a href="${esc(titleHref)}" title="Open on the workshop page">${esc(p.title)}</a>` : esc(p.title)}${pdfHref ? ` <span class="muted">·</span> <a class="pdf-link" href="${esc(pdfHref)}" target="_blank" rel="noopener">PDF</a>` : ''}
                </li>`;
                  },
                )
                .join('')}
            </ul>
          </div>`;
            })
            .join('')}
        </div>`,
        )
        .join('');
    }

    /* ---------------- removals (star toggled here or in another tab) ---------------- */
    document.addEventListener('awt:favs-changed', (e: any) => {
      const { type, id, on } = e.detail || {};
      if (type === 'sync') { renderWorkshops(); renderPapers(); return; }
      if (on) return; // additions can't happen on this page
      if (type === 'workshop') {
        const row = document.querySelector(`[data-saved-ws="${CSS.escape(id)}"]`);
        if (row) { row.remove(); activeCount--; }
        const n = favWorkshops().length;
        // Each heading counts its own half, so the total cannot go in the upcoming
        // heading any more: unstarring a shelf volume would otherwise decrement the
        // count above rows it did not touch. activeCount tracks the rows in
        // #savedWsList; the shelf is whatever is left.
        setCount('#savedWsCount', activeCount);
        setCount('#savedArcHeadCount', Math.max(0, n - activeCount));
        // A shelf volume is already gone by the time this fires — the component
        // removes it before calling back — so re-render only when the copy has
        // to change: the active half just emptied, or nothing is saved at all.
        // Anything more would reset the view and the search box under a reader
        // who is mid-browse on the shelf.
        if (n === 0 || (row && activeCount === 0)) renderWorkshops();
      } else if (type === 'paper') {
        const li = document.querySelector(`li[data-saved-paper="${CSS.escape(id)}"]`);
        const group = li?.closest('.saved-paper-group');
        const cluster = li?.closest('.saved-conf');
        li?.remove();
        if (group && !group.querySelector('li')) group.remove();
        if (cluster && !cluster.querySelector('li')) cluster.remove();
        const n = favPapers().length;
        $('#savedPaperCount').textContent = n ? `(${n})` : '';
        if (n === 0) renderPapers();
      }
    });

    /* ---------------- alerts sync banner ---------------- */
    // favorites.js does the actual hydrate (union-merge from /me) on load and
    // fires `awt:favs-changed {type:'sync'}` when it changes anything, which the
    // handler above already re-renders on. All this does is say which account
    // the list belongs to, and hide the signup box once it is redundant.
    // This page is also a landing page for sign-in links, so the session may
    // arrive a moment after first paint. State comes from the shared module —
    // /saved/ used to read the token itself, which is one more place that would
    // have had to change every time the rule did.
    (() => {
      const paint = () => {
        const s = (window as any).awtAlertsSession?.() || { linked: false };
        const line = document.getElementById('savedSyncLine');
        const who = document.getElementById('savedSyncEmail');
        if (line && who) {
          who.textContent = s.email || 'your subscription';
          line.hidden = !s.linked;
        }
        document.getElementById('savedAlerts')?.classList.toggle('is-linked', s.linked);
      };
      paint();
      document.addEventListener('awt:alerts-session', paint);
      Promise.resolve((window as any).awtAlertsAdopt).then(paint).catch(() => {});
    })();

    renderWorkshops();
    renderPapers();
  </script>

  <style>
    /* Signed in, so the signup block hides itself and the next heading's 2.2rem
       top margin (global.css) would sit straight under the masthead's own
       padding — ~3.6rem of nothing where the block used to be. Close it up. */
    #savedAlerts.is-linked { display: none; }
    #savedAlerts.is-linked + section h2 { margin-top: 0.9rem; }

    /* The archive is a subsection of Workshops, so it needs air above it but
       not the full section gap — that would read as a third top-level heading. */
    #savedArc { margin-top: 1.9rem; }
    /* Nothing to search and nothing to switch between until the shelf has
       volumes on it (the reader's own, or the demo). */
    #savedArc:not([data-filled]) .awt-arc__tools { display: none; }
    .saved-arc-try { margin: 0.7rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; }
    .saved-arc-try .small { flex: 1 1 18rem; }
    /* Which half of the hint applies is a property of the pointer, not the
       screen: a laptop in tablet mode and a desktop both answer hover.
       :global() because these two spans are written by the script below, so
       they never carry the data-astro-cid attribute Astro scopes styles with —
       without it the rules match nothing and BOTH sentences render, run
       together. The .saved-arc-try ancestor is server-rendered and keeps its
       scope, so this still cannot leak to another page. */
    .saved-arc-try :global(.hint-tap) { display: none; }
    @media (hover: none) {
      .saved-arc-try :global(.hint-hover) { display: none; }
      .saved-arc-try :global(.hint-tap) { display: inline; }
    }

    /* Book size. The slider writes --awt-scale to :root, which is where
       archive-shelf.css computes every geometry token — set on the shelf
       instead it would resolve to nothing there and kill the declarations. */
    .saved-arc-size { display: flex; align-items: center; gap: 0.4rem; }
    #savedArc[data-view='list'] .saved-arc-size { display: none; }
    .saved-arc-size input { width: 5.5rem; accent-color: var(--accent); cursor: pointer; }
    /* Below this width archive-shelf.css uses its own compact phone geometry,
       which --awt-scale deliberately does not touch — so the control would be
       a slider that does nothing. */
    @media (max-width: 640px) { .saved-arc-size { display: none; } }
  </style>
</Base>
