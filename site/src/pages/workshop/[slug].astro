---
import Base from '../../components/Base.astro';
import { workshops, conferenceById, editionByKey, topicById, loadPaperCache, workshopShortName, nameTokens, extensionStats, workshopBySlug, extensionInsight, extensionSentence } from '../../lib/data';
import { href, REPO_URL, CALENDAR_ENABLED } from '../../lib/site';
import MarkdownExport from '../../components/MarkdownExport.astro';
import { formatSingleWorkshopInfo, isAutoTopicsNote, isBotDeadlineNote } from '../../lib/markdown';
import { timezoneLabel } from '../../../../lib/dates.mjs';

export function getStaticPaths() {
  return workshops.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
const conf = conferenceById.get(w.conference) ?? { name: w.conference, color: '#888' };
const cache = loadPaperCache(w.slug);
const statusLabel = w.statusLabel;
// Structured, timezone-safe edit form (replaces the raw-YAML editor link). See
// the note in WorkshopRow.astro; advanced fields stay editable via raw YAML
// from the form's intro.
const editUrl = `${REPO_URL}/issues/new?template=edit-workshop.yml&slug=${encodeURIComponent(w.slug)}&website=${encodeURIComponent(w.website ?? '')}&title=${encodeURIComponent('Edit: ' + w.slug)}`;
const isSeed = (w.notes || '').includes('SEED DATA');
// "Will it get extended?" — what happened to this workshop's earlier editions
// or, until those carry history, to its neighbours this cycle. Null on most
// pages; see lib/extensions.mjs for the gates.
const insight = extensionInsight(w, extensionStats, (s: string) => workshopBySlug.get(s));
const insightSentence = insight ? extensionSentence(insight, { confName: conf.name }) : '';
// The time-zone explainer under the countdown. Every deadline is stored in
// UTC, and an "Anywhere on Earth" deadline lands at 11:59 UTC the next day —
// which is what most rows here read, and what first-time submitters find
// baffling. When this deadline is such an artefact the summary asks the
// question they have; otherwise it asks the general one.
const tzArtefact = w.timezone === 'UTC' && /\b(11:59|12:00) UTC$/.test(w.deadlineWallClock ?? '');
// Hand-written previous_editions rows are superseded by a tracked entry for
// the same year (an internal link beats an external one); years we don't
// track keep their external links.
const manualEditions = (w.previous_editions ?? []).filter(
  (p: any) => !(w.relatedEditions ?? []).some((e: any) => e.year === p.year),
);
const hasEditions = (w.relatedEditions?.length ?? 0) + manualEditions.length > 0;
const portalLabel: Record<string, string> = {
  openreview: 'OpenReview',
  cmt: 'CMT',
  email: 'Email',
  other: 'Other',
  unknown: 'Unknown',
};
// Stable per-paper id for device-local favorites: the OpenReview forum id
// when present (survives cache refreshes/reordering), else slug+index.
const paperId = (p: any, i: number) =>
  String(p.forum_url || p.pdf_url || '').match(/[?&]id=([^&#]+)/)?.[1] ?? `${w.slug}~${i}`;
// How a saved paper is labeled/grouped on the /saved/ page.
// Deduped and track-disambiguated: two tracks of one workshop would otherwise
// share a label and merge into a single group on /saved/.
const shortName = workshopShortName(w, conf.name);
const wsLabel = `${shortName.full} — ${conf.name} ${w.year}`;
// Browse-mode sort key (used only when the search box is empty — keyword
// queries keep Pagefind's relevance order). Lexicographic ascending over
// '<band>-<14-digit ms>':
//   0  open calls, by soonest deadline (most urgent first)
//   1  upcoming with no deadline yet, by soonest event
//   2  "Past": deadline has passed (both "closed, event still upcoming" and
//      fully over) — by most recently passed deadline first, so the workshop
//      whose deadline just passed sits at the top
//   3  "Past" with no deadline at all — by most recent event, truly undated last
// Bands 2 and 3 together are everything the UI labels "Past"; ordering by
// deadline descending is what the deadline-passed list is sorted on.
const searchOrder = (() => {
  const pad = (ms: number) => String(Math.max(0, Math.min(ms, 99999999999999))).padStart(14, '0');
  const MAX = 99999999999999;
  const ev = w.workshopDateUtcMs ?? w.deadlineUtcMs ?? MAX;
  if (w.status === 'upcoming' && w.deadlineUtcMs != null) return '0-' + pad(w.deadlineUtcMs);
  if (w.status === 'upcoming') return '1-' + pad(ev);
  if (w.deadlineUtcMs != null) return '2-' + pad(MAX - w.deadlineUtcMs);
  return '3-' + pad(MAX - (w.workshopDateUtcMs ?? 0));
})();

// What a search result knows about this workshop. The homepage renders result
// rows in the browser from this metadata, through the same client renderer
// the saved list uses (site/src/scripts/ws-row.js), so the names are the
// API's (/api/workshops.json). The same set rides on the papers document too:
// a keyword that matches only a paper still has to render a full row. Kept in
// step with WorkshopRow.astro by scripts/row_parity_test.mjs.
const pfFields: [string, string][] = [
  ['conference', conf.name],
  ['year', String(w.year)],
  ['status', statusLabel],
  ['deadline', w.deadlineWallClock ?? ''],
  ['state', w.status],
  ['acronym', w.acronym ?? ''],
  ['short_name', shortName.full],
  ['topics', JSON.stringify(w.topics ?? [])],
  ['deadline_utc', w.deadlineIso ?? ''],
  ['next_stage_utc', w.nextStageIso ?? ''],
  ['next_stage_is_abstract', w.nextStageIsAbstract ? '1' : ''],
  ['abstract_deadline_wall_clock', w.abstractDeadlineWallClock ?? ''],
  ['abstract_deadline_utc', w.abstractDeadlineIso ?? ''],
  // Only when the conference is split across places — the board's own rule.
  ['location_label', w.locationDistinguishes ? (w.locationLabel ?? '') : ''],
  ['deadline_change', w.deadlineChange
    ? JSON.stringify({ kind: w.deadlineChange.kind, days: w.deadlineChange.days, recorded: w.deadlineChange.recorded })
    : ''],
];
const pfAttrs = Object.fromEntries(pfFields.map(([k, v]) => [`data-pf-${k}`, v]));
const PF_META = pfFields.map(([k]) => `${k}[data-pf-${k}]`).join(', ');

// --- Structured data (JSON-LD), derived from the same resolved workshop
// fields this page already renders, so no new data and no validation/schema
// changes are needed. ---
const SITE = Astro.site;
const abs = (p: string) => (SITE ? new URL(href(p), SITE).href : href(p));
const pageUrl = SITE ? new URL(Astro.url.pathname, SITE).href : href(`/workshop/${w.slug}/`);
const confLabel = `${conf.name} ${w.year}`;
const confFull = (conf as any).full_name ? `${(conf as any).full_name} (${conf.name})` : conf.name;
const keywordList = (w.topics ?? []).map((t: string) => topicById.get(t)?.label ?? t);

// schema.org/Event has no native "submission deadline" field, so the deadline
// lives in the description (and prominently on-page). Google's Event rich
// result requires BOTH a `startDate` and a `location`, and it reports every
// Event that lacks either as an error — this page did, on all 938 workshops,
// because the markup was emitted regardless (and `superEvent` is itself an
// Event, so Semrush counted 1,876 invalid items). Invalid markup is ignored,
// not penalised, but it buries every real problem in the Search Console
// report, so the rule is now: emit the Event only when it can be complete.
//
//   startDate  the raw `workshop_date` (YYYY-MM-DD, schema-validated) — never
//              the derived fallbacks in workshops.mjs (conference end date,
//              typical month), which are not the event's official start.
//   location   `locationLabel`, the tidied per-workshop city from OpenReview,
//              exactly as the "Location" row on this page shows it. No
//              inference from sibling workshops: structured data must describe
//              what the page visibly says.
//
// Both are still sparse in the data, so today this is a handful of pages; each
// workshop gains the markup the moment its two facts are filled in, with no
// code change. The BreadcrumbList below is emitted for every page regardless.
const eventStart =
  typeof w.workshop_date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(w.workshop_date.trim())
    ? w.workshop_date.trim()
    : null;
const eventPlace = w.locationLabel
  ? { '@type': 'Place', name: w.locationLabel, address: w.locationLabel }
  : null;
const edition = editionByKey.get(`${w.conference}-${w.year}`);
const eventLd: Record<string, any> | null = eventStart && eventPlace
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      // Asserting a plain Event for an edition we know is not taking place
      // would be a false claim to every crawler that reads this. schema.org
      // has the exact vocabulary for it.
      ...(w.status === 'not_running' ? { eventStatus: 'https://schema.org/EventCancelled' } : {}),
      name: w.acronym ? `${w.name} (${w.acronym})` : w.name,
      url: pageUrl,
      description: [
        w.deadlineWallClock
          ? `Paper submission deadline: ${w.deadlineWallClock}.`
          : 'Paper submission deadline to be announced.',
        `A workshop at ${confFull} ${w.year}.`,
        w.paperCount > 0 ? `${w.paperCount} accepted papers listed.` : '',
      ].filter(Boolean).join(' '),
      startDate: eventStart,
      location: eventPlace,
      ...(w.website ? { sameAs: w.website } : {}),
      // The conference is a nested Event and gets validated like one, so it
      // carries its own dates (data/editions.yml) and — when the conference
      // sits in a single city, which `locationDistinguishes` being false means
      // — the same place. A split conference (NeurIPS 2026: Sydney, Paris,
      // Atlanta) gets no location rather than one third of the truth.
      superEvent: {
        '@type': 'Event',
        name: confLabel,
        ...((conf as any).full_name ? { alternateName: (conf as any).full_name } : {}),
        ...((conf as any).website ? { url: (conf as any).website } : {}),
        ...(edition?.start ? { startDate: String(edition.start) } : {}),
        ...(edition?.end ? { endDate: String(edition.end) } : {}),
        ...(!w.locationDistinguishes ? { location: eventPlace } : {}),
      },
      ...(Array.isArray(w.organizers) && w.organizers.length
        ? { organizer: w.organizers.map((n: string) => ({ '@type': 'Person', name: n })) }
        : {}),
      ...(keywordList.length ? { keywords: keywordList.join(', ') } : {}),
    }
  : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: `${conf.name} workshops`, item: abs(`/conference/${w.conference}/`) },
    { '@type': 'ListItem', position: 3, name: confLabel, item: abs(`/conference/${w.conference}/${w.year}/`) },
    { '@type': 'ListItem', position: 4, name: w.acronym || w.name },
  ],
};

// --- SEO title & meta description ---
// The query these pages should win is "<name> workshop <conf> <year> deadline"
// (and, for past editions, "... accepted papers"), so the <title> has to contain
// the words "Workshop" and "Deadline" — an acronym-only title has neither.
// `shortName` (above) supplies the identity: venue noise stripped, sibling
// tracks told apart. The track label sits after "Workshop" rather than inside
// the name, so the line reads "CVEU Workshop (Extended Abstracts) @ CVPR 2026".
const titleFor = (suffix: string, sayWorkshop: boolean) =>
  `${shortName.base}${sayWorkshop && !/workshop/i.test(shortName.base) ? ' Workshop' : ''}` +
  `${shortName.track ? ` (${shortName.track})` : ''}` +
  ` @ ${conf.name} ${w.year} — ${suffix}`;
// A result shows about 60 characters of a <title>; past that, what a searcher
// typed is what gets cut. So the full form is preferred and, when it runs
// long, "Papers &" goes first (the description still states the paper
// count), then the word "Workshop". The track label and the venue never go:
// they are what tell sibling pages apart.
const fullSuffix = w.paperCount > 0 ? 'Papers & Deadline' : 'Deadline';
const titleTxt =
  [titleFor(fullSuffix, true), titleFor('Deadline', true), titleFor('Deadline', false)].find((t) => t.length <= 60) ??
  titleFor('Deadline', false);
/** Word-boundary trim for the description's (highly variable) workshop name. */
const clip = (str: string, n: number) => {
  if (str.length <= n) return str;
  const sp = str.lastIndexOf(' ', n);
  return str
    .slice(0, sp > 20 ? sp : n)
    .replace(/[\s,:;-]+$/, '')
    .replace(/\s+(?:and|or|the|an?|of|for|to|in|on|with|using|from|towards?|at|by|via)$/i, '');
};
// The description carries the actual deadline date: Google bolds matched terms
// and surfaces dates in snippets, and the daily rebuild keeps it current when a
// deadline is extended.
// These pages rank for "<name> deadline", so a not-running edition leads with
// that fact: a snippet is often all a searcher reads, and the deadline below it
// is no longer live. The <title> is deliberately left alone (link stability);
// the pill and the notice carry it on the page itself.
// Sibling tracks of one workshop share a `name`, so without the track label
// three GenAI4Health pages published one identical description — Semrush's
// "duplicate meta description", and a searcher who can't tell the tracks apart.
// But most track entries already state the track in the name ("… (Paper
// Track)", "… - ARR Commitment"), and appending it again gave 44 pages a
// "(Paper Track) (Paper Track)" description. So the label is added only when
// the name — as clipped here, since clipping can be what removes it — does not
// already say it, compared with case and punctuation folded away.
const fold = (str: string) => String(str).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
// The topics are the words a searcher types ("robotics workshop neurips"), and
// an entry with a short name and no deadline yet otherwise publishes a
// 45-character description that says nothing ("DBM — NeurIPS 2025.
// Submission deadline: TBA."). The catch-all "Other" is not a topic.
const topicLabels: string[] = (w.topics ?? [])
  .filter((t: string) => t !== 'other')
  .map((t: string) => topicById.get(t)?.label ?? t);
const describe = (nameMax: number, { date = true, topics = true } = {}) => {
  const name = clip(String(w.name), nameMax);
  const track = shortName.track && !fold(name).includes(fold(shortName.track)) ? ` (${shortName.track})` : '';
  return [
    w.status === 'not_running' ? 'Not running —' : '',
    `${name}${track} — ${conf.name} ${w.year}.`,
    w.deadlineWallClock ? `Submission deadline: ${w.deadlineWallClock}.` : 'Submission deadline: TBA.',
    date && w.workshopDateLabel ? `Workshop date: ${w.workshopDateLabel}.` : '',
    w.paperCount > 0 ? `${w.paperCount} accepted papers listed.` : '',
    topics && topicLabels.length ? `Topics: ${topicLabels.join(', ')}.` : '',
  ]
    .filter(Boolean)
    .join(' ');
};
// Search results show roughly 160 characters. The first form that fits wins:
// the (highly variable) name is clipped first, then the topics go, then the
// workshop date — the deadline and the paper count, the parts a searcher is
// actually scanning for, are never the ones cut off.
const attempts = [
  describe(90), describe(70), describe(55),
  describe(90, { topics: false }), describe(70, { topics: false }), describe(55, { topics: false }),
  describe(55, { topics: false, date: false }),
];
const metaDesc = attempts.find((d) => d.length <= 160) ?? attempts[attempts.length - 1];

// --- Related workshops (internal links) ---
// Over half of all workshop pages had exactly one incoming link — the
// conference hub — and the pages Google had discovered but not crawled were
// overwhelmingly those. A page linked from one place looks like a leaf. So
// every workshop page links to a few of its neighbours, by one rule for the
// whole corpus, in two parts:
//
//   ring       the siblings on either side of this one in the hub's own order
//              (open calls first, then by next deadline, then name). Every page
//              in a conference-year of three or more is therefore linked from
//              at least two others — a guarantee, not a hope. Picking "the most
//              relevant" alone was tried first and left 217 pages still at one
//              link, because relevance keeps choosing the same popular few.
//   relevance  the rest of the six: the siblings sharing the most topics with
//              this one (the catch-all `other` does not count), ties broken by
//              words the two names share — "embodied", "reasoning"; stopwords
//              and the conference name excluded — then by hub order, so the
//              more urgent of two equally related workshops comes first.
//
// The list is SHOWN in relevance order, ring neighbours included: a reader of
// a robotics workshop sees the robotics workshops first, and the neighbour
// that is only there for the link guarantee last. Capped at six so it stays a
// footnote, not a second board. Tracks and other editions of this same
// workshop are already linked in their own sections and are left out.
// Deterministic: same input, same links, so the daily rebuild is stable.
const RELATED_MAX = 6;
const RING_EACH_SIDE = 1;
const already = new Set<string>([
  w.slug,
  ...(w.relatedTracks ?? []).map((t: any) => t.slug),
  ...(w.relatedEditions ?? []).map((e: any) => e.slug),
]);
const myTopics = new Set<string>((w.topics ?? []).filter((t: string) => t !== 'other'));
// A name's distinctive words, minus its track label's: "(Paper Track)" must
// not make "paper" a word two workshops share.
const wordsOf = (o: any) => {
  const out = nameTokens(o.name);
  for (const t of nameTokens(o.trackLabel ?? '')) out.delete(t);
  return out;
};
const myWords = wordsOf(w);
// The same comparator as conference/[conf].astro, so the neighbours named
// here are the neighbours a reader sees in the hub list: open calls, then
// deadline unknown, then closed; within a band by the next actionable date
// (abstract registration when that is sooner); then name.
const rank = (o: any) => (o.statusLabel === 'Open call' ? 0 : o.statusLabel === 'Deadline unknown' ? 1 : 2);
const byHubOrder = (a: any, b: any) =>
  rank(a) - rank(b) ||
  ((a.nextStageUtcMs ?? a.deadlineUtcMs) ?? Infinity) - ((b.nextStageUtcMs ?? b.deadlineUtcMs) ?? Infinity) ||
  (a.name || '').localeCompare(b.name || '') ||
  String(a.slug).localeCompare(String(b.slug));
const group = workshops
  .filter((o: any) => o.conference === w.conference && o.year === w.year && o.status !== 'not_running')
  .sort(byHubOrder);
const picked: any[] = [];
const take = (o: any) => {
  if (!o || already.has(o.slug) || picked.some((p) => p.slug === o.slug)) return;
  if (picked.length < RELATED_MAX) picked.push(o);
};
const me = group.findIndex((o: any) => o.slug === w.slug);
if (me >= 0 && group.length > 1) {
  for (let d = 1; d <= RING_EACH_SIDE; d++) {
    take(group[(me + d) % group.length]);
    take(group[(me - d + group.length) % group.length]);
  }
}
const sharedTopics = (o: any) => (o.topics ?? []).filter((t: string) => myTopics.has(t)).length;
const sharedWords = (o: any) => [...wordsOf(o)].filter((t: string) => myWords.has(t)).length;
const byRelevance = (a: any, b: any) =>
  sharedTopics(b) - sharedTopics(a) || sharedWords(b) - sharedWords(a) || byHubOrder(a, b);
// One row per workshop: once a track of some workshop is in, its sibling
// tracks add nothing a reader can act on that the first row's page does not
// already link. (The ring above is exempt — its links are the guarantee.)
const trackOfPicked = (o: any) => (o.relatedTracks ?? []).some((t: any) => picked.some((p) => p.slug === t.slug));
for (const o of [...group].sort(byRelevance)) {
  if (sharedTopics(o) === 0) break;
  if (!trackOfPicked(o)) take(o);
}
// A tiny conference-year, or one with no topic overlap: fill from the group.
if (picked.length < 3) for (const o of group) take(o);
picked.sort(byRelevance);

const related = picked.map((o: any) => ({
  slug: o.slug,
  label: workshopShortName(o, conf.name).full,
  name: o.name,
  open: o.status === 'upcoming',
  deadline: o.deadlineWallClock ?? null,
}));

---

<Base title={titleTxt} description={metaDesc} ogType="article" siteSuffix={false}>
  <Fragment slot="head">
    {eventLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(eventLd)} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <article>
   {/* Two rules keep the search index honest, both pinned corpus-wide by
       scripts/pagefind_index_test.mjs against the built fragments:
       1. Every inline sibling inside this root is separated by an explicit
          {' '}. Astro drops whitespace-only text between elements and
          Pagefind adds a word boundary only at block elements, so the badge,
          pill and chips ran together in the indexed text ("CVPR 2025PastAI
          for scienceMultimodal") and every <dt> label onto its <dd>
          ("LocationVienna, AustriaSubmission portal"). Pagefind's segmenter
          still found the words, but the excerpt under every result is cut
          from that text, so that is what readers saw — and nonsense prefixes
          such as "2026past" matched hundreds of pages.
       2. Chrome and machine-written text carry data-pagefind-ignore: the
          link row, the countdown placeholder, the importer's topics note and
          its deadline stamp. Repeated on every page, "markdown" or
          "imprecise" matched the whole corpus, most excerpts were chrome, and
          the words crowded ~60-word documents. Text a person wrote — a
          contributor's note — stays. */}
   <div
    data-pf-ws
    {...pfAttrs}
    data-conf={conf.name}
    data-year={String(w.year)}
    data-wstatus={statusLabel}
    data-type="Workshops"
    data-pagefind-meta={PF_META}
    data-pagefind-filter="conference[data-conf], year[data-year], status[data-wstatus], type[data-type]"
   >
    {/* Browse-order sort key: must live on a child — pagefind ignores
        data-pagefind-sort on the --root-selector element itself. */}
    <span data-pagefind-sort="order[data-order]" data-order={searchOrder} hidden></span>
    <header class="detail-head">
      <div class="topline">
        <span class="badge" style={`--conf:${conf.color}; padding: 0.28rem 0.7rem;`}>{conf.name} {w.year}</span>
        {' '}
        <span class={`pill ${w.status}`}>{statusLabel}</span>
        {(w.topics ?? []).map((t: string) => (
          <>
            {' '}
            <span class="chip" data-pagefind-filter="topic">{topicById.get(t)?.label ?? t}</span>
          </>
        ))}
      </div>
      <h1>{w.name}</h1>
      {w.acronym && <p class="muted mono">{w.acronym}</p>}
      <div class="linkrow" data-pagefind-ignore>
        <button
          class="star-btn star-btn-labeled"
          type="button"
          data-pagefind-ignore
          data-star-ws={w.slug}
          aria-pressed="false"
          aria-label={`Save ${w.name} to your list`}
          title="Save for later (stays in this browser)"
        >☆</button>
        {w.website ? (
          <a href={w.website} rel="noopener">Official website ↗</a>
        ) : (
          <a class="link-tba" href={editUrl} rel="noopener">Website unknown — help us add it</a>
        )}
        {w.openreview_venue_id && (
          <a href={`https://openreview.net/group?id=${w.openreview_venue_id}`} rel="noopener">OpenReview venue ↗</a>
        )}
        {/* The same affordance for a workshop that does not use OpenReview.
            Suppressed once the call has closed: a live "Submit" link on a
            passed deadline is worse than none. */}
        {w.submission_url && !w.openreview_venue_id && w.status === 'upcoming' && (
          <a href={w.submission_url} rel="noopener">Submit ↗</a>
        )}
        {w.proceedings_url && <a href={w.proceedings_url} rel="noopener">Accepted papers ↗</a>}
        {CALENDAR_ENABLED && w.deadlineUtcMs && <a href={href(`/feeds/ws-${w.slug}.ics`)}>Add deadline to calendar (.ics)</a>}
        <a href={href(`/conference/${w.conference}/`)}>See all {conf.name} workshops →</a>
        <a href={editUrl} rel="noopener">✎ Edit this entry</a>
        <MarkdownExport content={formatSingleWorkshopInfo(w, conf)} variant="link" />
      </div>
      {isSeed && (
        <p class="seednote" data-pagefind-ignore>
          <strong>Unverified seed entry.</strong> Some fields are estimates — confirm everything on the
          official website before planning a submission.
        </p>
      )}
      {w.notRunning && (
        <p class="notrunningnote">
          <strong>This workshop is not running.</strong> {w.notRunning.label} — recorded {w.notRunning.recorded}.
          {w.notRunning.source && (
            <> <a href={w.notRunning.source} rel="noopener">See the source ↗</a></>
          )}
          {w.notRunning.note && <> {w.notRunning.note}</>}
          {/* "No longer kept in sync", not "no longer live": for an independent event
              that left the conference (UniReps 2026, ML4PS 2026) the call IS live,
              and the note above says where — what stops is our tracking of it. */}
          {' '}Any deadline below is the last one we recorded and is <strong>no longer kept in sync</strong>.
          This page is kept because it may already have been saved or linked.
        </p>
      )}
    </header>

    <dl class="kv">
      <dt>{' '}Submission deadline{' '}</dt>
      <dd>
        {w.deadlineWallClock ? (
          <>
            <span class="mono">{w.deadlineWallClock}</span>
            <div class="muted small js-local" data-iso={w.deadlineIso}></div>
            {w.status === 'upcoming' && (
              <div>
                <span
                  class="countdown"
                  data-pagefind-ignore
                  data-deadline-ms={w.nextStageUtcMs ?? w.deadlineUtcMs}
                  data-stage={w.nextStageIsAbstract ? 'abstract' : null}
                >—</span>
              </div>
            )}
            {w.status === 'upcoming' && (
              <details class="tz-help small" data-pagefind-ignore data-slug={w.slug}>
                <summary>{tzArtefact ? 'Why 11:59 UTC?' : 'What time is that, exactly?'}</summary>
                {tzArtefact ? (
                  <p>
                    Deadlines here are shown in UTC. Many workshops announce theirs as “Anywhere on Earth”
                    (AoE, UTC−12): a date that ends AoE ends at 11:59 UTC the next morning, which is where
                    this 11:59 comes from. If it is still that date somewhere on Earth, you are on time.
                  </p>
                ) : (
                  <p>
                    Deadlines here are shown in {timezoneLabel(w.timezone ?? 'AoE')}, with your local time
                    above. Many workshops announce theirs as “Anywhere on Earth” (AoE, UTC−12), the ML
                    convention: a date-only deadline ends when that date ends everywhere, which is 11:59 UTC
                    the next morning.
                  </p>
                )}
                <p class="tz-now muted">
                  Right now: <span class="mono" data-live-clock="utc">—</span> UTC ·{' '}
                  <span class="mono" data-live-clock="aoe">—</span> AoE
                </p>
              </details>
            )}
            {w.deadlineChange && (
              <div class={`dl-callout dl-${w.deadlineChange.kind}`}>
                {w.deadlineChange.kind === 'extended' && (
                  <>
                    <strong>Extended by {w.deadlineChange.days} {w.deadlineChange.days === 1 ? 'day' : 'days'}.</strong>{' '}
                    Previously <span class="mono">{w.deadlineChange.fromWallClock}</span>.
                  </>
                )}
                {w.deadlineChange.kind === 'earlier' && (
                  <>
                    <strong>Moved {w.deadlineChange.days} {w.deadlineChange.days === 1 ? 'day' : 'days'} earlier.</strong>{' '}
                    Previously <span class="mono">{w.deadlineChange.fromWallClock}</span> — check before you plan around it.
                  </>
                )}
                {w.deadlineChange.kind === 'announced' && (
                  <><strong>First deadline posted.</strong> This workshop had no published date before now.</>
                )}
              </div>
            )}
            {w.deadlineHistoryView.length > 1 && (
              <details class="dl-history small">
                <summary>Deadline history ({w.deadlineHistoryView.length - 1} {w.deadlineHistoryView.length === 2 ? 'change' : 'changes'})</summary>
                <ul>
                  {w.deadlineHistoryView.map((h: any, i: number) => (
                    <li>
                      <span class="mono dl-h-when">{h.recordedLabel}</span>
                      {' '}
                      <span class="dl-h-val">{h.wallClock ?? 'no date published'}</span>
                      {' '}
                      <span class="muted dl-h-tag">
                        {i === w.deadlineHistoryView.length - 1 ? 'first recorded' : 'changed'}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="muted">
                  Dates are when this tracker recorded each value, not when the organizers changed it.
                </p>
              </details>
            )}
            {insight && (
              <p class="ext-insight small muted" data-pagefind-ignore data-insight={insight.kind}>
                {insightSentence}
              </p>
            )}
            {w.abstractDeadlineWallClock && (
              <div class="small" style="margin-top: 0.35rem">
                {w.abstractDeadlinePassed ? (
                  <span class="muted">
                    Abstract registration closed <span class="mono">{w.abstractDeadlineWallClock}</span> — the full paper deadline above is unchanged, not an extension.
                  </span>
                ) : (
                  <span style="color: var(--warn)">
                    Abstract registration required by <span class="mono">{w.abstractDeadlineWallClock}</span> — you must register an abstract before this to submit the full paper above.
                  </span>
                )}
                <div class="muted small js-local" data-iso={w.abstractDeadlineIso}></div>
              </div>
            )}
            {w.deadline_notes && (
              <div class="small" style="color: var(--warn)" data-pagefind-ignore={isBotDeadlineNote(w.deadline_notes) || undefined}>{w.deadline_notes}</div>
            )}
          </>
        ) : (
          <>
            TBA — <a class="link-tba" href={editUrl} rel="noopener" data-pagefind-ignore>know
            the deadline? Help add it</a>
            <div class="muted small" data-pagefind-ignore>Opens a short form — enter the date and pick its timezone, and we'll handle the conversion.</div>
          </>
        )}
      </dd>
      {Array.isArray(w.tracks) && w.tracks.length > 0 && (
        <>
          <dt>{' '}Tracks{' '}</dt>
          <dd>
            <ul class="tracks-list">
              {w.tracks.map((t) => (
                <li>
                  <span class="track-name">{t.name}</span>
                  {' '}
                  {t.deadlineWallClock ? (
                    <span class={t.passed ? 'muted' : ''}>
                      <span class="mono">{t.deadlineWallClock}</span>{t.passed ? ' · closed' : ''}
                    </span>
                  ) : (
                    <span class="muted">deadline not yet announced</span>
                  )}
                </li>
              ))}
            </ul>
            <div class="muted small">Each track has its own deadline; the headline above shows the soonest one still open.</div>
          </dd>
        </>
      )}
      {w.notification_date && (
        <>
          <dt>{' '}Notification{' '}</dt>
          <dd>{w.notificationDateLabel}</dd>
        </>
      )}
      {w.workshop_date && (
        <>
          <dt>{' '}Workshop day{' '}</dt>
          <dd>{w.workshopDateLabel}</dd>
        </>
      )}
      {/* From OpenReview. `locationLabel` is the tidied spelling, not the raw
          value: one city is published under as many as six names, so the
          spellings are folded together in lib/workshops.mjs. Shown whenever it
          is known — someone who opened this page wants the detail. */}
      {w.locationLabel && (
        <>
          <dt>{' '}Location{' '}</dt>
          <dd>{w.locationLabel}</dd>
        </>
      )}
      {w.submission_portal && (
        <>
          <dt>{' '}Submission portal{' '}</dt>
          <dd>
            {/* Name the portal, and link it when we know where. An OpenReview
                venue already produces its own link in the header above, so this
                carries the everything-else case — CMT, a Google Form — which
                otherwise rendered as the bare word "CMT" with nothing to click. */}
            {w.submission_url ? (
              <a href={w.submission_url} rel="noopener">
                {portalLabel[w.submission_portal] ?? w.submission_portal} ↗
              </a>
            ) : (
              portalLabel[w.submission_portal] ?? w.submission_portal
            )}
          </dd>
        </>
      )}
      {w.organizers?.length > 0 && (
        <>
          <dt>{' '}Organizers{' '}</dt>
          <dd>{w.organizers.join(', ')}</dd>
        </>
      )}
      {w.notes && (
        <>
          <dt>{' '}Notes{' '}</dt>
          {/* The importer's "topics were auto-suggested" note sits on nearly
              every entry; a person's note is the exception and stays indexed. */}
          <dd class="muted" data-pagefind-ignore={isAutoTopicsNote(w.notes) || undefined}>{w.notes}</dd>
        </>
      )}
    </dl>

    {w.relatedTracks?.length > 0 && (
      <section>
        <h2>Other tracks at {conf.name} {w.year}</h2>
        <ul class="tracks-list">
          {w.relatedTracks.map((t: any) => (
            <li>
              <span class="track-name"><a href={href(`/workshop/${t.slug}/`)} title={t.name}>{t.trackLabel}</a></span>
              {' '}
              {t.deadlineWallClock ? (
                <span class={t.passed ? 'muted' : ''}>
                  <span class="mono">{t.deadlineWallClock}</span>{t.passed ? ' · closed' : ''}
                </span>
              ) : (
                <span class="muted">deadline not yet announced</span>
              )}
            </li>
          ))}
        </ul>
        <div class="muted small">Same workshop, separate calls — each track is listed as its own entry with its own deadline.</div>
      </section>
    )}

    {hasEditions && (
      <section>
        <h2>Other editions</h2>
        <ul>
          {(w.relatedEditions ?? []).map((e: any) => (
            <li>
              <a href={href(`/workshop/${e.slug}/`)} title={e.name}>
                {conferenceById.get(e.conference)?.name ?? e.conference} {e.year}
              </a>
              {e.trackLabel && <span class="muted"> — {e.trackLabel}</span>}
            </li>
          ))}
          {manualEditions.map((p: any) => (
            <li>
              {p.year} — {p.website && <a href={p.website} rel="noopener">website ↗</a>}{' '}
              {p.proceedings_url && <a href={p.proceedings_url} rel="noopener">papers ↗</a>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Ignored by Pagefind: these are other workshops' names, and indexing
        them here would make a search for "GenBio" return every page that
        merely lists GenBio as a neighbour. */}
    {related.length > 0 && (
      <section data-pagefind-ignore>
        <h2>More {conf.name} {w.year} workshops</h2>
        {/* Four columns shared by every row — label, name, deadline, state —
            so the names start on one edge and the dates end on one, whatever
            the label's width. A flex row per item left every column ragged. */}
        <ul class="related-list">
          {related.map((r) => (
            <li>
              <span class="related-label"><a href={href(`/workshop/${r.slug}/`)}>{r.label}</a></span>
              <span class="related-name">{r.name}</span>
              <span class={`related-when mono${r.open ? '' : ' muted'}`}>{r.deadline ?? 'TBA'}</span>
              <span class="related-state muted small">{r.deadline && !r.open ? 'closed' : ''}</span>
            </li>
          ))}
        </ul>
        <div class="muted small">
          <a href={href(`/conference/${w.conference}/${w.year}/`)}>All {conf.name} {w.year} workshops →</a>
        </div>
      </section>
    )}

   </div>
    {cache && cache.papers?.length > 0 && (
      <section
        data-pf-papers
        {...pfAttrs}
        data-conf={conf.name}
        data-year={String(w.year)}
        data-wstatus={statusLabel}
        data-type="Papers"
        data-ptitle={`${w.name} — accepted papers`}
        data-pagefind-meta={`title[data-ptitle], ${PF_META}`}
        data-pagefind-filter="conference[data-conf], year[data-year], status[data-wstatus], type[data-type]"
      >
        {/* The Topic facet must see this document too, or selecting a topic
            silently drops every paper hit from the results. Attribute-sourced
            on empty elements so the label is a filter value and never indexed
            text: as content, the keyword "robotics" would match every papers
            document of a Robotics-tagged workshop and each would render a
            spurious "Matching papers →" link with no paper behind it. */}
        {(w.topics ?? []).map((t: string) => (
          <span data-pagefind-filter="topic[data-topic]" data-topic={topicById.get(t)?.label ?? t} hidden></span>
        ))}
        {/* Only paper titles and authors are content here; the heading, the
            provenance line and the per-paper "· PDF" are ignored so "accepted",
            "fetched" and "pdf" do not match every papers document. */}
        <h2 id="papers" data-pagefind-ignore>Accepted papers ({cache.paper_count})</h2>
        <p class="muted small" data-pagefind-ignore>
          Fetched from OpenReview ({cache.source_api}) on {cache.fetched_at?.slice(0, 10)}.
          {cache.caveat && ` Note: ${cache.caveat}.`}
        </p>
        {/* The star is a sibling of the title, not a child of it: .paper is a
            two-column grid, and keeping the button in its own column is what lets
            the authors and the abstract start at the title's edge instead of
            under the star. It also keeps a control out of a heading, which is
            where it never belonged. */}
        <ol class="paper-list">
          {cache.papers.map((p: any, i: number) => (
            <li class="paper">
              <button
                class="star-btn"
                type="button"
                data-pagefind-ignore
                data-star-paper={paperId(p, i)}
                data-title={p.title}
                data-pdf={p.pdf_url || ''}
                data-ws={w.slug}
                data-wsname={wsLabel}
                aria-pressed="false"
                aria-label={`Save paper: ${p.title}`}
                title="Save for later (stays in this browser)"
              >☆</button>
              <h3 class="p-title" id={`p-${paperId(p, i)}`}>
                {p.forum_url ? <a href={p.forum_url} rel="noopener">{p.title}</a> : p.title}
              </h3>
              <div class="p-authors">
                {(p.authors ?? []).join(', ')}
                {p.pdf_url && (
                  <span data-pagefind-ignore>
                    {' · '}
                    <a href={p.pdf_url} rel="noopener">PDF</a>
                  </span>
                )}
              </div>
              {p.abstract && (
                <details>
                  <summary data-pagefind-ignore>Abstract</summary>
                  <p>{p.abstract}</p>
                </details>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
    {(!cache || !(cache.papers?.length > 0)) && w.openreview_venue_id && (
      <section>
        <h2>Accepted papers</h2>
        <p class="muted">
          Not cached yet — <a href={`https://openreview.net/group?id=${w.openreview_venue_id}`} rel="noopener">browse them on OpenReview ↗</a>.
        </p>
      </section>
    )}
  </article>

  <script src="../../scripts/board.js"></script>
  <script src="../../scripts/workshop-page.js"></script>
</Base>
