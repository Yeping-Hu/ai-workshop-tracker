---
import Base from '../../components/Base.astro';
import { workshops, conferenceById, topicById, loadPaperCache } from '../../lib/data';
import { href, REPO_URL, CALENDAR_ENABLED } from '../../lib/site';

export function getStaticPaths() {
  return workshops.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
const conf = conferenceById.get(w.conference) ?? { name: w.conference, color: '#888' };
const cache = loadPaperCache(w.slug);
const statusLabel = w.statusLabel;
// Structured, timezone-safe edit form (replaces the raw-YAML editor link). See
// the note in WorkshopRow.astro; advanced fields stay editable via raw YAML
// from the form's intro.
const editUrl = `${REPO_URL}/issues/new?template=edit-workshop.yml&slug=${encodeURIComponent(w.slug)}&website=${encodeURIComponent(w.website ?? '')}&title=${encodeURIComponent('Edit: ' + w.slug)}`;
const isSeed = (w.notes || '').includes('SEED DATA');
const portalLabel: Record<string, string> = {
  openreview: 'OpenReview',
  cmt: 'CMT',
  email: 'Email',
  other: 'Other',
  unknown: 'Unknown',
};
// Stable per-paper id for device-local favorites: the OpenReview forum id
// when present (survives cache refreshes/reordering), else slug+index.
const paperId = (p: any, i: number) =>
  String(p.forum_url || p.pdf_url || '').match(/[?&]id=([^&#]+)/)?.[1] ?? `${w.slug}~${i}`;
// How a saved paper is labeled/grouped on the /saved/ page.
const wsLabel = `${w.acronym || w.name} — ${conf.name} ${w.year}`;
// Browse-mode sort key (used only when the search box is empty — keyword
// queries keep Pagefind's relevance order). Lexicographic ascending over
// '<band>-<14-digit ms>':
//   0  open calls, by soonest deadline (most urgent first)
//   1  upcoming with no deadline yet, by soonest event
//   2  "Past": deadline has passed (both "closed, event still upcoming" and
//      fully over) — by most recently passed deadline first, so the workshop
//      whose deadline just passed sits at the top
//   3  "Past" with no deadline at all — by most recent event, truly undated last
// Bands 2 and 3 together are everything the UI labels "Past"; ordering by
// deadline descending is what the deadline-passed list is sorted on.
const searchOrder = (() => {
  const pad = (ms: number) => String(Math.max(0, Math.min(ms, 99999999999999))).padStart(14, '0');
  const MAX = 99999999999999;
  const ev = w.workshopDateUtcMs ?? w.deadlineUtcMs ?? MAX;
  if (w.status === 'upcoming' && w.deadlineUtcMs != null) return '0-' + pad(w.deadlineUtcMs);
  if (w.status === 'upcoming') return '1-' + pad(ev);
  if (w.deadlineUtcMs != null) return '2-' + pad(MAX - w.deadlineUtcMs);
  return '3-' + pad(MAX - (w.workshopDateUtcMs ?? 0));
})();

// --- Structured data (JSON-LD), derived from the same resolved workshop
// fields this page already renders, so no new data and no validation/schema
// changes are needed. ---
const SITE = Astro.site;
const abs = (p: string) => (SITE ? new URL(href(p), SITE).href : href(p));
const pageUrl = SITE ? new URL(Astro.url.pathname, SITE).href : href(`/workshop/${w.slug}/`);
const confLabel = `${conf.name} ${w.year}`;
const confFull = (conf as any).full_name ? `${(conf as any).full_name} (${conf.name})` : conf.name;
const keywordList = (w.topics ?? []).map((t: string) => topicById.get(t)?.label ?? t);

// schema.org/Event has no native "submission deadline" field, so the deadline
// lives in the description (and prominently on-page, where AI search weights it
// most). Venue isn't in the dataset, so `location` is omitted: the markup stays
// valid and useful for AI extraction, though Google "Event" rich-result
// eligibility specifically wants both a location and a startDate.
const eventLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: w.acronym ? `${w.name} (${w.acronym})` : w.name,
  url: pageUrl,
  description: [
    w.deadlineWallClock
      ? `Paper submission deadline: ${w.deadlineWallClock}.`
      : 'Paper submission deadline to be announced.',
    `A workshop at ${confFull} ${w.year}.`,
    w.paperCount > 0 ? `${w.paperCount} accepted papers listed.` : '',
  ].filter(Boolean).join(' '),
  ...(w.workshopDateLabel ? { startDate: w.workshopDateLabel } : {}),
  ...(w.website ? { sameAs: w.website } : {}),
  superEvent: {
    '@type': 'Event',
    name: confLabel,
    ...((conf as any).full_name ? { alternateName: (conf as any).full_name } : {}),
    ...((conf as any).website ? { url: (conf as any).website } : {}),
  },
  ...(Array.isArray(w.organizers) && w.organizers.length
    ? { organizer: w.organizers.map((n: string) => ({ '@type': 'Person', name: n })) }
    : {}),
  ...(keywordList.length ? { keywords: keywordList.join(', ') } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: `${confLabel} workshops`, item: abs(`/conference/${w.conference}/`) },
    { '@type': 'ListItem', position: 3, name: w.acronym || w.name },
  ],
};

---

<Base title={`${w.acronym || w.name} (${conf.name} ${w.year})`} description={`${w.name} — ${conf.name} ${w.year}: deadline, dates, and accepted papers.`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <article>
   <div
    data-pf-ws
    data-conf={conf.name}
    data-year={String(w.year)}
    data-wstatus={statusLabel}
    data-type="Workshops"
    data-dl={w.deadlineWallClock ?? ''}
    data-pagefind-meta="conference[data-conf], year[data-year], status[data-wstatus], deadline[data-dl]"
    data-pagefind-filter="conference[data-conf], year[data-year], status[data-wstatus], type[data-type]"
   >
    {/* Browse-order sort key: must live on a child — pagefind ignores
        data-pagefind-sort on the --root-selector element itself. */}
    <span data-pagefind-sort="order[data-order]" data-order={searchOrder} hidden></span>
    <header class="detail-head">
      <div class="topline">
        <span class="badge" style={`--conf:${conf.color}; padding: 0.28rem 0.7rem;`}>{conf.name} {w.year}</span>
        <span class={`pill ${w.status}`}>{statusLabel}</span>
        {(w.topics ?? []).map((t: string) => <span class="chip" data-pagefind-filter="topic">{topicById.get(t)?.label ?? t}</span>)}
      </div>
      <h1>{w.name}</h1>
      {w.acronym && <p class="muted mono">{w.acronym}</p>}
      <div class="linkrow">
        <button
          class="star-btn star-btn-labeled"
          type="button"
          data-pagefind-ignore
          data-star-ws={w.slug}
          aria-pressed="false"
          aria-label={`Save ${w.name} to your list`}
          title="Save for later (stays in this browser)"
        >☆</button>
        {w.website ? (
          <a href={w.website} rel="noopener">Official website ↗</a>
        ) : (
          <a class="link-tba" href={editUrl} rel="noopener">Website unknown — help us add it</a>
        )}
        {w.openreview_venue_id && (
          <a href={`https://openreview.net/group?id=${w.openreview_venue_id}`} rel="noopener">OpenReview venue ↗</a>
        )}
        {w.proceedings_url && <a href={w.proceedings_url} rel="noopener">Accepted papers ↗</a>}
        {CALENDAR_ENABLED && w.deadlineUtcMs && <a href={href(`/feeds/ws-${w.slug}.ics`)}>Add deadline to calendar (.ics)</a>}
        <a href={href(`/conference/${w.conference}/`)}>See all {conf.name} workshops →</a>
        <a href={editUrl} rel="noopener">✎ Edit this entry</a>
      </div>
      {isSeed && (
        <p class="seednote">
          <strong>Unverified seed entry.</strong> Some fields are estimates — confirm everything on the
          official website before planning a submission.
        </p>
      )}
    </header>

    <dl class="kv">
      <dt>Submission deadline</dt>
      <dd>
        {w.deadlineWallClock ? (
          <>
            <span class="mono">{w.deadlineWallClock}</span>
            <div class="muted small js-local" data-iso={w.deadlineIso}></div>
            {w.status === 'upcoming' && (
              <div>
                <span
                  class="countdown"
                  data-deadline-ms={w.nextStageUtcMs ?? w.deadlineUtcMs}
                  data-stage={w.nextStageIsAbstract ? 'abstract' : null}
                  data-name={w.nextStageIsAbstract ? `${w.acronym || w.name} (abstract)` : (w.acronym || w.name)}
                >—</span>
              </div>
            )}
            {w.deadlineChange && (
              <div class={`dl-callout dl-${w.deadlineChange.kind}`}>
                {w.deadlineChange.kind === 'extended' && (
                  <>
                    <strong>Extended by {w.deadlineChange.days} {w.deadlineChange.days === 1 ? 'day' : 'days'}.</strong>{' '}
                    Previously <span class="mono">{w.deadlineChange.fromWallClock}</span>.
                  </>
                )}
                {w.deadlineChange.kind === 'earlier' && (
                  <>
                    <strong>Moved {w.deadlineChange.days} {w.deadlineChange.days === 1 ? 'day' : 'days'} earlier.</strong>{' '}
                    Previously <span class="mono">{w.deadlineChange.fromWallClock}</span> — check before you plan around it.
                  </>
                )}
                {w.deadlineChange.kind === 'announced' && (
                  <><strong>Deadline just announced.</strong> This workshop had no published date before now.</>
                )}
              </div>
            )}
            {w.deadlineHistoryView.length > 1 && (
              <details class="dl-history small">
                <summary>Deadline history ({w.deadlineHistoryView.length - 1} {w.deadlineHistoryView.length === 2 ? 'change' : 'changes'})</summary>
                <ul>
                  {w.deadlineHistoryView.map((h: any, i: number) => (
                    <li>
                      <span class="mono dl-h-when">{h.recordedLabel}</span>
                      <span class="dl-h-val">{h.wallClock ?? 'no date published'}</span>
                      <span class="muted dl-h-tag">
                        {i === w.deadlineHistoryView.length - 1 ? 'first recorded' : 'changed'}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="muted">
                  Dates are when this tracker recorded each value, not when the organizers changed it.
                </p>
              </details>
            )}
            {w.abstractDeadlineWallClock && (
              <div class="small" style="margin-top: 0.35rem">
                {w.abstractDeadlinePassed ? (
                  <span class="muted">
                    Abstract registration closed <span class="mono">{w.abstractDeadlineWallClock}</span> — the full paper deadline above is unchanged, not an extension.
                  </span>
                ) : (
                  <span style="color: var(--warn)">
                    Abstract registration required by <span class="mono">{w.abstractDeadlineWallClock}</span> — you must register an abstract before this to submit the full paper above.
                  </span>
                )}
                <div class="muted small js-local" data-iso={w.abstractDeadlineIso}></div>
              </div>
            )}
            {w.deadline_notes && <div class="small" style="color: var(--warn)">{w.deadline_notes}</div>}
          </>
        ) : (
          <>
            TBA — <a class="link-tba" href={editUrl} rel="noopener">know
            the deadline? Help add it</a>
            <div class="muted small">Opens a short form — enter the date and pick its timezone, and we'll handle the conversion.</div>
          </>
        )}
      </dd>
      {Array.isArray(w.tracks) && w.tracks.length > 0 && (
        <>
          <dt>Tracks</dt>
          <dd>
            <ul class="tracks-list">
              {w.tracks.map((t) => (
                <li>
                  <span class="track-name">{t.name}</span>
                  {t.deadlineWallClock ? (
                    <span class={t.passed ? 'muted' : ''}>
                      <span class="mono">{t.deadlineWallClock}</span>{t.passed ? ' · closed' : ''}
                    </span>
                  ) : (
                    <span class="muted">deadline not yet announced</span>
                  )}
                </li>
              ))}
            </ul>
            <div class="muted small">Each track has its own deadline; the headline above shows the soonest one still open.</div>
          </dd>
        </>
      )}
      {w.notification_date && (
        <>
          <dt>Notification</dt>
          <dd>{w.notificationDateLabel}</dd>
        </>
      )}
      {w.workshop_date && (
        <>
          <dt>Workshop day</dt>
          <dd>{w.workshopDateLabel}</dd>
        </>
      )}
      {w.submission_portal && (
        <>
          <dt>Submission portal</dt>
          <dd>{portalLabel[w.submission_portal] ?? w.submission_portal}</dd>
        </>
      )}
      {w.organizers?.length > 0 && (
        <>
          <dt>Organizers</dt>
          <dd>{w.organizers.join(', ')}</dd>
        </>
      )}
      {w.notes && (
        <>
          <dt>Notes</dt>
          <dd class="muted">{w.notes}</dd>
        </>
      )}
    </dl>

    {w.previous_editions?.length > 0 && (
      <section>
        <h2>Previous editions</h2>
        <ul>
          {w.previous_editions.map((p: any) => (
            <li>
              {p.year} — {p.website && <a href={p.website} rel="noopener">website ↗</a>}{' '}
              {p.proceedings_url && <a href={p.proceedings_url} rel="noopener">papers ↗</a>}
            </li>
          ))}
        </ul>
      </section>
    )}

   </div>
    {cache && cache.papers?.length > 0 && (
      <section
        data-pf-papers
        data-conf={conf.name}
        data-year={String(w.year)}
        data-wstatus={statusLabel}
        data-type="Papers"
        data-ptitle={`${w.name} — accepted papers`}
        data-pagefind-meta="title[data-ptitle], conference[data-conf], year[data-year], status[data-wstatus]"
        data-pagefind-filter="conference[data-conf], year[data-year], status[data-wstatus], type[data-type]"
      >
        <h2 id="papers">Accepted papers ({cache.paper_count})</h2>
        <p class="muted small">
          Fetched from OpenReview ({cache.source_api}) on {cache.fetched_at?.slice(0, 10)}.
          {cache.caveat && ` Note: ${cache.caveat}.`}
        </p>
        <ol class="paper-list">
          {cache.papers.map((p: any, i: number) => (
            <li class="paper">
              <h3 class="p-title" id={`p-${paperId(p, i)}`}>
                <button
                  class="star-btn"
                  type="button"
                  data-pagefind-ignore
                  data-star-paper={paperId(p, i)}
                  data-title={p.title}
                  data-pdf={p.pdf_url || ''}
                  data-ws={w.slug}
                  data-wsname={wsLabel}
                  aria-pressed="false"
                  aria-label={`Save paper: ${p.title}`}
                  title="Save for later (stays in this browser)"
                >☆</button>
                {p.forum_url ? <a href={p.forum_url} rel="noopener">{p.title}</a> : p.title}
              </h3>
              <div class="p-authors">
                {(p.authors ?? []).join(', ')}
                {p.pdf_url && (
                  <>
                    {' · '}
                    <a href={p.pdf_url} rel="noopener">PDF</a>
                  </>
                )}
              </div>
              {p.abstract && (
                <details>
                  <summary>Abstract</summary>
                  <p>{p.abstract}</p>
                </details>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
    {(!cache || !(cache.papers?.length > 0)) && w.openreview_venue_id && (
      <section>
        <h2>Accepted papers</h2>
        <p class="muted">
          Not cached yet — <a href={`https://openreview.net/group?id=${w.openreview_venue_id}`} rel="noopener">browse them on OpenReview ↗</a>.
        </p>
      </section>
    )}
  </article>

  <script src="../../scripts/board.js"></script>
</Base>
