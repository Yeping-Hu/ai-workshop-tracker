---
import Base from '../../components/Base.astro';
import { workshops, conferences } from '../../lib/data';
import { href, REPO_URL } from '../../lib/site';

// One hub page per conference, generated from the same data the rest of the
// site uses. Intentionally carries NO data-pf-ws / data-pf-papers attributes,
// so these pages stay out of the workshop/paper search index (they're
// navigation/overview, not search results). They join the sitemap
// automatically via @astrojs/sitemap.
export function getStaticPaths() {
  // status order for listings: open call -> unknown -> past
  const rank = (w: any) =>
    w.statusLabel === 'Open call' ? 0 : w.statusLabel === 'Deadline unknown' ? 1 : 2;
  return conferences.map((c: any) => {
    const list = workshops
      .filter((w: any) => w.conference === c.id)
      .sort(
        (a: any, b: any) =>
          b.year - a.year ||
          rank(a) - rank(b) ||
          // Order by the NEXT actionable date, so a two-stage workshop whose
          // abstract registration closes sooner is listed where a reader would
          // expect it (same ordering rule as the board).
          ((a.nextStageUtcMs ?? a.deadlineUtcMs) ?? Infinity) -
            ((b.nextStageUtcMs ?? b.deadlineUtcMs) ?? Infinity) ||
          (a.name || '').localeCompare(b.name || ''),
      );
    return { params: { conf: c.id }, props: { conf: c, list } };
  });
}

const { conf, list } = Astro.props as { conf: any; list: any[] };
const confName: string = conf.name;
const confFull: string = conf.full_name || conf.name;

const years = list.map((w) => w.year).filter((y) => typeof y === 'number');
const yearMin = years.length ? Math.min(...years) : null;
const yearMax = years.length ? Math.max(...years) : null;
const openCalls = list.filter((w) => w.statusLabel === 'Open call');
const nextOpen =
  [...openCalls]
    .filter((w) => w.deadlineUtcMs != null)
    .sort((a, b) => a.deadlineUtcMs - b.deadlineUtcMs)[0] ?? null;
const paperTotal = list.reduce((n, w) => n + (w.paperCount ?? 0), 0);

const byYear = new Map<number, any[]>();
for (const w of list) {
  if (!byYear.has(w.year)) byYear.set(w.year, []);
  byYear.get(w.year)!.push(w);
}
const yearGroups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const SITE = Astro.site;
const abs = (p: string) => (SITE ? new URL(href(p), SITE).href : href(p));
const pageUrl = SITE ? new URL(Astro.url.pathname, SITE).href : href(`/conference/${conf.id}/`);

const span =
  yearMin && yearMax ? (yearMin === yearMax ? ` from ${yearMin}` : ` from ${yearMin} to ${yearMax}`) : '';
const intro =
  `This page tracks ${list.length} ${confName} workshop edition${list.length === 1 ? '' : 's'}${span}, ` +
  `with ${paperTotal.toLocaleString('en-US')} accepted papers. ` +
  (openCalls.length
    ? `${openCalls.length} ${confName} workshop${openCalls.length === 1 ? ' has' : 's have'} an open call for papers right now` +
      (nextOpen ? `; the next deadline is ${nextOpen.deadlineWallClock}.` : '.')
    : `There are no open ${confName} workshop calls right now — new cycles are imported automatically as they're announced.`);

// FAQ rendered visibly below AND mirrored as FAQPage JSON-LD (Google requires
// the answer text to be present on the page). Answers are data-driven.
const faqs = [
  {
    q: `When are ${confName} workshop paper submission deadlines?`,
    a: openCalls.length
      ? `Deadlines vary by workshop. ${openCalls.length} ${confName} workshop${openCalls.length === 1 ? ' has' : 's have'} an open call right now` +
        (nextOpen ? `, the soonest closing on ${nextOpen.deadlineWallClock}. ` : '. ') +
        `The full list, each with its own deadline, is below.`
      : `There are no open ${confName} workshop calls at the moment. Upcoming deadlines are added automatically as workshops announce them; past editions and their deadlines are listed below.`,
  },
  {
    q: `How many ${confName} workshops are tracked here?`,
    a:
      `${list.length} ${confName} workshop edition${list.length === 1 ? '' : 's'}` +
      (yearMin && yearMax && yearMin !== yearMax ? ` spanning ${yearMin}–${yearMax}` : '') +
      `, together listing ${paperTotal.toLocaleString('en-US')} accepted papers.`,
  },
  {
    q: `Where can I find accepted papers from ${confName} workshops?`,
    a: `Each workshop's page lists its accepted papers, sourced from OpenReview where available. Across ${confName} workshops, ${paperTotal.toLocaleString('en-US')} papers are currently listed and searchable.`,
  },
  {
    q: `Are these ${confName} workshop deadlines official?`,
    a: `These deadlines are drawn from each workshop's official call for papers and its OpenReview page where available, so they're generally reliable — but the data is community-maintained, and a workshop may update its own page without updating OpenReview. Always confirm the exact deadline on the official workshop page before submitting.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: `${confName} workshops`, item: pageUrl },
  ],
};

const statusPill = (w: any) =>
  w.statusLabel === 'Open call' ? 'upcoming' : w.statusLabel === 'Deadline unknown' ? 'unknown' : 'past';
// "Deadline unknown" is nearly twice the width of the other labels, which made
// its pill dominate the row. Break it across two lines at its existing space.
// Done by splitting the words rather than with a max-width, so the wrap point is
// exact and can't shift with font metrics.
const statusLines = (w: any): string[] =>
  statusPill(w) === 'unknown' ? String(w.statusLabel).split(' ') : [String(w.statusLabel)];
---

<Base
  title={`${confName} Workshops — deadlines & papers`}
  description={`Submission deadlines, dates, and accepted papers for ${confFull} (${confName}) workshops. ${list.length} editions tracked.`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <section class="detail-head">
    <p class="eyebrow">{confFull}</p>
    <h1>{confName} workshops</h1>
    <p class="conf-intro">{intro}</p>
    <div class="statline">
      <span><strong>{list.length}</strong> workshop editions</span>
      <span><strong>{paperTotal.toLocaleString('en-US')}</strong> papers</span>
      <span><strong>{openCalls.length}</strong> open calls</span>
    </div>
  </section>

  {yearGroups.map(([year, ws]) => (
    <section class="conf-year">
      <h2>{confName} {year}</h2>
      <ul class="conf-ws-list">
        {ws.map((w) => (
          <li>
            <span class={`pill ${statusPill(w)}`}>{statusLines(w).map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</span>
            <div class="ws-head">
              <a href={href(`/workshop/${w.slug}/`)}>{w.acronym || w.name}</a>
              {w.deadlineWallClock && (
                <span class="muted mono small">{w.statusLabel === 'Open call' ? 'due ' : ''}{w.deadlineWallClock}</span>
              )}
              {w.abstractDeadlineWallClock && (
                <span class={`mono small ${w.abstractDeadlinePassed ? 'muted' : 'abs-open'}`}
                >· abstract {w.abstractDeadlinePassed ? 'closed ' : 'by '}{w.abstractDeadlineWallClock}</span>
              )}
              {w.paperCount > 0 && <span class="muted small">· {w.paperCount} papers</span>}
            </div>
            {w.acronym && w.name && w.name !== w.acronym && (
              <div class="ws-full">{w.name}</div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="conf-faq">
    <h2>Frequently asked questions</h2>
    <dl>
      {faqs.map((f) => (
        <Fragment>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </Fragment>
      ))}
    </dl>
  </section>

  <p class="muted small" style="margin-top: 2rem;">
    Missing a {confName} workshop? <a href={`${REPO_URL}/issues/new?template=add-workshop.yml&conference=${conf.id}`}>Add it →</a>
  </p>

  <style>
    .conf-intro { font-size: 1.04rem; line-height: 1.55; color: var(--muted); max-width: 48rem; margin: 0.4rem 0 1rem; }
    .conf-year { margin: 1.6rem 0; }
    .conf-ws-list { list-style: none; padding: 0; margin: 0.6rem 0; display: grid; row-gap: 0.75rem; }
    /* Per-row two-column grid: the row's own pill, then the workshop. The pill
       column is sized to that row's pill, so the acronym sits directly beside it
       (0.5rem, as in the original flex row) — rows with different status labels
       deliberately do NOT share a column. The title caption goes in the second
       column's second row, so it starts exactly where its own acronym starts. */
    .conf-ws-list li {
      display: grid; grid-template-columns: max-content 1fr;
      column-gap: 0.5rem; row-gap: 0.15rem; align-items: baseline;
    }
    .conf-ws-list li > .pill { grid-row: 1; grid-column: 1; justify-self: start; }
    /* Two-line label: centre it and tighten the leading so the pill stays compact. */
    .conf-ws-list li > .pill.unknown { text-align: center; line-height: 1.2; }
    .conf-ws-list .ws-head { grid-row: 1; grid-column: 2; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
    .conf-ws-list .ws-full { grid-row: 2; grid-column: 2; color: var(--muted); font-size: 0.83rem; line-height: 1.4; max-width: 60rem; }
    .conf-ws-list .abs-open { color: var(--warn); }
    .conf-faq { margin: 2.4rem 0; max-width: 48rem; }
    .conf-faq dt { font-weight: 600; margin-top: 1rem; }
    .conf-faq dd { margin: 0.3rem 0 0; color: var(--muted); }
  </style>
</Base>
