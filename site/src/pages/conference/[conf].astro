---
import Base from '../../components/Base.astro';
import AlertsSignup from '../../components/AlertsSignup.astro';
import MarkdownExport from '../../components/MarkdownExport.astro';
import ConferenceWorkshopList from '../../components/ConferenceWorkshopList.astro';
import { workshops, conferences, proposalCalls, latestProposalCall, extensionStats, conferenceInsight, extensionSentence } from '../../lib/data';
import { href, REPO_URL } from '../../lib/site';
import { formatDateYmd } from '../../../../lib/dates.mjs';

// One hub page per conference, generated from the same data the rest of the
// site uses. Intentionally carries NO data-pf-ws / data-pf-papers attributes,
// so these pages stay out of the workshop/paper search index (they're
// navigation/overview, not search results). They join the sitemap
// automatically via @astrojs/sitemap.
//
// The hub lists its latest year in full (and any earlier year that still has
// an open call) and summarises the rest with a link to that year's own page,
// /conference/<id>/<year>/. Two pages publishing the same 240-row list would
// compete with each other for "neurips 2025 workshops"; this way the hub
// answers "<conf> workshops" and each year page answers "<conf> <year>
// workshops", and both link to the other.
export function getStaticPaths() {
  // status order for listings: open call -> unknown -> past -> not running
  const rank = (w: any) =>
    w.statusLabel === 'Open call'
      ? 0
      : w.statusLabel === 'Deadline unknown'
        ? 1
        : w.statusLabel === 'Not running'
          ? 3
          : 2;
  return conferences.map((c: any) => {
    const list = workshops
      .filter((w: any) => w.conference === c.id)
      .sort(
        (a: any, b: any) =>
          b.year - a.year ||
          rank(a) - rank(b) ||
          // Order by the NEXT actionable date, so a two-stage workshop whose
          // abstract registration closes sooner is listed where a reader would
          // expect it (same ordering rule as the board).
          ((a.nextStageUtcMs ?? a.deadlineUtcMs) ?? Infinity) -
            ((b.nextStageUtcMs ?? b.deadlineUtcMs) ?? Infinity) ||
          (a.name || '').localeCompare(b.name || ''),
      );
    return { params: { conf: c.id }, props: { conf: c, list } };
  });
}

const { conf, list } = Astro.props as { conf: any; list: any[] };
const confName: string = conf.name;
const confFull: string = conf.full_name || conf.name;
// The newest call for workshop proposals (data/proposal_calls.yml). The
// homepage card can carry only one link, so the call's own page is linked here.
const call = latestProposalCall(proposalCalls, conf.id);

const years = list.map((w) => w.year).filter((y) => typeof y === 'number');
const yearMin = years.length ? Math.min(...years) : null;
const yearMax = years.length ? Math.max(...years) : null;
const openCalls = list.filter((w) => w.statusLabel === 'Open call');
const nextOpen =
  [...openCalls]
    .filter((w) => w.deadlineUtcMs != null)
    .sort((a, b) => a.deadlineUtcMs - b.deadlineUtcMs)[0] ?? null;
const paperTotal = list.reduce((n, w) => n + (w.paperCount ?? 0), 0);
// How often this conference's workshop deadlines moved, for the latest year
// with enough closed calls to say (lib/extensions.mjs). Null for most hubs
// until their cycle runs inside the logging window.
const ext = conferenceInsight(conf.id, years, extensionStats);
const extSentence = ext ? extensionSentence(ext, { confName }) : '';

const byYear = new Map<number, any[]>();
for (const w of list) {
  if (!byYear.has(w.year)) byYear.set(w.year, []);
  byYear.get(w.year)!.push(w);
}
const yearGroups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
// Which years the hub lists row by row: the latest, plus any that still has
// an open call (a reader arriving here is looking for something to submit
// to). Everything else is a one-line summary pointing at the year page.
const inFull = (year: number, ws: any[]) => year === yearMax || ws.some((w) => w.statusLabel === 'Open call');

// A conference hub answers "where is this?" differently depending on the
// conference. NeurIPS 2026 is split across Sydney, Paris and Atlanta, so
// each workshop needs its own marker. ECCV 2026 is entirely in Malmö —
// repeating that on all 81 rows would be noise, but saying it nowhere
// leaves the reader of a page *about ECCV* still not knowing. So it is
// said once, in the heading.
const sharedLocation = (ws: any[]) => {
  const labels = ws.map((w: any) => w.locationLabel).filter(Boolean);
  return !ws.some((w: any) => w.locationDistinguishes) && labels.length && new Set(labels).size === 1
    ? labels[0]
    : null;
};

const SITE = Astro.site;
const abs = (p: string) => (SITE ? new URL(href(p), SITE).href : href(p));
const pageUrl = SITE ? new URL(Astro.url.pathname, SITE).href : href(`/conference/${conf.id}/`);

const span =
  yearMin && yearMax ? (yearMin === yearMax ? ` from ${yearMin}` : ` from ${yearMin} to ${yearMax}`) : '';
// <title> and meta description. The suffix " · AI Workshop Tracker" is dropped
// here as it is on workshop pages: with it, every hub title ran 60–75
// characters and Semrush flagged all nine as too long, and the words a
// searcher types were the ones being cut. The year range lives in the
// description, not the title: "neurips 2025 workshops" is the year page's
// query now, and this page's is "neurips workshops". The full conference name
// stays out of the description — it ate 60 characters of a 160-character
// snippet and the H1 area already spells it out.
const yearRange =
  yearMin && yearMax ? (yearMin === yearMax ? String(yearMax) : `${yearMin}–${yearMax}`) : '';
const intro =
  `This page tracks ${list.length} ${confName} workshop edition${list.length === 1 ? '' : 's'}${span}, ` +
  `with ${paperTotal.toLocaleString('en-US')} accepted papers. ` +
  (openCalls.length
    ? `${openCalls.length} ${confName} workshop${openCalls.length === 1 ? ' has' : 's have'} an open call for papers right now` +
      (nextOpen ? `; the next deadline is ${nextOpen.deadlineWallClock}.` : '.')
    : `There are no open ${confName} workshop calls right now — new cycles are imported automatically as they're announced.`);

// FAQ rendered visibly below AND mirrored as FAQPage JSON-LD (Google requires
// the answer text to be present on the page). Answers are data-driven.
const faqs = [
  {
    q: `When are ${confName} workshop paper submission deadlines?`,
    a: openCalls.length
      ? `Deadlines vary by workshop. ${openCalls.length} ${confName} workshop${openCalls.length === 1 ? ' has' : 's have'} an open call right now` +
        (nextOpen ? `, the soonest closing on ${nextOpen.deadlineWallClock}. ` : '. ') +
        `The full list, each with its own deadline, is below.`
      : `There are no open ${confName} workshop calls at the moment. Upcoming deadlines are added automatically as workshops announce them; past editions and their deadlines are listed below.`,
  },
  {
    q: `How many ${confName} workshops are tracked here?`,
    a:
      `${list.length} ${confName} workshop edition${list.length === 1 ? '' : 's'}` +
      (yearMin && yearMax && yearMin !== yearMax ? ` spanning ${yearMin}–${yearMax}` : '') +
      `, together listing ${paperTotal.toLocaleString('en-US')} accepted papers.`,
  },
  {
    q: `Where can I find accepted papers from ${confName} workshops?`,
    a: `Each workshop's page lists its accepted papers, sourced from OpenReview where available. Across ${confName} workshops, ${paperTotal.toLocaleString('en-US')} papers are currently listed and searchable.`,
  },
  {
    q: `Are these ${confName} workshop deadlines official?`,
    a: `These deadlines are drawn from each workshop's official call for papers and its OpenReview page where available, so they're generally reliable — but the data is community-maintained, and a workshop may update its own page without updating OpenReview. Always confirm the exact deadline on the official workshop page before submitting.`,
  },
];

if (ext) {
  faqs.push({
    q: `Do ${confName} workshop deadlines get extended?`,
    a:
      `${extSentence} Each workshop announces its own extensions, and this tracker logs every deadline change it observes — ` +
      `so the figure is what happened this cycle, not a promise about any one workshop. Plan for the published date.`,
  });
}

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: `${confName} workshops`, item: pageUrl },
  ],
};
---

<Base
  title={`${confName} Workshops — Deadlines & Accepted Papers`}
  description={
    `${confName} workshop submission deadlines, dates, topics, official websites, and accepted papers` +
    (yearRange ? `, ${yearRange}` : '') +
    `. ${list.length} editions and ${paperTotal.toLocaleString('en-US')} papers tracked, updated daily.`
  }
  siteSuffix={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <section class="detail-head">
    <p class="eyebrow">{confFull}</p>
    <h1>{confName} workshops</h1>
    <p class="conf-intro">{intro}</p>
    <div class="statline">
      <span><strong>{list.length}</strong> workshop editions</span>
      <span><strong>{paperTotal.toLocaleString('en-US')}</strong> papers</span>
      <span><strong>{openCalls.length}</strong> open calls</span>
    </div>
    {ext && (
      <p class="conf-ext muted small" data-pct={Math.round(ext.rate * 100)}>
        {extSentence} Dates are when this tracker recorded each change.
      </p>
    )}
    {call && (
      <p class="conf-call muted small">
        <a href={call.url} rel="noopener">Call for {confName} {call.year} workshop proposals ↗</a>
        {' — '}
        {call.open ? (
          <Fragment>due {call.deadlineWallClock}</Fragment>
        ) : (
          <Fragment>closed {formatDateYmd(String(call.proposal_deadline).slice(0, 10))}</Fragment>
        )}
      </p>
    )}
    {yearGroups.length > 1 && (
      <p class="conf-years-nav muted small">
        By year:{' '}
        {yearGroups.map(([year], i) => (
          <Fragment>{i > 0 ? ' · ' : ''}<a href={href(`/conference/${conf.id}/${year}/`)}>{confName} {year}</a></Fragment>
        ))}
      </p>
    )}
  </section>

  {/* Conference hubs are where most visitors arrive from search, so the offer
      belongs here too — collapsed, so it never displaces the listings people
      came for. Renders nothing unless PUBLIC_ALERTS_API is set. */}
  <AlertsSignup collapsed tight />

  {yearGroups.map(([year, ws]) => {
    const where = sharedLocation(ws);
    const yearUrl = href(`/conference/${conf.id}/${year}/`);
    const open = ws.filter((w: any) => w.statusLabel === 'Open call').length;
    const papers = ws.reduce((n: number, w: any) => n + (w.paperCount ?? 0), 0);
    return inFull(year, ws) ? (
      <section class="conf-year">
        <h2><a href={yearUrl}>{confName} {year}</a>{where && <span class="conf-year-where"> · {where}</span>}</h2>
        <MarkdownExport
          exportUrl={href(`/exports/${conf.id}-${year}-workshops.md`)}
          filename={`${conf.id}-${year}-workshops.md`}
        />
        <ConferenceWorkshopList workshops={ws} confName={confName} />
        <p class="muted small"><a href={yearUrl}>{confName} {year} workshops: dates, deadlines and FAQ →</a></p>
      </section>
    ) : (
      <section class="conf-year conf-year-summary">
        <h2><a href={yearUrl}>{confName} {year}</a>{where && <span class="conf-year-where"> · {where}</span>}</h2>
        <p class="muted">
          {ws.length} workshop{ws.length === 1 ? '' : 's'}
          {papers > 0 && <Fragment> · {papers.toLocaleString('en-US')} accepted papers</Fragment>}
          {open > 0 && <Fragment> · {open} open call{open === 1 ? '' : 's'}</Fragment>}
          {' · '}<a href={yearUrl}>All {confName} {year} workshops →</a>
        </p>
      </section>
    );
  })}

  <section class="conf-faq">
    <h2>Frequently asked questions</h2>
    <dl>
      {faqs.map((f) => (
        <Fragment>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </Fragment>
      ))}
    </dl>
  </section>

  <p class="muted small" style="margin-top: 2rem;">
    Missing a {confName} workshop? <a href={`${REPO_URL}/issues/new?template=add-workshop.yml&conference=${conf.id}`}>Add it →</a>
  </p>

  <style>
    .conf-intro { font-size: 1.04rem; line-height: 1.55; color: var(--muted); max-width: 48rem; margin: 0.4rem 0 1rem; }
    .conf-years-nav { margin: 0.8rem 0 0; }
    .conf-call { margin: 0.6rem 0 0; }
    .conf-year { margin: 1.6rem 0; }
    .conf-year h2 a { color: inherit; text-decoration: none; }
    .conf-year h2 a:hover { text-decoration: underline; }
    .conf-year-summary { margin: 1.2rem 0; }
    .conf-year-summary p { margin: 0.2rem 0 0; }
    .conf-faq { margin: 2.4rem 0; max-width: 48rem; }
    .conf-faq dt { font-weight: 600; margin-top: 1rem; }
    .conf-faq dd { margin: 0.3rem 0 0; color: var(--muted); }
  </style>
</Base>
