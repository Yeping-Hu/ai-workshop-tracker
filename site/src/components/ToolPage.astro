---
/**
 * The frame every /tools/ page shares. A tool page is one keyword, one job:
 * the keyword sits in <title>, the meta description and the H1 (read from the
 * registry in lib/tools.mjs, which scripts/tools_registry_test.mjs checks),
 * the tool itself is the slot, and under it come the three short sections the
 * SEO playbook asks for: how to use it, why you would, and a FAQ mirrored as
 * FAQPage JSON-LD. Nothing else, so the page is the tool and not an article.
 *
 * Light theme by default (Base's `theme` prop): these pages are landed on
 * from a search result and used for half a minute, and a dark page there
 * reads as the wrong site. The header toggle still works.
 */
import Base from './Base.astro';
import '../styles/tools.css';
import { href } from '../lib/site';
import { toolBySlug, GROUPS } from '../lib/tools.mjs';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const tool = toolBySlug(slug);
if (!tool) throw new Error(`No tool registered for slug "${slug}" (see site/src/lib/tools.mjs)`);

const abs = (p: string) => (Astro.site ? new URL(href(p), Astro.site).href : href(p));
const pageUrl = abs(`/tools/${tool.slug}/`);

// FAQ rendered visibly below AND mirrored as FAQPage JSON-LD (the answer text
// has to be on the page for the markup to describe it).
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faqs.map((f: { q: string; a: string }) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Free tools', item: abs('/tools/') },
    { '@type': 'ListItem', position: 3, name: tool.name, item: pageUrl },
  ],
};
// A free, browser-only web application: the shape Google documents for tools.
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  url: pageUrl,
  description: tool.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const related = (tool.related as string[]).map(toolBySlug).filter(Boolean);
const groupLabel = GROUPS[tool.group as keyof typeof GROUPS] ?? tool.group;
---

<Base title={tool.title} description={tool.description} siteSuffix={false} theme="light">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appLd)} />
    <slot name="head" />
  </Fragment>

  <article class="tool" data-tool={tool.slug}>
    <header class="masthead tool-head">
      <p class="eyebrow"><a href={href('/tools/')}>Free tools</a> · {groupLabel}</p>
      <h1>{tool.h1}</h1>
      <p class="lede">{tool.lede}</p>
    </header>

    <section class="tool-panel" aria-label={tool.name}>
      <slot />
    </section>

    <section class="tool-doc prose">
      <h2>How to use it</h2>
      <ol>
        {tool.howTo.map((step: string) => <li>{step}</li>)}
      </ol>
      <h2>Why you'd use it</h2>
      {tool.why.map((p: string) => <p>{p}</p>)}
      <h2>FAQ</h2>
      <div class="tool-faq">
        {tool.faqs.map((f: { q: string; a: string }) => (
          <div class="tool-faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    {related.length > 0 && (
      <nav class="tool-related" aria-label="More tools">
        <span class="muted">More tools:</span>
        <ul>
          {related.map((t: any) => (
            <li><a href={href(`/tools/${t.slug}/`)}>{t.name}</a></li>
          ))}
          <li><a href={href('/tools/')}>All tools</a></li>
        </ul>
      </nav>
    )}
  </article>
</Base>
