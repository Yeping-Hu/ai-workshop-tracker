---
import { conferenceById, topicById } from '../lib/data';
import { href, CALENDAR_ENABLED } from '../lib/site';

interface Props {
  w: Record<string, any>;
}
const { w } = Astro.props;
const conf = conferenceById.get(w.conference) ?? { name: w.conference, color: '#888' };
const search = [w.name, w.acronym, conf.name, w.year].filter(Boolean).join(' ').toLowerCase();
const hasDeadline = w.deadlineUtcMs != null;
// The date shown stays the PAPER deadline, but the countdown follows whichever
// stage you actually have to act on next: the mandatory abstract registration
// while it is still open, the paper deadline afterwards. It is labelled
// "abstract" (via .countdown[data-stage] in global.css) and both dates are
// shown, so the later switch to the paper deadline cannot read as an extension.
// The ticker name is suffixed too, so the masthead never announces an abstract
// deadline as if it were the submission deadline.
const countdownMs = w.nextStageUtcMs ?? w.deadlineUtcMs;
const isAbstractStage = !!w.nextStageIsAbstract;
const countdownName = isAbstractStage
  ? `${w.acronym || w.name} (abstract)`
  : (w.acronym || w.name);
---

<div
  class="board-row"
  data-ws-row
  data-conf={w.conference}
  data-topics={(w.topics ?? []).join(' ')}
  data-status={w.status}
  data-search={search}
>
  <span class="badge" style={`--conf:${conf.color}`}>{conf.name}</span>

  <div class="ws-main">
    <div class="ws-name">
      <a href={href(`/workshop/${w.slug}/`)}>{w.name}</a>
      <button
        class="star-btn"
        type="button"
        data-star-ws={w.slug}
        aria-pressed="false"
        aria-label={`Save ${w.name} to your list`}
        title="Save for later (stays in this browser)"
      >☆</button>
    </div>
    <div class="ws-meta">
      {w.acronym && <span class="mono">{w.acronym}</span>}
      <span>{conf.name} {w.year}</span>
      {(w.topics ?? []).map((t: string) => (
        <span class="chip">{topicById.get(t)?.label ?? t}</span>
      ))}
    </div>
  </div>

  <div class="ws-deadline">
    {hasDeadline ? (
      <>
        <div class="wall">{w.deadlineWallClock}</div>
        <div class="local js-local" data-iso={w.deadlineIso}>resolving your local time…</div>
        {w.abstractDeadlineWallClock && (
          <div class="abs-stage small">
            {w.abstractDeadlinePassed
              ? <span class="muted">Abstract closed {w.abstractDeadlineWallClock}</span>
              : <span class="abs-open">Abstract due {w.abstractDeadlineWallClock}</span>}
          </div>
        )}
      </>
    ) : (
      <div class="muted">Deadline TBA</div>
    )}
  </div>

  {hasDeadline ? (
    <span
      class="countdown"
      data-deadline-ms={countdownMs}
      data-stage={isAbstractStage ? 'abstract' : null}
      data-name={countdownName}
    >—</span>
  ) : (
    <span class="countdown is-tba">TBA</span>
  )}

  {CALENDAR_ENABLED && hasDeadline && (
    <div class="ws-links small">
      <a href={href(`/feeds/ws-${w.slug}.ics`)}>.ics</a>
    </div>
  )}
</div>
