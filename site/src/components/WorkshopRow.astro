---
import { conferenceById, topicById } from '../lib/data';
import { href, REPO_URL, CALENDAR_ENABLED } from '../lib/site';

interface Props {
  w: Record<string, any>;
}
const { w } = Astro.props;
const conf = conferenceById.get(w.conference) ?? { name: w.conference, color: '#888' };
const search = [w.name, w.acronym, conf.name, w.year].filter(Boolean).join(' ').toLowerCase();
const hasDeadline = w.deadlineUtcMs != null;
// Structured, timezone-safe edit form (replaces the raw-YAML editor link). The
// deadline is intentionally not pre-filled so it's entered consciously with a
// timezone; the bot converts to UTC. Advanced fields stay editable via the
// raw YAML, linked from the form's intro.
const editUrl = `${REPO_URL}/issues/new?template=edit-workshop.yml&slug=${encodeURIComponent(w.slug)}&website=${encodeURIComponent(w.website ?? '')}`;
---

<div
  class="board-row"
  data-ws-row
  data-conf={w.conference}
  data-topics={(w.topics ?? []).join(' ')}
  data-status={w.status}
  data-search={search}
>
  <span class="badge" style={`--conf:${conf.color}`}>{conf.name}</span>

  <div class="ws-main">
    <div class="ws-name">
      <a href={href(`/workshop/${w.slug}/`)}>{w.name}</a>
      <button
        class="star-btn"
        type="button"
        data-star-ws={w.slug}
        aria-pressed="false"
        aria-label={`Save ${w.name} to your list`}
        title="Save for later (stays in this browser)"
      >☆</button>
    </div>
    <div class="ws-meta">
      {w.acronym && <span class="mono">{w.acronym}</span>}
      <span>{conf.name} {w.year}</span>
      {(w.topics ?? []).map((t: string) => (
        <span class="chip">{topicById.get(t)?.label ?? t}</span>
      ))}
    </div>
  </div>

  <div class="ws-deadline">
    {hasDeadline ? (
      <>
        <div class="wall">{w.deadlineWallClock}</div>
        <div class="local js-local" data-iso={w.deadlineIso}>resolving your local time…</div>
        {w.deadline_notes && <div class="note">{w.deadline_notes}</div>}
      </>
    ) : (
      <div class="muted">Deadline TBA</div>
    )}
  </div>

  {hasDeadline ? (
    <span class="countdown" data-deadline-ms={w.deadlineUtcMs} data-name={w.acronym || w.name}>—</span>
  ) : (
    <span class="countdown is-tba">TBA</span>
  )}

  <div class="ws-links small">
    {w.website ? (
      <a href={w.website} rel="noopener">Website ↗</a>
    ) : (
      <a class="link-tba" href={editUrl} rel="noopener">Website TBA — add it</a>
    )}
    {CALENDAR_ENABLED && hasDeadline && <a href={href(`/feeds/ws-${w.slug}.ics`)}>.ics</a>}
    <a href={editUrl} rel="noopener">✎ Edit</a>
  </div>
</div>
