---
/**
 * Email-alerts signup — the only new interactive surface on the site.
 *
 * Renders **nothing** when PUBLIC_ALERTS_API is empty, so a fork or a PR
 * preview build ships without a trace of the feature (and the static site keeps
 * working if the alerts satellite is deleted entirely).
 *
 * The conference and topic pickers are built at build time from the same data
 * the homepage facets use, and submit **ids** while displaying labels — the
 * Worker validates against a generated allowlist (alerts/ids.json), so a
 * vocabulary change flows through without touching this file.
 *
 * Stars are read from localStorage at submit time and sent along, so
 * starred-workshop alerts work from the very first signup — before any device
 * has been linked for sync.
 */
import { conferences, topics } from '../lib/data';
import { ALERTS_API, ALERTS_FROM, TURNSTILE_SITE_KEY, href } from '../lib/site';

interface Props {
  /** Headline above the form. The homepage and /saved/ frame it differently. */
  heading?: string;
  /** Short line under the heading. */
  blurb?: string;
  /** Set on /alerts/, where the surrounding page already explains the feature. */
  compact?: boolean;
  /** Set when the box sits directly under a masthead, which already carries
   *  1.4rem of bottom padding — the default 2.6rem margin then reads as a hole. */
  tight?: boolean;
  /** Render as a one-line <details> that expands to the form. Used everywhere
   *  the box is a secondary offer — the homepage, /saved/, conference pages —
   *  so it never pushes the page's actual content below the fold. */
  collapsed?: boolean;
  /** Summary line for the collapsed variant. */
  summary?: string;
  /** Set on a page that already shows its own signed-in indicator — /saved/
   *  has "Synced as … · manage" in its masthead. The block still hides its
   *  signup form when linked; it just does not add a second line saying the
   *  same thing, with a "your saved list" link to the current page. */
  hideSignedIn?: boolean;
}
const {
  heading = 'Get workshop updates by email',
  blurb = '',
  compact = false,
  tight = false,
  collapsed = false,
  summary = 'Get workshop updates by email',
  hideSignedIn = false,
} = Astro.props;

const enabled = !!ALERTS_API;
const confList = [...conferences].sort((a, b) => a.name.localeCompare(b.name));
const topicList = [...topics].sort((a: any, b: any) => a.label.localeCompare(b.label));
---

{/* Shown instead of the form once this browser is linked — otherwise a
    signed-in visitor is offered a signup on every page but /saved/, which
    reads as "you are not signed in". Filled in by the script below, since the
    pages are static and the token lives in localStorage. */}
{/* Inline SVG rather than the ✉ character. U+2709 has no default
    presentation, so desktop drew a hairline text glyph while iOS and Android
    substituted a chunky colour emoji — the same markup looking like two
    different icons. This inherits currentColor and scales with the heading, so
    it renders identically everywhere. */}
{enabled && !hideSignedIn && (
  <p class="alerts-signedin" id="alertsSignedIn" hidden>
    <svg class="alerts-summary-mark" viewBox="0 0 20 20" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.2" y="4.2" width="15.6" height="11.6" rx="2.2"/><path d="M3.4 6 10 10.6 16.6 6"/></svg>
    <span id="alertsSignedInText"></span>
  </p>
)}

{enabled && (
  <details
    class="alerts-signup"
    data-compact={compact ? '' : undefined}
    data-tight={tight ? '' : undefined}
    data-collapsed={collapsed ? '' : undefined}
    open={!collapsed}
  >
    {/* One structure for both variants: `open` with the summary hidden gives
        the full box, without a second copy of the form and its element ids. */}
    <summary class="alerts-summary">
      <svg class="alerts-summary-mark" viewBox="0 0 20 20" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.2" y="4.2" width="15.6" height="11.6" rx="2.2"/><path d="M3.4 6 10 10.6 16.6 6"/></svg>
      <span>{summary}</span>
      <span class="alerts-summary-hint">workshop extensions, new calls, and more</span>
    </summary>
    <h2 id="alertsSignupHead">{heading}</h2>
    {blurb && <p class="muted small">{blurb}</p>}

    <form id="alertsForm" novalidate>
      <div class="alerts-row">
        <label class="alerts-sr" for="alertsEmail">Email address</label>
        <input
          id="alertsEmail"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="Your email address"
        />

        <details class="dd">
          <summary id="alertsConfSummary">Conferences: all</summary>
          <div class="dd-panel" id="alertsConfPanel">
            {confList.map((c: any) => (
              <label class="check">
                <input type="checkbox" name="conference" value={c.id} />
                <span class="conf-dot" style={`--conf:${c.color}`}></span>
                {c.name}
              </label>
            ))}
          </div>
        </details>

        <details class="dd">
          <summary id="alertsTopicSummary">Topics: all</summary>
          <div class="dd-panel" id="alertsTopicPanel">
            {topicList.map((t: any) => (
              <label class="check">
                <input type="checkbox" name="topic" value={t.id} />
                {t.label}
              </label>
            ))}
          </div>
        </details>
      </div>

      {/* Said before submitting rather than after. The Worker answers every
          /subscribe with one invariant sentence — the same words whether a
          confirmation was sent, a sign-in link was sent, or nothing was sent at
          all — because any variation is an account-enumeration oracle. So a
          "look for mail from …" line in the reply would be false on two of the
          three paths, while here it is true unconditionally. It also front-runs
          the "newly registered domain" banner some mail filters still attach to
          a young sending domain. */}
      <p class="muted small alerts-hint">
        Confirmation comes from <strong>{ALERTS_FROM}</strong>. Check spam if it
        does not arrive. Nothing is sent until you click its link.
      </p>

      <fieldset class="alerts-cadence">
        <legend class="alerts-legend">What you hear about</legend>
        <label class="check">
          <input type="radio" name="scope" value="all" checked />
          These conferences and topics, plus anything I've saved
        </label>
        <label class="check">
          <input type="radio" name="scope" value="starred" />
          Only the workshops I've saved
        </label>
      </fieldset>

      {/* Three independent notifications, not one axis. As radios these forced
          artificial combinations and one label was simply untrue. */}
      <fieldset class="alerts-cadence">
        <legend class="alerts-legend">Send me</legend>
        <label class="check">
          <input type="checkbox" name="notify" value="weekly" checked />
          A weekly digest, Mondays
        </label>
        <label class="check">
          <input type="checkbox" name="notify" value="urgent" checked />
          An alert when a saved workshop's deadline is within 72 hours
        </label>
        <label class="check">
          <input type="checkbox" name="notify" value="changes" checked />
          An alert the day a saved workshop's deadline changes
        </label>
      </fieldset>

      {TURNSTILE_SITE_KEY && (
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only"></div>
      )}

      <div class="alerts-row">
        <button class="btn" type="submit" id="alertsSubmit">Subscribe</button>
        <a class="btn-quiet" href={href('/alerts/manage/')}>Already subscribed? Sign in</a>
      </div>

      <p class="alerts-status" id="alertsStatus" role="status" aria-live="polite" hidden></p>

      <p class="muted small alerts-privacy">
        Your address is stored only to send these; one-click unsubscribe deletes it.
      </p>
    </form>
  </details>
)}

{enabled && TURNSTILE_SITE_KEY && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

{enabled && (
  <script is:inline define:vars={{ ALERTS_API, SAVED_URL: href('/saved/'), MANAGE_URL: href('/alerts/manage/') }}>
    (() => {
      const form = document.getElementById('alertsForm');
      if (!form || form.dataset.wired) return;
      form.dataset.wired = '1';

      // Swap the signup offer for a quiet confirmation once linked, and back
      // again on sign-out. Driven by the shared session module's event, so the
      // two never disagree.
      const box = form.closest('.alerts-signup');
      const banner = document.getElementById('alertsSignedIn');
      const bannerText = document.getElementById('alertsSignedInText');
      function paintSession() {
        const s = window.awtAlertsSession?.() || { linked: false };
        if (banner && bannerText) {
          // Built from nodes rather than innerHTML: the email is the one piece
          // of user data here, and textContent cannot be misread as markup.
          bannerText.textContent = '';
          if (s.linked) {
            bannerText.append(s.email ? `Alerts on for ${s.email} · ` : 'Alerts on · ');
            const saved = document.createElement('a');
            saved.href = SAVED_URL;
            saved.textContent = 'your saved list';
            const manage = document.createElement('a');
            manage.href = MANAGE_URL;
            manage.textContent = 'manage';
            bannerText.append(saved, ' · ', manage);
          }
          banner.hidden = !s.linked;
        }
        if (box) box.hidden = s.linked;
      }
      paintSession();
      document.addEventListener('awt:alerts-session', paintSession);
      // The module may finish adopting a `#t=` fragment after this runs.
      Promise.resolve(window.awtAlertsAdopt).then(paintSession).catch(() => {});

      const status = document.getElementById('alertsStatus');
      const submit = document.getElementById('alertsSubmit');
      const say = (msg, kind) => {
        status.textContent = msg;
        status.hidden = false;
        status.className = `alerts-status is-${kind}`;
      };

      // A sent confirmation is a state, not just a line of text. The preference
      // controls are answered questions once the mail is out, and the button no
      // longer means the same thing: for an unconfirmed row the Worker refreshes
      // the preferences and re-sends, which is the only in-page recovery from a
      // typo or an undelivered mail — so it is relabelled, never disabled.
      //
      // The status <p> lives inside the <form>, so hiding the form would hide
      // the confirmation with it; CSS hides the answered controls instead.
      const emailInput = form.querySelector('#alertsEmail');
      const summaryHint = box?.querySelector('.alerts-summary-hint');
      const summaryPitch = summaryHint?.textContent;
      const done = (on) => {
        box?.toggleAttribute('data-sent', on);
        submit.textContent = on ? 'Send it again' : 'Subscribe';
        // The one line still visible while a collapsed box is shut, so three of
        // the four placements stop reverting to an unmet offer.
        if (summaryHint) summaryHint.textContent = on ? 'check your inbox to confirm' : summaryPitch;
      };
      // Editing the address makes this a new signup, not a resend.
      emailInput.addEventListener('input', () => done(false));

      // Summaries mirror the homepage facet dropdowns: they always state the
      // current selection, so a collapsed picker is never ambiguous.
      const picked = (name) => [...form.querySelectorAll(`input[name="${name}"]:checked`)].map((i) => i.value);
      const syncSummary = (name, el, noun) => {
        const n = picked(name).length;
        el.textContent = n === 0 ? `${noun}: all` : `${noun}: ${n} selected`;
      };
      const confSummary = document.getElementById('alertsConfSummary');
      const topicSummary = document.getElementById('alertsTopicSummary');
      const facetPickers = [confSummary.closest('details'), topicSummary.closest('details')];
      const syncScope = () => {
        // Saved-only ignores the facets entirely, so show that rather than
        // leaving controls that quietly do nothing.
        const starredOnly = form.querySelector('input[name="scope"]:checked')?.value === 'starred';
        for (const d of facetPickers) {
          if (!d) continue;
          d.toggleAttribute('data-disabled', starredOnly);
          if (starredOnly) d.open = false;
          for (const i of d.querySelectorAll('input')) i.disabled = starredOnly;
        }
      };
      form.addEventListener('change', () => {
        syncSummary('conference', confSummary, 'Conferences');
        syncSummary('topic', topicSummary, 'Topics');
        syncScope();
      });
      syncScope();

      const readStars = (key) => {
        try {
          const v = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(v) ? v : [];
        } catch {
          return [];
        }
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email || !email.includes('@')) return say('Please enter a valid email address.', 'err');
        // The Worker rejects this too; catching it here explains it sooner.
        if (!picked('notify').length) return say('Pick at least one thing to be sent.', 'err');

        // Turnstile renders its own hidden input; the Worker fails closed if it
        // is missing, so an ad blocker that eats the widget gets a clear message
        // rather than a silent rejection.
        const tsField = form.querySelector('[name="cf-turnstile-response"]');
        const turnstile_token = tsField ? tsField.value : '';

        submit.disabled = true;
        say('Sending…', 'busy');
        try {
          const res = await fetch(`${ALERTS_API}/subscribe`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              conferences: picked('conference'),
              topics: picked('topic'),
              // Sent at signup so starred-workshop alerts work immediately,
              // before this device has been linked for sync.
              starred_ws: readStars('awt-fav-workshops'),
              starred_papers: readStars('awt-fav-papers'),
              scope: form.querySelector('input[name="scope"]:checked')?.value || 'all',
              // Email cannot run JS, so the local time in every alert is baked in
              // at send from this. Refreshed later whenever a linked device loads
              // a page, so moving city fixes itself.
              tz: (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || null; } catch { return null; } })(),
              notify: picked('notify'),
              turnstile_token,
            }),
          });
          const body = await res.json().catch(() => ({}));

          if (body.ok) {
            // Echo the address the browser already has. The server sentence
            // cannot name it without becoming an enumeration oracle, so without
            // this a mistyped address produces exactly this green line and then
            // permanent silence — the unconfirmed row is deleted when its token
            // expires. The field keeps its value for the same reason (and the
            // manage form never clears its input either).
            say(`${body.message || 'Check your inbox to confirm.'} Sent to ${email}.`, 'ok');
            done(true);
          } else if (body.error === 'list_full') {
            say(body.message || 'The alert list is full right now. Please try again in a while.', 'err');
          } else if (body.error === 'rate_limited') {
            say('Too many attempts from here. Please try again in an hour.', 'err');
          } else if (body.error === 'captcha_failed') {
            say("The anti-spam check didn't pass. Reload the page and try again.", 'err');
          } else if (body.error === 'invalid_email') {
            say('That address does not look valid.', 'err');
          } else if (body.error === 'no_notifications') {
            say('Pick at least one thing to be sent.', 'err');
          } else {
            say('Something went wrong. Please try again shortly.', 'err');
          }
        } catch {
          say("Couldn't reach the alerts service. Check your connection and try again.", 'err');
        } finally {
          submit.disabled = false;
          window.turnstile?.reset?.();
        }
      });
    })();
  </script>
)}

{/* `is:inline` rather than a scoped <style>: Astro extracts and hoists scoped
    styles at build time whether or not the markup renders, which left ~1.2 KB
    of dead CSS on every page when PUBLIC_ALERTS_API was empty. Inline keeps the
    promise that an unconfigured build carries no trace of the feature. Class
    names are prefixed, so the lack of scoping is not a collision risk. */}
{enabled && (
<style is:inline>
  .alerts-signup {
    margin: 2.6rem 0 0;
    padding: 1.3rem 1.4rem;
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .alerts-signup[data-compact] { background: transparent; }
  /* Directly under a masthead, whose padding already supplies the gap. */
  .alerts-signup[data-tight] { margin-top: 0.6rem; }
  .alerts-signedin {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: baseline;
  }
  /* Expanded variant: the summary is redundant with the h2 below it. */
  .alerts-signup:not([data-collapsed]) > .alerts-summary { display: none; }
  /* Collapsed variant: the summary IS the heading, so the h2 would repeat it. */
  .alerts-signup[data-collapsed] > h2 { display: none; }
  .alerts-signup[data-collapsed] { padding: 0.75rem 1.1rem; }
  .alerts-signup[data-collapsed][open] { padding-bottom: 1.3rem; }
  .alerts-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .alerts-summary::-webkit-details-marker { display: none; }
  /* An <svg> in a flex row would shrink under pressure and, in the signed-in
     line, sit on the text baseline rather than centred on it. */
  /* Both rows are flex with baseline alignment, and an <svg>'s baseline is its
     bottom edge — so it floated 3.4px above the text's optical centre. Centre it
     on the line box instead, and stop it shrinking in a wrapped row. */
  .alerts-summary-mark { color: var(--accent); flex: none; align-self: center; }
  .alerts-summary-hint { color: var(--muted); font-size: 0.84rem; font-weight: 400; }
  .alerts-signup[data-collapsed] > .alerts-summary::after {
    content: '+';
    margin-left: auto;
    color: var(--muted);
    font-weight: 400;
    font-family: var(--font-mono);
  }
  .alerts-signup[data-collapsed][open] > .alerts-summary::after { content: '−'; }
  .alerts-signup[data-collapsed] > p:first-of-type { margin-top: 0.7rem !important; }
  .alerts-signup h2 { margin: 0 0 0.2rem; font-size: 1.12rem; }
  .alerts-signup p { margin: 0; }
  .alerts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.7rem;
    align-items: center;
    margin-top: 0.9rem;
  }
  .alerts-signup input[type='email'] {
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    min-width: 16rem;
    flex: 1 1 16rem;
  }
  .alerts-hint { margin-top: 0.45rem !important; }
  .alerts-cadence {
    border: 0;
    padding: 0;
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .alerts-cadence .check { align-items: baseline; }
  .alerts-legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0;
    margin-bottom: 0.15rem;
  }
  details.dd[data-disabled] { opacity: 0.45; pointer-events: none; }
  .alerts-signup .cf-turnstile { margin-top: 0.85rem; }
  .alerts-status { margin-top: 0.8rem !important; font-size: 0.9rem; }
  .alerts-status.is-ok { color: var(--accent); font-weight: 600; }
  .alerts-status.is-err { color: var(--urgent); }
  .alerts-status.is-busy { color: var(--muted); }
  .alerts-privacy { margin-top: 0.85rem !important; max-width: 46rem; }
  /* Sent state: the questions are answered, so only the address, the status
     line and the button that re-sends still matter. .cf-turnstile is
     deliberately left alone — the submit handler resets the widget, which does
     not work inside a display:none parent. */
  .alerts-signup[data-sent] .alerts-cadence,
  .alerts-signup[data-sent] .alerts-row .dd,
  .alerts-signup[data-sent] .alerts-hint { display: none; }
  .alerts-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
)}
