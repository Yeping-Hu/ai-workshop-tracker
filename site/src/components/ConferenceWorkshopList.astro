---
/**
 * The workshop rows a conference hub and a conference-year page share: one
 * row per edition with its status pill, short label, star, deadline, abstract
 * stage, paper count and — only where the conference is split across cities —
 * its location. One component so the two listings cannot drift apart.
 *
 * Deliberately carries NO data-pf-ws / data-pf-papers attributes: Pagefind is
 * rooted on those, so these listings stay out of the search index. They are
 * navigation, not search results.
 */
import { workshopShortName } from '../lib/data';
import { href } from '../lib/site';

interface Props {
  workshops: any[];
  confName: string;
}
const { workshops: ws, confName } = Astro.props;

const statusPill = (w: any) =>
  w.statusLabel === 'Open call'
    ? 'upcoming'
    : w.statusLabel === 'Deadline unknown'
      ? 'unknown'
      : w.statusLabel === 'Not running'
        ? 'not_running'
        : 'past';
// "Deadline unknown" is nearly twice the width of the other labels, which made
// its pill dominate the row. Break it across two lines at its existing space.
// Done by splitting the words rather than with a max-width, so the wrap point is
// exact and can't shift with font metrics.
const statusLines = (w: any): string[] =>
  statusPill(w) === 'unknown' ? String(w.statusLabel).split(' ') : [String(w.statusLabel)];
// ^ only "Deadline unknown" splits: "Not running" is comfortably narrower than
//   the widest single-line label already in use.
---

<ul class="conf-ws-list">
  {ws.map((w) => (
    <li>
      <span class={`pill ${statusPill(w)}`}>{statusLines(w).map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</span>
      <div class="ws-head">
        <a href={href(`/workshop/${w.slug}/`)}>{workshopShortName(w, confName).full}</a>
        {/* Same control as the board and the workshop page — this list was
            the only place a visitor could not save without opening the
            entry first. Always rendered, never hover-revealed: most of the
            traffic here is phones, where there is no hover. */}
        <button
          class="star-btn"
          type="button"
          data-star-ws={w.slug}
          aria-pressed="false"
          aria-label={`Save ${workshopShortName(w, confName).full}`}
        >☆</button>
        {w.deadlineWallClock && (
          <span class="muted mono small">{w.statusLabel === 'Open call' ? 'due ' : ''}{w.deadlineWallClock}</span>
        )}
        {w.abstractDeadlineWallClock && (
          <span class={`mono small ${w.abstractDeadlinePassed ? 'muted' : 'abs-open'}`}
          >· abstract {w.abstractDeadlinePassed ? 'closed ' : 'by '}{w.abstractDeadlineWallClock}</span>
        )}
        {w.paperCount > 0 && <span class="muted small">· {w.paperCount} papers</span>}
        {/* Only where the conference is genuinely split; otherwise the
            year heading above has already said it once. */}
        {w.locationDistinguishes && <span class="ws-where small">{w.locationLabel}</span>}
      </div>
      {w.name && w.name !== workshopShortName(w, confName).full && (
        <div class="ws-full">{w.name}</div>
      )}
    </li>
  ))}
</ul>

<style>
  .conf-ws-list { list-style: none; padding: 0; margin: 0.6rem 0; display: grid; row-gap: 0.75rem; }
  /* Per-row two-column grid: the row's own pill, then the workshop. The pill
     column is sized to that row's pill, so the acronym sits directly beside it
     (0.5rem, as in the original flex row) — rows with different status labels
     deliberately do NOT share a column. The title caption goes in the second
     column's second row, so it starts exactly where its own acronym starts. */
  .conf-ws-list li {
    display: grid; grid-template-columns: max-content 1fr;
    column-gap: 0.5rem; row-gap: 0.15rem; align-items: baseline;
  }
  .conf-ws-list li > .pill { grid-row: 1; grid-column: 1; justify-self: start; }
  /* A two-line pill is taller than the acronym beside it, and in row 1 alone that
     extra height inflated the row and pushed the title caption ~13px further down
     than on single-line rows. Spanning both rows lets the height be absorbed
     across them instead, so the caption sits the same distance below the acronym
     whatever the status label. Only where a caption exists, so rows without one
     keep their natural height. */
  .conf-ws-list li:has(.ws-full) > .pill { grid-row: 1 / span 2; align-self: start; }
  /* Two-line label: centre it and tighten the leading so the pill stays compact. */
  .conf-ws-list li > .pill.unknown { text-align: center; line-height: 1.2; }
  /* Make it exactly as wide as the "Open call" pill without hard-coding a
     measurement: an invisible zero-height copy of that label sets the pill's
     intrinsic width, so it is rendered in the same font, size and
     letter-spacing and matches at any zoom or font fallback. */
  .conf-ws-list li > .pill.unknown::after {
    content: "Open call";
    display: block; height: 0; overflow: hidden; visibility: hidden;
  }
  .conf-ws-list .ws-head { grid-row: 1; grid-column: 2; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .conf-ws-list .ws-full { grid-row: 2; grid-column: 2; color: var(--muted); font-size: 0.83rem; line-height: 1.4; max-width: 60rem; }
  .conf-ws-list .abs-open { color: var(--warn); }
</style>
